            "liquid_code": "{% raw %}\n{% liquid\n\t# device\n\tassign device = block.settings.device | default: 'all'\n\n\t# label\n\tif block.settings.label == blank\n\t\tassign label = label\n\telse\n\t\tassign label = block.settings.label\n\tendif\n\n\t# size\n\tif block.settings.size == 'default'\n\t\tassign size = size\n\telse\n\t\tassign size = block.settings.size\n\tendif\n\n\t# variant\n\tif block.settings.variant == 'default'\n\t\tassign variant = variant\n\telse\n\t\tassign variant = block.settings.variant\n\tendif\n\n\t# color\n\tif block.settings.custom_color == true\n\t\tassign color = block.settings.color\n\telse\n\t\tassign color = color\n\tendif\n\n\t# href\n\tif block.settings.custom_link == true and block.settings.href != blank\n\t\tassign href = block.settings.href\n\telse\n\t\tassign href = href\n\tendif\n\n\t# target blank\n\tif block.settings.target_blank == true\n\t\tassign target_blank = target_blank\n\telse\n\t\tassign target_blank = target_blank\n\tendif\n\n\t# ID\n\tif block.settings.id == blank\n\t\tassign id = id\n\telse\n\t\tassign id = block.settings.id\n\tendif\n\n\t# Class\n\tif block.settings.class == blank\n\t\tassign class = button_class\n\telse\n\t\tassign class = block.settings.class\n\tendif\n\n\t# Custom props\n\tif block.settings.props == blank\n\t\tassign props = props | default: ''\n\telse\n\t\tassign props = block.settings.props\n\tendif\n\n\t# Border radius\n\tif block.settings.custom_radius == true\n\t\tassign radius = block.settings.radius | append: 'px'\n\telse\n\t\tassign radius = radius\n\tendif\n\n\t# width\n\tif block.settings.custom_width == true\n\t\t# check if the selected unit is pixel or pecent\n\t\tif block.settings.unit == 'pixel'\n\t\t\tassign width = block.settings.pexel_width | append: 'px'\n\t\telse\n\t\t\tassign width = block.settings.percent_width | append: '%'\n\t\tendif\n\telse\n\t\t# if block settings custom width isn't checked, we use block properties\n\t\tassign width = width\n\tendif\n\n\t# mobile width\n\tif block.settings.custom_mobile_width == true\n\t\tif block.settings.mobile_unit == 'pixel'\n\t\t\tassign mobile_width = block.settings.mobile_pexel_width | append: 'px'\n\t\telse\n\t\t\tassign mobile_width = block.settings.mobile_pexel_width | append: '%'\n\t\tendif\n\telse\n\t\t# if block settings custom width isn't checked, we use block properties\n\t\tassign mobile_width = mobile_width\n\tendif\n\n\t# height\n\tif block.settings.custom_height == true\n\t\tassign height = block.settings.height | append: 'px'\n\telse\n\t\t# if block settings custom width isn't checked, we use block properties\n\t\tassign height = height\n\tendif\n\n\t# mobile height\n\tif block.settings.custom_mobile_height == true\n\t\tassign mobile_height = block.settings.mobile_height | append: 'px'\n\telse\n\t\t# if block settings custom width isn't checked, we use block properties\n\t\tassign mobile_height = mobile_height\n\tendif\n\n\t# custom padding\n\tif block.settings.custom_padding == true\n\t\tassign padding_top = block.settings.padding_top | append: 'px'\n\t\tassign padding_bottom = block.settings.padding_bottom | append: 'px'\n\t\tassign padding_left = block.settings.padding_left | append: 'px'\n\t\tassign padding_right = block.settings.padding_right | append: 'px'\n\telse\n\t\tassign padding_top = padding_top\n\t\tassign padding_bottom = padding_bottom\n\t\tassign padding_left = padding_left\n\t\tassign padding_right = padding_right\n\tendif\n\n\t# button alignment\n\tif block.settings.custom_alignment\n\t\tassign align = block.settings.alignment\n\telse\n\t\tassign align = align\n\tendif\n\n\t# lucide icon\n\tif block.settings.custom_icon and block.settings.lucide_icon != blank\n\t\tassign lucide_icon = block.settings.lucide_icon\n\telse\n\t\tassign lucide_icon = lucide_icon\n\tendif\n\n\t# icon position\n\tif block.settings.custom_icon\n\t\tassign icon_position = block.settings.icon_position\n\telse\n\t\tassign icon_position = icon_position\n\tendif\n%}\n\n{% render 'button',\n\tdevice: device,\n\tvariant: variant,\n\tcolor: color,\n\talign: align,\n\tsize: size,\n\thref: href,\n\tlabel: label,\n\tid: id,\n\tclass: class,\n\tprops: props,\n\tradius: radius,\n\twidth: width,\n\tmobile_width: mobile_width,\n\theight: height,\n\tmobile_height: mobile_height,\n\tpadding_top: padding_top,\n\tpadding_bottom: padding_bottom,\n\tpadding_left: padding_left,\n\tpadding_right: padding_right,\n\ticon: icon,\n\tlucide_icon: lucide_icon,\n\ticon_position: icon_position,\n\ttarget_blank: target_blank\n%}\n\n{% schema %}\n\t{\n\t\t\"name\": \"Button\",\n\t\t\"settings\": [\n\t\t\t{\n\t\t\t\t\"type\": \"select\",\n\t\t\t\t\"id\": \"device\",\n\t\t\t\t\"label\": \"Show Button on\",\n\t\t\t\t\"options\": [\n\t\t\t\t\t{\n\t\t\t\t\t\t\"value\": \"all\",\n\t\t\t\t\t\t\"label\": \"All Devices\"\n\t\t\t\t\t},\n\t\t\t\t\t{\n\t\t\t\t\t\t\"value\": \"mobile\",\n\t\t\t\t\t\t\"label\": \"Mobile  Devices Only\"\n\t\t\t\t\t},\n\t\t\t\t\t{\n\t\t\t\t\t\t\"value\": \"desktop\",\n\t\t\t\t\t\t\"label\": \"Desktop Devices  Only\"\n\t\t\t\t\t}\n\t\t\t\t],\n\t\t\t\t\"default\": \"all\"\n\t\t\t},\n\t\t\t{\n\t\t\t\t\"type\": \"select\",\n\t\t\t\t\"id\": \"variant\",\n\t\t\t\t\"label\": \"Button variant\",\n\t\t\t\t\"options\": [\n\t\t\t\t\t{\n\t\t\t\t\t\t\"value\": \"default\",\n\t\t\t\t\t\t\"label\": \"Default\"\n\t\t\t\t\t},\n\t\t\t\t\t{\n\t\t\t\t\t\t\"value\": \"primary\",\n\t\t\t\t\t\t\"label\": \"Primary\"\n\t\t\t\t\t},\n\t\t\t\t\t{\n\t\t\t\t\t\t\"value\": \"secondary\",\n\t\t\t\t\t\t\"label\": \"Secondary\"\n\t\t\t\t\t},\n\t\t\t\t\t{\n\t\t\t\t\t\t\"value\": \"destructive\",\n\t\t\t\t\t\t\"label\": \"Destructive\"\n\t\t\t\t\t},\n\t\t\t\t\t{\n\t\t\t\t\t\t\"value\": \"link\",\n\t\t\t\t\t\t\"label\": \"Link\"\n\t\t\t\t\t},\n\t\t\t\t\t{\n\t\t\t\t\t\t\"value\": \"white\",\n\t\t\t\t\t\t\"label\": \"White\"\n\t\t\t\t\t},\n\t\t\t\t\t{\n\t\t\t\t\t\t\"value\": \"outline\",\n\t\t\t\t\t\t\"label\": \"Outline\"\n\t\t\t\t\t},\n\t\t\t\t\t{\n\t\t\t\t\t\t\"value\": \"ghost\",\n\t\t\t\t\t\t\"label\": \"Ghost\"\n\t\t\t\t\t}\n\t\t\t\t]\n\t\t\t},\n\t\t\t{\n\t\t\t\t\"type\": \"select\",\n\t\t\t\t\"id\": \"size\",\n\t\t\t\t\"label\": \"Button Size\",\n\t\t\t\t\"options\": [\n\t\t\t\t\t{\n\t\t\t\t\t\t\"value\": \"default\",\n\t\t\t\t\t\t\"label\": \"Default\"\n\t\t\t\t\t},\n\t\t\t\t\t{\n\t\t\t\t\t\t\"value\": \"sm\",\n\t\t\t\t\t\t\"label\": \"Small\"\n\t\t\t\t\t},\n\t\t\t\t\t{\n\t\t\t\t\t\t\"value\": \"md\",\n\t\t\t\t\t\t\"label\": \"Medium\"\n\t\t\t\t\t},\n\t\t\t\t\t{\n\t\t\t\t\t\t\"value\": \"lg\",\n\t\t\t\t\t\t\"label\": \"Large\"\n\t\t\t\t\t},\n\t\t\t\t\t{\n\t\t\t\t\t\t\"value\": \"icon-sm\",\n\t\t\t\t\t\t\"label\": \"Icon Small\"\n\t\t\t\t\t},\n\t\t\t\t\t{\n\t\t\t\t\t\t\"value\": \"icon\",\n\t\t\t\t\t\t\"label\": \"Icon Medium\"\n\t\t\t\t\t},\n\n\t\t\t\t\t{\n\t\t\t\t\t\t\"value\": \"icon-lg\",\n\t\t\t\t\t\t\"label\": \"Icon Large\"\n\t\t\t\t\t},\n\t\t\t\t\t{\n\t\t\t\t\t\t\"value\": \"full\",\n\t\t\t\t\t\t\"label\": \"Full\"\n\t\t\t\t\t}\n\t\t\t\t]\n\t\t\t},\n\t\t\t{\n\t\t\t\t\"type\": \"header\",\n\t\t\t\t\"content\": \"Basic \"\n\t\t\t},\n\t\t\t{\n\t\t\t\t\"type\": \"text\",\n\t\t\t\t\"id\": \"label\",\n\t\t\t\t\"label\": \"Label\"\n\t\t\t},\n\t\t\t{\n\t\t\t\t\"type\": \"checkbox\",\n\t\t\t\t\"id\": \"custom_link\",\n\t\t\t\t\"label\": \"Add Link to button\"\n\t\t\t},\n\t\t\t{\n\t\t\t\t\"type\": \"url\",\n\t\t\t\t\"id\": \"href\",\n\t\t\t\t\"label\": \"Link\",\n\t\t\t\t\"visible_if\": \"{{block.settings.custom_link}}\"\n\t\t\t},\n\t\t\t{\n\t\t\t\t\"type\": \"checkbox\",\n\t\t\t\t\"id\": \"target_blank\",\n\t\t\t\t\"label\": \"Open Link in new tab\",\n\t\t\t\t\"visible_if\": \"{{block.settings.custom_link}}\"\n\t\t\t},\n\t\t\t{\n\t\t\t\t\"type\": \"header\",\n\t\t\t\t\"content\": \"Colors\"\n\t\t\t},\n\t\t\t{\n\t\t\t\t\"type\": \"checkbox\",\n\t\t\t\t\"id\": \"custom_color\",\n\t\t\t\t\"label\": \"Custom Color\"\n\t\t\t},\n\t\t\t{\n\t\t\t\t\"type\": \"color\",\n\t\t\t\t\"id\": \"color\",\n\t\t\t\t\"label\": \"Color\",\n\t\t\t\t\"default\": \"#000000\",\n\t\t\t\t\"visible_if\": \"{{block.settings.custom_color}}\"\n\t\t\t},\n\t\t\t{\n\t\t\t\t\"type\": \"header\",\n\t\t\t\t\"content\": \"Alignment\"\n\t\t\t},\n\t\t\t{\n\t\t\t\t\"type\": \"checkbox\",\n\t\t\t\t\"id\": \"custom_alignment\",\n\t\t\t\t\"label\": \"Align Button\"\n\t\t\t},\n\t\t\t{\n\t\t\t\t\"type\": \"text_alignment\",\n\t\t\t\t\"id\": \"alignment\",\n\t\t\t\t\"label\": \"Align Button\",\n\t\t\t\t\"default\": \"left\",\n\t\t\t\t\"visible_if\": \"{{block.settings.custom_alignment}}\"\n\t\t\t},\n\t\t\t{\n\t\t\t\t\"type\": \"header\",\n\t\t\t\t\"content\": \"Icon\"\n\t\t\t},\n\t\t\t{\n\t\t\t\t\"type\": \"checkbox\",\n\t\t\t\t\"id\": \"custom_icon\",\n\t\t\t\t\"label\": \"Adjust Icon\"\n\t\t\t},\n\t\t\t{\n\t\t\t\t\"type\": \"text\",\n\t\t\t\t\"id\": \"lucide_icon\",\n\t\t\t\t\"label\": \"Icon Name\",\n\t\t\t\t\"placeholder\": \"E.g shopping-cart\",\n\t\t\t\t\"visible_if\": \"{{block.settings.custom_icon}}\",\n\t\t\t\t\"info\": \"Enter the name of a Lucide icon in the field below. Browse available icons at [lucide.dev/icons](https://lucide.dev/icons).\"\n\t\t\t},\n\t\t\t{\n\t\t\t\t\"type\": \"select\",\n\t\t\t\t\"id\": \"icon_position\",\n\t\t\t\t\"label\": \"Icon Position\",\n\t\t\t\t\"options\": [\n\t\t\t\t\t{\n\t\t\t\t\t\t\"value\": \"left\",\n\t\t\t\t\t\t\"label\": \"Left\"\n\t\t\t\t\t},\n\t\t\t\t\t{\n\t\t\t\t\t\t\"value\": \"right\",\n\t\t\t\t\t\t\"label\": \"Right\"\n\t\t\t\t\t},\n\t\t\t\t\t{\n\t\t\t\t\t\t\"value\": \"top\",\n\t\t\t\t\t\t\"label\": \"Top\"\n\t\t\t\t\t},\n\t\t\t\t\t{\n\t\t\t\t\t\t\"value\": \"bottom\",\n\t\t\t\t\t\t\"label\": \"Bottom\"\n\t\t\t\t\t}\n\t\t\t\t],\n\t\t\t\t\"visible_if\": \"{{block.settings.custom_icon}}\"\n\t\t\t},\n\t\t\t{\n\t\t\t\t\"type\": \"header\",\n\t\t\t\t\"content\": \"Border Radius\"\n\t\t\t},\n\t\t\t{\n\t\t\t\t\"type\": \"checkbox\",\n\t\t\t\t\"id\": \"custom_radius\",\n\t\t\t\t\"label\": \"Adjust Border Radius\"\n\t\t\t},\n\t\t\t{\n\t\t\t\t\"type\": \"range\",\n\t\t\t\t\"id\": \"radius\",\n\t\t\t\t\"label\": \"Roundeness\",\n\t\t\t\t\"min\": 0,\n\t\t\t\t\"max\": 100,\n\t\t\t\t\"step\": 1,\n\t\t\t\t\"default\": 8,\n\t\t\t\t\"unit\": \"px\",\n\t\t\t\t\"visible_if\": \"{{ block.settings.custom_radius == true }}\"\n\t\t\t},\n\t\t\t{\n\t\t\t\t\"type\": \"header\",\n\t\t\t\t\"content\": \"Width\"\n\t\t\t},\n\t\t\t{\n\t\t\t\t\"type\": \"checkbox\",\n\t\t\t\t\"id\": \"custom_width\",\n\t\t\t\t\"label\": \"Adjust Width\"\n\t\t\t},\n\t\t\t{\n\t\t\t\t\"type\": \"select\",\n\t\t\t\t\"id\": \"unit\",\n\t\t\t\t\"label\": \"Unit\",\n\t\t\t\t\"options\": [\n\t\t\t\t\t{\n\t\t\t\t\t\t\"value\": \"pixel\",\n\t\t\t\t\t\t\"label\": \"Pixel\"\n\t\t\t\t\t},\n\t\t\t\t\t{\n\t\t\t\t\t\t\"value\": \"percent\",\n\t\t\t\t\t\t\"label\": \"Percent\"\n\t\t\t\t\t}\n\t\t\t\t],\n\t\t\t\t\"default\": \"percent\",\n\t\t\t\t\"visible_if\": \"{{ block.settings.custom_width }}\"\n\t\t\t},\n\t\t\t{\n\t\t\t\t\"type\": \"range\",\n\t\t\t\t\"id\": \"percent_width\",\n\t\t\t\t\"label\": \"Width\",\n\t\t\t\t\"min\": 10,\n\t\t\t\t\"max\": 100,\n\t\t\t\t\"step\": 1,\n\t\t\t\t\"unit\": \"%\",\n\t\t\t\t\"default\": 100,\n\t\t\t\t\"visible_if\": \"{{ block.settings.custom_width and block.settings.unit == 'percent' }}\"\n\t\t\t},\n\t\t\t{\n\t\t\t\t\"type\": \"range\",\n\t\t\t\t\"id\": \"pexel_width\",\n\t\t\t\t\"label\": \"Width\",\n\t\t\t\t\"min\": 10,\n\t\t\t\t\"max\": 500,\n\t\t\t\t\"step\": 5,\n\t\t\t\t\"unit\": \"px\",\n\t\t\t\t\"default\": 100,\n\t\t\t\t\"visible_if\": \"{{ block.settings.custom_width and block.settings.unit == 'pixel' }}\"\n\t\t\t},\n\t\t\t{\n\t\t\t\t\"type\": \"checkbox\",\n\t\t\t\t\"id\": \"custom_mobile_width\",\n\t\t\t\t\"label\": \"Custom Mobile Width\",\n\t\t\t\t\"visible_if\": \"{{ block.settings.custom_width}}\"\n\t\t\t},\n\t\t\t{\n\t\t\t\t\"type\": \"select\",\n\t\t\t\t\"id\": \"mobile_unit\",\n\t\t\t\t\"label\": \"Mobile Unit\",\n\t\t\t\t\"options\": [\n\t\t\t\t\t{\n\t\t\t\t\t\t\"value\": \"pixel\",\n\t\t\t\t\t\t\"label\": \"Pixel\"\n\t\t\t\t\t},\n\t\t\t\t\t{\n\t\t\t\t\t\t\"value\": \"percent\",\n\t\t\t\t\t\t\"label\": \"Percent\"\n\t\t\t\t\t}\n\t\t\t\t],\n\t\t\t\t\"default\": \"percent\",\n\t\t\t\t\"visible_if\": \"{{ block.settings.custom_mobile_width }}\"\n\t\t\t},\n\t\t\t{\n\t\t\t\t\"type\": \"range\",\n\t\t\t\t\"id\": \"mobile_percent_width\",\n\t\t\t\t\"label\": \"Mobile Width\",\n\t\t\t\t\"min\": 10,\n\t\t\t\t\"max\": 100,\n\t\t\t\t\"step\": 1,\n\t\t\t\t\"unit\": \"%\",\n\t\t\t\t\"default\": 100,\n\t\t\t\t\"visible_if\": \"{{ block.settings.custom_mobile_width and block.settings.mobile_unit == 'percent' }}\"\n\t\t\t},\n\t\t\t{\n\t\t\t\t\"type\": \"range\",\n\t\t\t\t\"id\": \"mobile_pexel_width\",\n\t\t\t\t\"label\": \"Mobile Width\",\n\t\t\t\t\"min\": 10,\n\t\t\t\t\"max\": 500,\n\t\t\t\t\"step\": 5,\n\t\t\t\t\"unit\": \"px\",\n\t\t\t\t\"default\": 100,\n\t\t\t\t\"visible_if\": \"{{ block.settings.custom_mobile_width and block.settings.mobile_unit == 'pixel' }}\"\n\t\t\t},\n\t\t\t{\n\t\t\t\t\"type\": \"header\",\n\t\t\t\t\"content\": \"Height\"\n\t\t\t},\n\t\t\t{\n\t\t\t\t\"type\": \"checkbox\",\n\t\t\t\t\"id\": \"custom_height\",\n\t\t\t\t\"label\": \"Adjust Height\"\n\t\t\t},\n\t\t\t{\n\t\t\t\t\"type\": \"range\",\n\t\t\t\t\"id\": \"height\",\n\t\t\t\t\"label\": \"Height\",\n\t\t\t\t\"min\": 10,\n\t\t\t\t\"max\": 500,\n\t\t\t\t\"step\": 5,\n\t\t\t\t\"unit\": \"px\",\n\t\t\t\t\"default\": 100,\n\t\t\t\t\"visible_if\": \"{{ block.settings.custom_height }}\"\n\t\t\t},\n\t\t\t{\n\t\t\t\t\"type\": \"checkbox\",\n\t\t\t\t\"id\": \"custom_mobile_height\",\n\t\t\t\t\"label\": \"Custom Mobile Height\",\n\t\t\t\t\"visible_if\": \"{{ block.settings.custom_height }}\"\n\t\t\t},\n\t\t\t{\n\t\t\t\t\"type\": \"range\",\n\t\t\t\t\"id\": \"mobile_height\",\n\t\t\t\t\"label\": \"Mobile Height\",\n\t\t\t\t\"min\": 10,\n\t\t\t\t\"max\": 500,\n\t\t\t\t\"step\": 5,\n\t\t\t\t\"unit\": \"px\",\n\t\t\t\t\"default\": 100,\n\t\t\t\t\"visible_if\": \"{{ block.settings.custom_mobile_height }}\"\n\t\t\t},\n\t\t\t{\n\t\t\t\t\"type\": \"header\",\n\t\t\t\t\"content\": \"Padding\"\n\t\t\t},\n\t\t\t{\n\t\t\t\t\"type\": \"checkbox\",\n\t\t\t\t\"id\": \"custom_padding\",\n\t\t\t\t\"label\": \"Add Padding\"\n\t\t\t},\n\n\t\t\t{\n\t\t\t\t\"type\": \"range\",\n\t\t\t\t\"id\": \"padding_top\",\n\t\t\t\t\"label\": \"Padding Top\",\n\t\t\t\t\"min\": 1,\n\t\t\t\t\"max\": 100,\n\t\t\t\t\"step\": 1,\n\t\t\t\t\"unit\": \"px\",\n\t\t\t\t\"default\": 1,\n\t\t\t\t\"visible_if\": \"{{ block.settings.custom_padding == true }}\"\n\t\t\t},\n\t\t\t{\n\t\t\t\t\"type\": \"range\",\n\t\t\t\t\"id\": \"padding_bottom\",\n\t\t\t\t\"label\": \"Padding Bottom\",\n\t\t\t\t\"min\": 1,\n\t\t\t\t\"max\": 100,\n\t\t\t\t\"step\": 1,\n\t\t\t\t\"unit\": \"px\",\n\t\t\t\t\"default\": 1,\n\t\t\t\t\"visible_if\": \"{{ block.settings.custom_padding == true }}\"\n\t\t\t},\n\t\t\t{\n\t\t\t\t\"type\": \"range\",\n\t\t\t\t\"id\": \"padding_left\",\n\t\t\t\t\"label\": \"Padding Left\",\n\t\t\t\t\"min\": 1,\n\t\t\t\t\"max\": 100,\n\t\t\t\t\"step\": 1,\n\t\t\t\t\"unit\": \"px\",\n\t\t\t\t\"default\": 24,\n\t\t\t\t\"visible_if\": \"{{ block.settings.custom_padding == true }}\"\n\t\t\t},\n\t\t\t{\n\t\t\t\t\"type\": \"range\",\n\t\t\t\t\"id\": \"padding_right\",\n\t\t\t\t\"label\": \"Padding Right\",\n\t\t\t\t\"min\": 1,\n\t\t\t\t\"max\": 100,\n\t\t\t\t\"step\": 1,\n\t\t\t\t\"unit\": \"px\",\n\t\t\t\t\"default\": 24,\n\t\t\t\t\"visible_if\": \"{{ block.settings.custom_padding == true }}\"\n\t\t\t},\n\t\t\t{\n\t\t\t\t\"type\": \"header\",\n\t\t\t\t\"content\": \"Class and ID\"\n\t\t\t},\n\t\t\t{\n\t\t\t\t\"type\": \"text\",\n\t\t\t\t\"id\": \"id\",\n\t\t\t\t\"label\": \"Add button ID\",\n\t\t\t\t\"placeholder\": \"E.g add-to-cart \"\n\t\t\t},\n\t\t\t{\n\t\t\t\t\"type\": \"text\",\n\t\t\t\t\"id\": \"class\",\n\t\t\t\t\"label\": \"Additional Classes\",\n\t\t\t\t\"placeholder\": \"E.g rounded-full! \"\n\t\t\t}\n\t\t],\n\t\t\"presets\": [\n\t\t\t{\n\t\t\t\t\"name\": \"Button\",\n\t\t\t\t\"category\": \"Kuu Components\",\n\t\t\t\t\"settings\": {\n\t\t\t\t\t\"label\": \"Button\",\n\t