        "kuu_codeblock_rejyPY": {
          "type": "kuu-codeblock",
          "name": "Code Block",
          "settings": {
            "language": "liquid",
            "content": "",
            "liquid_code": "{% raw %}\n{% # if only icon is passed and no size or label props, set button size to icon %}\n{% if label == blank and size == blank %}\n\t{% assign size = 'icon' %}\n{% endif %}\n\n{% capture inline_styles %}\n  {% if width %}\n    --width: {{width}};\n  {% endif %}\n  {% if mobile_width %}\n    --mobile-width: {{mobile_width}};\n  {% endif %}\n\n  {% if height %}\n    --height: {{height}};\n  {% endif %}\n  {% if mobile_height %}\n    --mobile-height: {{mobile_height}};\n  {% endif %}\n\n  {% if color %}\n    --color:{{color}};\n    {% assign contrast = color | color_contrast: '#ffffff' %}\n\t{% if contrast < 3.1 %}\n    --color-foreground:#000000;\n\t{% else %}\n\t\t--color-foreground:#ffffff;\n\t{% endif %}\n  {% endif %}\n\n\n\n  {% if radius %}\n    --br:{{radius}};\n  {% endif %}\n\n  {% if padding_top %}\n    --pt:{{padding_top}};\n  {% endif %}\n  \n\n  {% if padding_bottom %}\n    --pb:{{padding_bottom}};\n  {% endif %}\n\n  {% if padding_left %}\n    --pl:{{padding_left}};\n  {% endif %}\n\n  {% if padding_right %}\n    --pr:{{padding_right}};\n  {% endif %}\n\n  {%- case size -%}\n    {%- when 'sm' -%}\n      --fallback-height:32px;\n      --fallback-pr:12px;\n      --fallback-pl:12px;\n    \n    {%- when 'lg' -%}\n      --fallback-height:48px;\n      --fallback-pr:24px;\n      --fallback-pl:24px;\n\n    {%- when 'full' -%}\n    --fallback-width:100%;\n    --fallback-height:48px;\n\n        {%- when 'icon-sm' -%}\n      --fallback-width:32px;\n      --fallback-height:32px;\n      --fallback-pt:8px;\n      --fallback-pb:8px;\n      --fallback-pr:8px;\n      --fallback-pl:8px;\n    \n    {%- when 'icon' -%}\n      --fallback-width:40px;\n      --fallback-height:40px;\n      --fallback-pt:8px;\n      --fallback-pb:8px;\n      --fallback-pr:8px;\n      --fallback-pl:8px;\n\n    {%- when 'icon-lg' -%}\n      --fallback-width:48px;\n      --fallback-height:48px;\n      --fallback-pt:8px;\n      --fallback-pb:8px;\n      --fallback-pr:8px;\n      --fallback-pl:8px;\n\n    {%- when 'none' -%}\n      \n    {%- else -%}\n      --fallback-height:40px;\n      --fallback-pr:16px;\n      --fallback-pl:16px;\n      \n  {%- endcase -%}\n\n{% endcapture %}\n\n{% if block.id != blank %}\n\t{% assign button_class = 'button' | append: block.id %}\n{% endif %}\n\n{%- assign base_class = 'button relative inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:size-5 [&_svg]:shrink-0 cursor-pointer' -%}\n\n{%- case variant -%}\n\t{%- when 'default' -%}\n\t\t{%- assign variant_class = 'bg-primary text-primary-foreground hover:bg-primary/90' -%}\n\t{%- when 'primary' -%}\n\t\t{%- assign variant_class = 'bg-primary text-primary-foreground hover:bg-primary/90' -%}\n\t{%- when 'destructive' -%}\n\t\t{%- assign variant_class = 'bg-destructive text-destructive-foreground hover:bg-destructive/90' -%}\n\t{%- when 'secondary' -%}\n\t\t{%- assign variant_class = 'bg-secondary text-secondary-foreground hover:bg-secondary/80' -%}\n\t{%- when 'outline' -%}\n\t\t{%- assign variant_class = 'border border-input bg-background hover:bg-accent hover:text-accent-foreground' -%}\n\t{%- when 'ghost' -%}\n\t\t{%- assign variant_class = 'hover:bg-accent hover:text-accent-foreground' -%}\n\t{% when 'white' %}\n\t\t{% assign variant_class = 'bg-white text-black hover:bg-primary hover:text-primary-foreground ' %}\n\t{% when 'link' %}\n\t\t{% assign variant_class = 'text-primary underline-offset-4 hover:underline' %}\n\t{%- else -%}\n\t\t{%- assign variant_class = '' -%}\n{%- endcase -%}\n\n{%- case size -%}\n\t{%- when 'default' -%}\n\t\t{%- assign size_class = 'h-10 px-4 py-2' -%}\n\t{%- when 'sm' -%}\n\t\t{%- assign size_class = 'h-9 rounded-md px-3 ' -%}\n\t{%- when 'lg' -%}\n\t\t{%- assign size_class = 'h-11 rounded-md px-8' -%}\n\t{%- when 'full' -%}\n\t\t{%- assign size_class = 'w-full h-11 rounded-md px-8' -%}\n\t{%- when 'icon' -%}\n\t\t{%- assign size_class = 'size-10' -%}\n\t{%- when 'icon-sm' -%}\n\t\t{%- assign size_class = 'size-8' -%}\n\t{%- when 'icon-lg' -%}\n\t\t{%- assign size_class = 'size-12' -%}\n\t{%- when 'none' -%}\n\t\t{%- assign size_class = '' -%}\n\t{%- else -%}\n\t\t{%- assign size_class = 'h-10 px-4 text-sm rounded-md' -%}\n{%- endcase -%}\n\n{%- assign classes = button_class\n\t| append: ' '\n\t| append: base_class\n\t| append: ' '\n\t| append: variant_class\n\t| append: ' '\n\t| append: size_class\n\t| append: ' '\n\t| append: class\n\t| append: ' '\n\t| append: button_class\n-%}\n\n{% assign icon_position = icon_position | default: 'left' %}\n\n{% capture loading_spinner %}\n  <span aria-hidden=\"true\" class=\"animate-spin\">{{ 'icons/loader-circle.svg' | inline_asset_content }}</span>\n{% endcapture %}\n\n{% capture icon %}\n  {% if lucide_icon %}\n     <i data-lucide=\"{{lucide_icon}}\"></i>\n     {% elsif icon %}\n       {{ icon | inline_asset_content }}\n  {% endif %}\n{% endcapture %}\n\n{% capture icon_content %}\n    {% if loading %}\n    {{loading_spinner}}\n  {% else %}\n    {{icon}}\n  {% endif %}\n{% endcapture %}\n\n{% case icon_position %}\n\t{% when 'left' %}\n\t\t{% assign flex_direction = 'flex-row gap-2' %}\n\t{% when 'right' %}\n\t\t{% assign flex_direction = 'flex-row-reverse gap-2 ' %}\n\t{% when 'top' %}\n\t\t{% assign flex_direction = 'flex-col gap-1 py-1' %}\n\t{% when 'bottom' %}\n\t\t{% assign flex_direction = 'flex-col-reverse gap-1' %}\n\t{% else %}\n\t\t{% assign flex_direction = 'flex-row gap-2 py-1' %}\n{% endcase %}\n\n{%- capture default_content -%}\n  <span aria-hidden=\"true\" class=\"flex items-center {{flex_direction}} \">\n\n    {{icon_content}}\n\n  {%- if label -%}\n        <span>{{ label }}</span>\n  {%- endif -%}\n\n   \n  </span>\n{%- endcapture -%}\n\n{%- assign final_content = content | default: default_content -%}\n{% assign aria_label = aria_label | default: label | default: null %}\n{% assign device = device | default: 'all' %}\n\n{% if device == 'all' %}\n\t{% assign display_class = 'flex' %}\n{% elsif device == 'mobile' %}\n\t{% assign display_class = 'flex md:hidden' %}\n{% elsif device == 'desktop' %}\n\t{% assign display_class = 'hidden md:flex' %}\n{% endif %}\n\n<div\n\tclass='{{display_class}} shrink-0 {{wrapper_class}}'\n\t{% if align %}\n\t\tstyle='justify-content:{{align}}';\n\t{% endif %}\n>\n\t{% capture button_props %}\n   class=\"{{ classes }}\"\n    {% if id %}\n    id=\"{{ id }}\"\n    {% endif %}\n    {% if onclick %}\n    onclick=\"{{ onclick }}\"\n    {% endif %}\n    {% if aria_label %}\n    aria-label=\"{{ aria_label }}\"\n    {% endif %}\n    {% if props %}\n    {{ props }}\n    {% endif %}\n    style=\"{{inline_styles | strip}}\"\n     x-data\n   \n{% endcapture %}\n\n\t{%- if href -%}\n\t\t<a\n\t\t\thref='{{ href }}'\n\t\t\t{% if target_blank %}\n\t\t\t\ttarget='_blank'\n\t\t\t{% endif %}\n\t\t\t{{ button_props }}\n\t\t>\n\t\t\t{{ final_content }}\n\t\t</a>\n\t{%- else -%}\n\t\t<button\n\t\t\ttype='{{ type | default: 'button' }}'\n\t\t\t{{ button_props }}\n\t\t>\n\t\t\t{{ final_content }}\n\t\t</button>\n\t{%- endif -%}\n\n\t<style>\n\t\t.{{button_class}}{\n\n\t\t    {% if color %}\n\t\t    background-color:var(--color);\n\t\t      color: var(--color-foreground,#000000);\n\n\t\t  {% endif %}\n\n\t\t  width: var(--width, var(--fallback-width, auto));\n\t\t  height:var(--height, var(--fallback-height, auto));\n\t\t  border-radius: var(--br,8px);\n\t\t  padding-left: var(--pl, var(--fallback-pl, 0));\n\t\t  padding-right: var(--pr, var(--fallback-pr, 0));\n\t\t  padding-top: var(--pt, var(--fallback-pt, 0));\n\t\t  padding-bottom: var(--pb, var(--fallback-pb, 0));\n\n\t\t  @media (max-width:768px) {\n\t\t  width: var(--mobile-width, var(--width, var(--fallback-width, auto)));\n\t\t  height: var(--mobile-height, var(--height, var(--fallback-height, auto)));\n\t\t  }\n\t\t}\n\n\n\n\n\t\t.button svg {\n\t\t  color: currentColor;\n\t\t  flex-shrink: 0 !important;\n\t\t}\n\t</style>\n</div>\n\n\n{% endraw %}",
