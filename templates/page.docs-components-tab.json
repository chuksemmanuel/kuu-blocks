          "type": "kuu-markdown",
          "name": "Markdown with Padding",
          "settings": {
            "content": "## Dynamic Tab Buttons\n\nFor blocks that generate tabs dynamically (like `products-tab.liquid`), use a script to populate buttons:",
            "padding-block-start": 24,
            "padding-block-end": 24,
            "padding-inline-start": 0,
            "padding-inline-end": 0,
            "custom_mobile_padding": true,
            "mobile-padding-block-start": 16,
            "mobile-padding-block-end": 16,
            "mobile-padding-inline-start": 0,
            "mobile-padding-inline-end": 0
          },
          "blocks": {}
        },
        "kuu_codeblock_NzMChV": {
          "type": "kuu-codeblock",
          "name": "Code Block",
          "settings": {
            "language": "javascript",
            "content": "/** Populate Tab Buttons **/\nfunction populateTabButtons() {\n  const container = document.querySelector('[data-horizontal-scroll=\"tab-id\"]');\n  const contents = document.querySelectorAll('[data-tab-content]');\n\n  container.innerHTML = '';\n\n  contents.forEach((content) => {\n    const title = content.dataset.tabContent;\n    container.insertAdjacentHTML('beforeend', `\n      <button data-tab-trigger=\"${title}\" role=\"tab\" class=\"px-4 py-2 rounded-lg\" :aria-selected=\"tabButtonActive($el)\">\n        ${title}\n      </button>\n    `);\n  });\n}\n\npopulateTabButtons();",
            "liquid_code": "{% raw %}\n\n{% endraw %}",
            "copy_button": true,
            "show_pathname": false,
            "pathname": "snippets/kuu-button.liquid",
            "height": "fit-content",
