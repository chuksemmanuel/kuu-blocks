                            "kuu_codeblock_UpyQtB": {
                              "type": "kuu-codeblock",
                              "name": "Code Block",
                              "settings": {
                                "language": "liquid",
                                "content": "",
                                "liquid_code": "{% raw %}\n{% assign id = id | default: 'scroll-x' %}\n\n<div\n\tdata-horizontal-scroll='{{id}}'\n\t{{ props }}\n\n\tclass='no-scrollbar relative z-10 flex  w-full shrink-0   gap-4 overflow-x-auto  overflow-y-hidden {{class}} '\n\t:class=\"!isDragging ? 'cursor-grap': 'cursor-grabbing'\"\n\tx-data=\"\n\t\t{\n\t\t  isDragging: false,\n\t\t  startX: 0,\n\t\t  scrollLeft: 0,\n\t\t  init() {\n\t\t    $el.style.scrollBehavior = 'auto'; // Disable smooth scrolling for better drag fe$el\n\t\t  },\n\t\t  startDragging(e) {\n\t\t    this.isDragging = true;\n\t\t    this.startX = e.pageX - $el.offsetLeft;\n\t\t    this.scrollLeft = $el.scrollLeft;\n\t\t  },\n\t\t  stopDragging() {\n\t\t    this.isDragging = false;\n\t\t  },\n\t\t  drag(e) {\n\t\t    if (!this.isDragging) return;\n\t\t    e.preventDefault();\n\t\t    const x = e.pageX - $el.offsetLeft;\n\t\t    const walk = (x - this.startX) * 1.5; // Adjust multiplier for desired scroll speed\n\t\t    $el.scrollLeft = this.scrollLeft - walk;\n\t\t  },\n\t\t}\n\t\"\n\tx-init='init()'\n\t@mousedown='startDragging'\n\t@mouseup='stopDragging'\n\t@mouseleave='stopDragging'\n\t@mousemove='drag'\n>\n\t{{ content }}\n</div>\n\n\n{% endraw %}",
