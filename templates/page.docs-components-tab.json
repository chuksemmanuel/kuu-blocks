                                "language": "liquid",
                                "content": "",
                                "liquid_code": "{% raw %}\n\n{% assign tabId = block.id | append: '-tab' %}\n\n{% # Tag triggers buttons %}\n{% capture tab_button_list %}\n          {% for block in block.blocks %}\n          {% endfor %}\n{% endcapture %}\n\n{% # Tag triggers -  horizontally scrollable %}\n{% capture tab_triggers %}\n         \n            {% render 'horizontal-scroll',\n            content: tab_button_list,\n            id:tabId,\n            props: '  \n                  x-ref=\"tabButtons\"\n                  role=\"tablist\"\n                  aria-label=\"Products tabs\"\n                ',\n            class: ' pl-3 lg:pl-5 text-gray-500 select-none h-10'\n                %}\n            \n{% endcapture %}\n\n{% capture tab_content %}\n      {% content_for 'blocks' %}\n{% endcapture %}\n\n{% render 'kuu-tab',\n\ttriggers: tab_triggers,\n\tcontents: tab_content,\n\tclass: 'h-full flex flex-col overflow-hidden',\n\ttrigger_class: 'shrink-0 pb-2',\n\tcontent_class: 'flex-1 overflow-y-auto',\n\tid: tabId\n%}\n\n{% schema %}\n\t{\n\t\t\"name\": \"Products tab\",\n\t\t\"class\": \"w-full\",\n\t\t\"settings\": [],\n\t\t\"blocks\": [\n\t\t\t{\n\t\t\t\t\"type\": \"_products-tab-product-picker\"\n\t\t\t},\n\t\t\t{\n\t\t\t\t\"type\": \"@app\"\n\t\t\t}\n\t\t],\n\t\t\"presets\": [\n\t\t\t{\n\t\t\t\t\"name\": \"Products tab\"\n\t\t\t}\n\t\t]\n\t}\n{% endschema %}\n\n<script>\n\tpopulateTabButtons();\n\t// in theme editor, repopulate buttons when changes occur\n\t {% if request.design_mode %}\n\twindow.addEventListener('shopify:section:load', populateTabButtons)\n\t {% endif %}\n\tfunction populateTabButtons() {\n\t\t// Clear horizontal scroll container\n\t\tdocument.querySelector('[data-horizontal-scroll=\"{{tabId}}\"]').innerHTML = '';\n\n\t\tlet addedTabs = [];\n\t\tlet tabEl = document.querySelector('[data-tab-id=\"{{tabId}}\"]');\n\t\ttabEl.querySelectorAll('[data-tab-content]').forEach((tabContentEl) => {\n\t\t\t\n\t\t\tif (!addedTabs.includes(tabContentEl.dataset.tabContent)) {\n\t\t\t\tdocument.querySelector('[data-horizontal-scroll=\"{{tabId}}\"]').insertAdjacentHTML(\n\t\t\t\t\t'beforeend',\n\t\t\t\t\t/*html*/ `\n        <button\n              data-trigger-block-id=\"{{block.id}}\"\n              data-tab-trigger=\"${tabContentEl.dataset.tabContent}\"\n              role=\"tab\"\n              aria-label=\"${tabContentEl.dataset.tabContent}\"\n              :aria-selected=\"tabButtonActive($el)\"\n              aria-controls=\"\"\n              type=\"button\"\n              :class=\"{ 'bg-primary text-primary-foreground' : tabButtonActive($el) }\"\n              class=\"relative z-10 inline-flex h-10 w-fit cursor-pointer items-center justify-center rounded-full bg-gray-100 px-3 text-sm font-medium whitespace-nowrap transition duration-300 ease-out\">\n              ${tabContentEl.dataset.tabContent}\n            </button>\n    `,\n\t\t\t\t);\n\t\t\t\taddedTabs.push(tabContentEl.dataset.tabContent);\n\t\t\t}\n\t\t});\n\t}\n</script>\n\n{% endraw %}",
