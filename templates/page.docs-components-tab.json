                              "settings": {
                                "language": "liquid",
                                "content": "",
                                "liquid_code": "{% raw %}\n\n{% for product in block.settings.products %}\n\t<a\n\t\tdata-content-block-id='{{block.id}}'\n\t\tdata-tab-content='{{block.settings.tab_title}}'\n\t\taria-label='{{product.title}}'\n\t\trole='listitem'\n\t\thref='{{ product.url }}'\n\t\tclass='group flex flex-col  gap-5  rounded-lg p-4 transition duration-300  lg:p-6'\n\t>\n\t\t<div class='flex items-center gap-5'>\n\t\t\t<div\n\t\t\t\tclass='block size-20 shrink-0 overflow-hidden rounded  bg-gray-200'\n\t\t\t>\n\t\t\t\t<img\n\t\t\t\t\tsrc='{{ product.featured_image | image_url : width : 200 }}'\n\t\t\t\t\talt='{{ product.title }}'\n\t\t\t\t\tclass='h-full w-full object-cover'\n\t\t\t\t\twidth='80px'\n\t\t\t\t\theight='80px'\n\t\t\t\t>\n\t\t\t</div>\n\t\t\t<div class='flex flex-col gap-2'>\n\t\t\t\t<p class='reversed-link text-lg'>{{ product.title }}</p>\n\t\t\t\t{% if block.settings.show_prices %}\n\t\t\t\t\t<div class='flex items-center gap-2'>\n\t\t\t\t\t\t<p class='text-lg text-red-500'>{{ product.price | money }}</p>\n\t\t\t\t\t\t{% if block.settings.show_compare_at_prices %}\n\t\t\t\t\t\t\t<p class='text-lg text-gray-500 line-through'>{{ product.compare_at_price | money }}</p>\n\t\t\t\t\t\t{% endif %}\n\t\t\t\t\t</div>\n\t\t\t\t{% endif %}\n\t\t\t</div>\n\t\t</div>\n\t</a>\n{% endfor %}\n\n{% schema %}\n\t{\n\t\t\"name\": \"Product Picker\",\n\t\t\"settings\": [\n\t\t\t{\n\t\t\t\t\"type\": \"product_list\",\n\t\t\t\t\"id\": \"products\",\n\t\t\t\t\"label\": \"Products\"\n\t\t\t},\n\t\t\t{\n\t\t\t\t\"type\": \"text\",\n\t\t\t\t\"id\": \"tab_title\",\n\t\t\t\t\"label\": \"Tab Title\"\n\t\t\t},\n\t\t\t{\n\t\t\t\t\"type\": \"checkbox\",\n\t\t\t\t\"id\": \"show_prices\",\n\t\t\t\t\"label\": \"Show prices\",\n\t\t\t\t\"default\": true\n\t\t\t},\n\t\t\t{\n\t\t\t\t\"type\": \"checkbox\",\n\t\t\t\t\"id\": \"show_compare_at_prices\",\n\t\t\t\t\"label\": \"Show compare at prices\",\n\t\t\t\t\"default\": true,\n\t\t\t\t\"visible_if\": \"{{block.settings.show_prices}}\"\n\t\t\t}\n\t\t],\n\t\t\"presets\": [\n\t\t\t{\n\t\t\t\t\"name\": \"Products\"\n\t\t\t}\n\t\t]\n\t}\n{% endschema %}\n\n\n{% endraw %}",
