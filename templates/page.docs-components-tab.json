                "kuu_markdown_yDXNDz": {
                  "type": "kuu-markdown",
                  "name": "Markdown with Padding",
                  "settings": {
                    "content": "### 2. Add the JavaScript\n\nDownload `assets/js/components/kuu-tab.js` and place it in `assets/js/components/`.",
                    "padding-block-start": 24,
                    "padding-block-end": 24,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0,
                    "custom_mobile_padding": true,
                    "mobile-padding-block-start": 16,
