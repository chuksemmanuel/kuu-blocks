                    "language": "liquid",
                    "content": "",
                    "liquid_code": "{% raw %}\n{% assign block_settings = block.settings %}\n{% liquid\n\tassign id = id | default: 'tab'\n\tassign default_active = default_active\n%}\n\n<div\n\tdata-tab-id='{{id}}'\n\tdata-default-active='{{default_active}}'\n\t{% if block and block.id != blank %}\n\t\tdata-tab-block-id='{{block.id}}'\n\t{% endif %}\n\n\tx-data='tab'\n\tclass='spacing-style w-full {{class}} '\n\tstyle='{% render 'spacing-padding', settings: block_settings %}'\n\tx-cloak\n>\n\t<!-- Triggers -->\n\t<div\n\t\trole='tablist'\n\t\tclass='{{trigger_class}} '\n\t>\n\t\t{{ triggers }}\n\t</div>\n\n\t<!-- Contents -->\n\t<div class='{{content_class}} '>\n\t\t{{ contents }}\n\t</div>\n</div>\n\n\n{% endraw %}",
