    "kuu_blank_section_RLwbnk": {
      "type": "kuu-blank-section",
      "blocks": {
        "kuu_markdown_3NxwpD": {
          "type": "kuu-markdown",
          "name": "Markdown with Padding",
          "settings": {
            "content": "## Installation\n\n### 1. Add the Snippet\n\nCreate `snippets/kuu-drawer.liquid` and paste the drawer markup.",
            "padding-block-start": 24,
            "padding-block-end": 24,
            "padding-inline-start": 0,
            "padding-inline-end": 0,
            "custom_mobile_padding": true,
            "mobile-padding-block-start": 16,
            "mobile-padding-block-end": 16,
            "mobile-padding-inline-start": 0,
            "mobile-padding-inline-end": 0
          },
          "blocks": {}
        },
        "kuu_codeblock_Mwa7cL": {
          "type": "kuu-codeblock",
          "name": "Code Block",
          "settings": {
            "language": "liquid",
            "content": "",
            "liquid_code": "{% raw %}\n{% liquid\n\tassign from = from | default: 'right'\n\tassign mobile_from = mobile_from\n\tassign drawer_class = drawer_class | default: ''\n\tassign trigger_class = trigger_class | default: ''\n\tassign panel_class = panel_class | default: ''\n\tassign overlay_class = overlay_class | default: ''\n%}\n\n{% comment %}\n\tdrawer.liquid\n\t  Accepts:\n\t  - trigger: {String} a Capture of the trigger (usuallly a button)\n\t  - content: {String} a Capture/Snippet of the drawer content\n\t  - from: {String} Direction the drawer slides from\n\t  - id: {String} Unique identifier of the drawer to target (e.g., 'cartdrawer', 'menudrawer')  used to open/close the drawer via the drawer:open and drawer:close custom Event\n\t  Example:\n\t  window.dispatchEvent(new CustomEvent('drawer:open', { detail: { id: 'cartdrawer' } }))\n\t  window.dispatchEvent(new CustomEvent('drawer:close', { detail: { id: 'menu' } }))\n\n\tUsage:\n\t  {% render 'drawer'\n\t    , trigger: cart_trigger\n\t    , content: cart_content\n\t    , name: 'cartdrawer'\n\t    , from: 'right'\n\t  %}\n{% endcomment %}\n\n<style>\n\t[x-cloak] {\n\t\tdisplay: none !important;\n\t}\n\t.no-scrollbar::-webkit-scrollbar {\n\t\tdisplay: none;\n\t}\n\t.no-scrollbar {\n\t\t-ms-overflow-style: none;\n\t\tscrollbar-width: none;\n\t}\n\tbody.drawer-open {\n\t\toverflow: hidden;\n\t}\n</style>\n\n{% assign base_class = 'fixed flex flex-col justify-stretch w-full  z-50 overflow-y-auto no-scrollbar p-2 lg:p-4 focus-visible:outline-0' %}\n\n{% liquid\n\tassign vertical_direction = 'h-fit min-h-120 max-h-full left-0'\n\tassign horizontal_direction = 'h-full top-0 max-w-[min(648px,100%)]'\n\n\tassign top_direction = vertical_direction | append: 'top-0'\n\tassign bottom_direction = vertical_direction | append: 'bottom-0'\n\tassign left_direction = horizontal_direction | append: 'left-0'\n\tassign right_direction = horizontal_direction | append: 'right-0'\n%}\n\n<script type='application/json' data-drawer-script='{{id}}'>\n\t{\n\t  \"top\":{{top_direction |  json}},\n\t  \"bottom\":{{bottom_direction | json}},\n\t  \"left\":{{left_direction | json}},\n\t  \"right\":{{right_direction | json}}\n\t}\n</script>\n\n{% case from %}\n\t{% when 'top' %}\n\t\t{% assign direction_class = 'h-fit min-h-120 max-h-full left-0 top-0' %}\n\t{% when 'bottom' %}\n\t\t{% assign direction_class = 'h-fit min-h-120 max-h-full left-0 bottom-0' %}\n\t{% when 'left' %}\n\t\t{% assign direction_class = 'h-full top-0 max-w-[min(648px,100%)] left-0' %}\n\t{% when 'right' %}\n\t\t{% assign direction_class = 'h-full top-0 max-w-[min(648px,100%)] right-0' %}\n\t{% else %}\n\t\t{% assign direction_class = 'top-0 max-w-[min(648px,100%)] right-0' %}\n{% endcase %}\n\n<div\n\tx-data='drawer'\n\tx-init='init()'\n\tclass='{{drawer_class}}'\n\tdata-block-id='{{block.id}}'\n\tdata-section-id='{{section.id}}'\n\tdata-drawer-id='{{id}}'\n\tdata-direction='{{from}}'\n\tdata-base-class='{{ base_class }}'\n\tdata-custom-class='{{class}}'\n\tdata-mobile-direction='{{mobile_from}}'\n>\n\t<!-- Trigger -->\n\t{% if headless != true %}\n\t\t<div @click='openDrawer()' class='{{trigger_class}}'>\n\t\t\t{{ trigger }}\n\t\t</div>\n\t{% endif %}\n\n\t<!-- Overlay -->\n\t<div\n\t\tclass='fixed inset-0 z-40 bg-black/50 {{overlay_class}}'\n\t\tx-cloak\n\t\tx-ref='overlay'\n\t\tstyle='pointer-events: none; opacity: 0;'\n\t\t@click='closeDrawer()'\n\t></div>\n\n\t<!-- Drawer panel -->\n\t<div\n\t\tclass='{{base_class}} {{direction_class}} {{class}} {{panel_class}}'\n\n\t\tx-cloak\n\t\tx-ref='panel'\n\t\tstyle='opacity: 0; visibility: hidden; will-change: transform, opacity;'\n\t\t@click.stop\n\t\trole='dialog'\n\t\taria-modal='true'\n\t\taria-lablledby='drawer-title'\n\t\taria-describedby='drawer-description'\n\t\tx-trap='open'\n\t>\n\t\t{{ content }}\n\t</div>\n</div>\n\n{% endraw %}",
            "copy_button": true,
            "show_pathname": true,
            "pathname": "snippets/kuu-drawer.liquid",
            "height": "fit-content",
            "custom_height": 348,
            "height_min": 0,
