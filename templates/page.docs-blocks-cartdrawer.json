                  "name": "Markdown with Padding",
                  "settings": {
                    "content": "### 1. Add the Block\n\nAdd `blocks/kuu-cartdrawer.liquid` to your theme.",
                    "padding-block-start": 24,
                    "padding-block-end": 24,
                    "padding-inline-start": 0,
