                "kuu_tab_E6E8CF": {
                  "type": "kuu-tab",
                  "name": "Kuu Tab",
                  "settings": {
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0,
                    "custom_mobile_padding": true,
