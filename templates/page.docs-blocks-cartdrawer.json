                  "blocks": {
                    "kuu_tab_item_em8bXy": {
                      "type": "_kuu-tab-item",
                      "name": "kuu-cartdrawer",
                      "settings": {
                        "tab_title": "Cartdrawer main"
                      },
                      "blocks": {
                        "kuu_codeblock_4Cgyrj": {
                          "type": "kuu-codeblock",
                          "name": "Code Block",
                          "settings": {
                            "language": "liquid",
                            "content": "",
                            "liquid_code": "{% raw %}\n\n{% liquid\n\tassign headless = headless\n\tassign id = id | default: 'cartdrawer'\n\n\tassign sticky_header = sticky_header\n\tassign sticky_footer = sticky_footer\n\n\tassign show_compare_price = show_compare_price\n\tassign final_price_color = final_price_color | default: '#fb2c36'\n\n\tassign show_savings_badge = show_savings_badge\n\tassign savings_badge_color = savings_badge_color | default: '#fb2c36'\n\n\tassign show_variant_title = show_variant_title\n\n\tassign show_secondary_footer_cta = show_secondary_footer_cta\n\tassign secondary_footer_cta_label = secondary_cta_label | default: 'Continue Shopping'\n\tassign secondary_footer_cta_link = secondary_cta_link | default: null\n\n\tassign show_checkout_lock_icon = show_checkout_lock_icon\n\tassign checkout_button_label = checkout_button_label | default: 'Proceed to Checkout'\n%}\n\n{% capture footer %}\n    {% render 'kuu-cartdrawer-footer'\n    , show_compare_price:show_compare_price\n    , final_price_color:final_price_color\n    , show_secondary_footer_cta:show_secondary_footer_cta\n    , secondary_footer_cta_label:secondary_footer_cta_label\n    , secondary_footer_cta_link:secondary_footer_cta_link\n    , show_checkout_lock_icon: show_checkout_lock_icon\n    , checkout_button_label:checkout_button_label\n    %}\n{% endcapture %}\n<div\n\tid='cartdrawer'\n\tx-data='cartDrawer()'\n\tdata-section-id='{{ section_id }}'\n\t{{ shopify_attributes }}\n>\n\t{% capture cart_button %}\n        <span class=\"bg-primary text-primary-foreground absolute -top-2 -right-2 z-20 flex size-6 items-center justify-center rounded-full! p-1 text-xs\" data-cartdrawer-bubble>{{ cart.item_count }}</span>\n          <span aria-hidden=\"true\"> {{ 'icons/shopping-cart.svg' | inline_asset_content }}</span>\n  {% endcapture %}\n\t{% capture cart_trigger %}\n       {% render 'kuu-button'\n  , variant: 'white'\n  , size: 'icon'\n  , content: cart_button\n  , class:'rounded-full!'\n  , aria_label: 'Open Shopping cart'\n  , props: 'x-data @click=\"$dispatch(`drawer:open`,{id:`cartdrawer`})\"'\n%}\n  {% endcapture %}\n\t{% capture cart_content %}\n  \n  <div role=\"status\" aria-live=\"assertive\" class=\"sr-only\" id=\"cartdrawer-live-region\" aria-atomic=\"true\" data-drawer-live-region></div>\n  {% comment %} <h2 id=\"drawer-title\" class=\"sr-only\">Cart Drawer</h2> {% endcomment %}\n  \n  {% comment %} {% if cart.empty? %}\n    <p  id=\"drawer-description\" class=\"sr-only\"> Your Cart is empty.</p>\n    {% else %}\n     <p  id=\"drawer-description\" class=\"sr-only\"> Your shopping cart with {{ cart.item_count }} items.</p>\n  {% endif %} {% endcomment %}\n\n  <div id=\"cartdrawer-content\" class=\"h-full w-full flex-1 overflow-hidden rounded-md  bg-white shadow-lg lg:rounded-lg\">\n    {% if cart.empty? %}\n      <div id=\"cartdrawer-empty\" class=\"flex h-full w-full flex-col items-center justify-center gap-4\" >\n\n        {% render 'kuu-button'\n        , size: 'icon'\n        , content: cart_button\n        , class: 'bg-white text-black  size-12 rounded-full! '\n        , props:'aria-hidden=\"true\"'\n        %}\n        <p class=\"text-xl font-semibold\" id=\"drawer-description\">Your Cart is Empty</p>\n        {% render 'kuu-button',variant:'primary', size:'lg', label:'Continue Shopping', aria_label:'Close cart drawer and continue shopping', class:'rounded-full!', props:'data-drawer-close tabIndex=\"0\"' %}\n\n      </div>\n    {% else %}\n      <p  id=\"drawer-description\" class=\"sr-only\"> Your shopping cart with {{ cart.item_count }} items.</p>\n      <div  class=\"flex h-full w-full flex-col\">\n\n          <div id=\"cartdrawer-inner\" class=\" flex flex-1 flex-col \" :class=\"settings.stickyHeader ? 'overflow-hidden' : 'overflow-y-auto'\">\n      \n            <!-- Cart Header -->\n            <div id=\"cartdrawer-header\" class=\"flex h-fit min-h-12 shrink-0 flex-col gap-2 \" aria-label=\"Cart Drawer Header\" tabindex=\"0\">\n\n                <div id=\"cartdrawer-header-inner\" class=\"flex w-full items-center justify-between px-5 pt-4 pb-2 lg:px-8 lg:pb-2\" >\n                  <div class=\"flex items-center gap-2\" role=\"presentation\">\n                        <span class=\"sr-only\">You have {{cart.item_count}} items in cart</span>\n                        <p  aria-hidden=\"true\" class=\"font-semibold lg:text-lg\">Cart </p>\n                        <span  aria-hidden=\"true\" class=\"bg-primary text-primary-foreground flex size-6 min-w-fit items-center justify-center rounded-full p-px text-sm\">{{cart.item_count}}</span>\n                  </div>\n                  {% render 'kuu-button', icon:'icons/cancel.svg',class:'rounded-full! size-6! p-0! ', props:'data-drawer-close', aria_label:'Close Cart Drawer' %}\n                </div>\n                \n            </div>\n            \n            {%# Always Scrollable %}\n            <div class=\"flex flex-1 flex-col justify-between  pt-1 lg:pt-2 \" :class=\"settings.stickyHeader ? 'overflow-y-auto' : ''\">\n\n              <div class=\"pb-5 lg:pb-8\">\n                  {%# Cart Items %}\n                  {% render 'kuu-cartdrawer-items'\n                  , show_compare_price:show_compare_price\n                  , final_price_color:final_price_color\n                  , show_savings_badge:show_savings_badge\n                  , show_variant_title:show_variant_title\n                  , savings_badge_color:savings_badge_color\n                  %}\n              </div>\n\n\n                  <div>\n                    {%# Recommended Products %}\n                    <div class=\"hidden min-h-32 w-full animate-pulse rounded-lg bg-gray-200\"></div>\n\n\n                    <template x-if=\"!settings.stickyFooter\">\n                      {{footer}}\n                    </template>\n                 \n                  </div>\n              \n            </div>\n\n          </div>\n\n                    <template x-if=\"settings.stickyFooter\">\n                      {{footer}}\n                    </template>\n\n     \n      \n      </div>\n\n    {% endif %}\n    </div>\n  {% endcapture %}\n\t{% render 'kuu-drawer', trigger: cart_trigger, content: cart_content, id: id, from: 'right', headless: headless %}\n</div>\n\n<script type='application/json' id='cartdrawer-settings'>\n\t{\n\t\"stickyHeader\": {{ sticky_header | json }},\n\t\"stickyFooter\": {{ sticky_footer | json }},\n\n\t\"showComparePrice\": {{ show_compare_price | json }},\n\t\"finalPriceColor\": {{ final_price_color  | json }},\n\t\"showVariantTitle\": {{ show_variant_title | json }},\n\n\t\"showSavingsBadge\": {{ show_savings_badge | json }},\n\t\"savingsBadgeColor\":{{ savings_badge_color  | json }}\n\t}\n</script>\n\n\n\n{% endraw %}",
                            "copy_button": true,
                            "show_pathname": true,
                            "pathname": "snippets/kuu-cartdrawer.liquid",
