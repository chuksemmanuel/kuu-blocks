                },
                "kuu_codeblock_TaMfXA": {
                  "type": "kuu-codeblock",
                  "name": "Code Block",
                  "settings": {
                    "language": "liquid",
                    "content": "",
                    "liquid_code": "{% raw %}\n{%\n\trender 'kuu-cartdrawer'\n\t, id: 'cartdrawer',\n\t, sticky_header: block.settings.sticky_header\n\t, sticky_footer: block.settings.sticky_footer\n\t, show_compare_price: block.settings.show_compare_price\n\t, final_price_color: block.settings.final_price_color\n\t, show_savings_badge: block.settings.show_savings_badge\n\t, savings_badge_color: block.settings.savings_badge_color\n\t, show_variant_title: block.settings.show_variant_title\n\t, show_secondary_footer_cta: block.settings.show_secondary_footer_cta\n\t, secondary_footer_cta_label: block.settings.secondary_footer_cta_label\n\t, secondary_footer_cta_link: block.settings.secondary_footer_cta_link\n\t, show_checkout_lock_icon: block.settings.show_checkout_lock_icon\n\t, checkout_button_label: block.settings.checkout_button_label,\n\t, section_id: section.id\n%}\n\n{% schema %}\n\t{\n\t\t\"name\": \"Cart Drawer\",\n\t\t\"settings\": [\n\t\t\t{\n\t\t\t\t\"type\": \"header\",\n\t\t\t\t\"content\": \"Layout\"\n\t\t\t},\n\t\t\t{\n\t\t\t\t\"type\": \"checkbox\",\n\t\t\t\t\"id\": \"sticky_header\",\n\t\t\t\t\"label\": \"Enable sticky header\",\n\t\t\t\t\"default\": true\n\t\t\t},\n\t\t\t{\n\t\t\t\t\"type\": \"checkbox\",\n\t\t\t\t\"id\": \"sticky_footer\",\n\t\t\t\t\"label\": \"Enable sticky footer\",\n\t\t\t\t\"default\": true\n\t\t\t},\n\n\t\t\t{\n\t\t\t\t\"type\": \"header\",\n\t\t\t\t\"content\": \"Cart Items\"\n\t\t\t},\n\t\t\t{\n\t\t\t\t\"type\": \"checkbox\",\n\t\t\t\t\"id\": \"show_variant_title\",\n\t\t\t\t\"label\": \"Show variant title\",\n\t\t\t\t\"default\": true\n\t\t\t},\n\t\t\t{\n\t\t\t\t\"type\": \"checkbox\",\n\t\t\t\t\"id\": \"show_compare_price\",\n\t\t\t\t\"label\": \"Show compare-at price\",\n\t\t\t\t\"default\": false\n\t\t\t},\n\t\t\t{\n\t\t\t\t\"type\": \"color\",\n\t\t\t\t\"id\": \"final_price_color\",\n\t\t\t\t\"label\": \"Final price color\",\n\t\t\t\t\"default\": \"#fb2c36\",\n\t\t\t\t\"visible_if\": \"{{ section.settings.show_compare_price == true }}\"\n\t\t\t},\n\n\t\t\t{\n\t\t\t\t\"type\": \"checkbox\",\n\t\t\t\t\"id\": \"show_savings_badge\",\n\t\t\t\t\"label\": \"Show savings badge\",\n\t\t\t\t\"default\": false,\n\t\t\t\t\"visible_if\": \"{{ section.settings.show_compare_price == true }}\"\n\t\t\t},\n\t\t\t{\n\t\t\t\t\"type\": \"color\",\n\t\t\t\t\"id\": \"savings_badge_color\",\n\t\t\t\t\"label\": \"Savings badge color\",\n\t\t\t\t\"default\": \"#fb2c36\",\n\t\t\t\t\"visible_if\": \"{{ section.settings.show_savings_badge == true }}\"\n\t\t\t},\n\n\t\t\t{\n\t\t\t\t\"type\": \"header\",\n\t\t\t\t\"content\": \"Cart Drawer Footer\"\n\t\t\t},\n\t\t\t{\n\t\t\t\t\"type\": \"checkbox\",\n\t\t\t\t\"id\": \"show_checkout_lock_icon\",\n\t\t\t\t\"label\": \"Show lock icon\",\n\t\t\t\t\"default\": true\n\t\t\t},\n\t\t\t{\n\t\t\t\t\"type\": \"text\",\n\t\t\t\t\"id\": \"checkout_button_label\",\n\t\t\t\t\"label\": \"Checkout button label\",\n\t\t\t\t\"default\": \"Proceed to Checkout\"\n\t\t\t},\n\t\t\t{\n\t\t\t\t\"type\": \"checkbox\",\n\t\t\t\t\"id\": \"show_secondary_footer_cta\",\n\t\t\t\t\"label\": \"Show secondary button\",\n\t\t\t\t\"default\": true\n\t\t\t},\n\t\t\t{\n\t\t\t\t\"type\": \"text\",\n\t\t\t\t\"id\": \"secondary_footer_cta_label\",\n\t\t\t\t\"label\": \"Secondary button label\",\n\t\t\t\t\"default\": \"Continue Shopping\",\n\t\t\t\t\"visible_if\": \"{{ section.settings.show_secondary_footer_cta == true }}\"\n\t\t\t},\n\t\t\t{\n\t\t\t\t\"type\": \"select\",\n\t\t\t\t\"id\": \"secondary_footer_cta_action\",\n\t\t\t\t\"label\": \"Secondary button action\",\n\t\t\t\t\"options\": [\n\t\t\t\t\t{\n\t\t\t\t\t\t\"value\": \"close-drawer\",\n\t\t\t\t\t\t\"label\": \"Close Drawer\"\n\t\t\t\t\t},\n\t\t\t\t\t{\n\t\t\t\t\t\t\"value\": \"open-link\",\n\t\t\t\t\t\t\"label\": \"Open link\"\n\t\t\t\t\t}\n\t\t\t\t],\n\t\t\t\t\"default\": \"close-drawer\",\n\t\t\t\t\"visible_if\": \"{{ section.settings.show_secondary_footer_cta == true }}\"\n\t\t\t},\n\t\t\t{\n\t\t\t\t\"type\": \"url\",\n\t\t\t\t\"id\": \"secondary_footer_cta_link\",\n\t\t\t\t\"label\": \"Secondary button link\",\n\t\t\t\t\"default\": \"/\",\n\t\t\t\t\"visible_if\": \"{{ section.settings.secondary_footer_cta_action == 'open-link' }}\"\n\t\t\t}\n\t\t],\n\t\t\"presets\": [\n\t\t\t{\n\t\t\t\t\"name\": \"Cart Drawer\"\n\t\t\t}\n\t\t]\n\t}\n{% endschema %}\n\n{% endraw %}",
