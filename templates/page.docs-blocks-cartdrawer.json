                    },
                    "kuu_tab_item_7M6qcy": {
                      "type": "_kuu-tab-item",
                      "name": "kuu-cartdrawer-items",
                      "settings": {
                        "tab_title": "Cartdrawer Items"
                      },
                      "blocks": {
                        "kuu_codeblock_ahjMad": {
                          "type": "kuu-codeblock",
                          "name": "Code Block",
                          "settings": {
                            "language": "liquid",
                            "content": "",
                            "liquid_code": "{% raw %}\n<ul\n\tclass='flex flex-col gap-4 lg:gap-6'\n\tid='cartdrawer-content'\n\taria-label='cart items'\n>\n\t{% for item in cart.items %}\n\t\t<li\n\t\t\taria-labelledby='cart-item-{{ item.key }}-title'\n\t\t\tdata-product-id='{{ item.product.id }}'\n\t\t\tdata-variant-id='{{item.variant.id}}'\n\t\t\tdata-line='{{item.id}}'\n\t\t\tkey='{{ item.key }}'\n\t\t\taria-label='{{product.title}}'\n\t\t\tclass='focus:outline-none '\n\t\t\ttabindex='-1'\n\t\t>\n\t\t\t<div\n\t\t\t\tclass='group relative flex justify-between gap-5 px-5 lg:px-8'\n\t\t\t\tx-id=\"['{{ item.key }}']\"\n\t\t\t\t:class=\"{ 'opacity-95 pointer-events-none': updatingKey === '{{ item.key }}' }\"\n\t\t\t>\n\t\t\t\t<!-- LEFT SIDE: IMAGE + DETAILS -->\n\t\t\t\t<div class='flex  gap-5'>\n\t\t\t\t\t<!-- Product image -->\n\t\t\t\t\t<a\n\t\t\t\t\t\thref='{{item.product.url}}'\n\t\t\t\t\t\taria-labelledby='cart-item-{{ item.key }}-title'\n\t\t\t\t\t\tclass='block size-20 shrink-0 overflow-hidden rounded  bg-gray-200'\n\t\t\t\t\t>\n\t\t\t\t\t\t<img\n\t\t\t\t\t\t\tsrc='{{ item.image | image_url: width: 200 }}'\n\t\t\t\t\t\t\talt='{{ item.title | escape }}'\n\t\t\t\t\t\t\tclass='h-full w-full object-cover'\n\t\t\t\t\t\t\twidth='80px'\n\t\t\t\t\t\t\theight='80px'\n\t\t\t\t\t\t\taria-hidden='true'\n\t\t\t\t\t\t>\n\t\t\t\t\t</a>\n\n\t\t\t\t\t<!-- Product details -->\n\t\t\t\t\t<div class=' flex flex-col gap-1'>\n\t\t\t\t\t\t<!-- Product Title -->\n\t\t\t\t\t\t<a\n\t\t\t\t\t\t\tid='cart-item-{{ item.key }}-title'\n\t\t\t\t\t\t\thref='{{item.product.url}}'\n\t\t\t\t\t\t\tclass='reversed-link line-clamp-2 max-w-50 font-semibold'\n\t\t\t\t\t\t>\n\t\t\t\t\t\t\t{{- item.title -}}\n\t\t\t\t\t\t</a>\n\n\t\t\t\t\t\t<!-- Price -->\n\n\t\t\t\t\t\t<template x-if='settings.showComparePrice'>\n\t\t\t\t\t\t\t{% if item.original_line_price != item.final_line_price %}\n\t\t\t\t\t\t\t\t<div\n\t\t\t\t\t\t\t\t\tclass='flex flex-col flex-wrap gap-x-1 gap-y-px md:flex-row md:items-center'\n\t\t\t\t\t\t\t\t\t:class=\"updatingKey == '{{item.key}}' && 'animate-pulse'\"\n\t\t\t\t\t\t\t\t>\n\t\t\t\t\t\t\t\t\t<div class='flex  items-center gap-2'>\n\t\t\t\t\t\t\t\t\t\t<span class='sr-only'>Discounted price</span>\n\t\t\t\t\t\t\t\t\t\t<span style='color:{{final_price_color}}' :style='{color: settings.finalPriceColor}'>\n\t\t\t\t\t\t\t\t\t\t\t{{- item.final_line_price | money -}}\n\t\t\t\t\t\t\t\t\t\t</span>\n\n\t\t\t\t\t\t\t\t\t\t<span class='sr-only'>Original price</span>\n\t\t\t\t\t\t\t\t\t\t<span class='text-gray-500 line-through'>\n\t\t\t\t\t\t\t\t\t\t\t{{ item.original_line_price | money }}\n\t\t\t\t\t\t\t\t\t\t</span>\n\t\t\t\t\t\t\t\t\t</div>\n\n\t\t\t\t\t\t\t\t\t<template x-if='settings.showSavingsBadge'>\n\t\t\t\t\t\t\t\t\t\t<span\n\t\t\t\t\t\t\t\t\t\t\tclass='w-fit shrink-0 rounded-md  px-1.5 py-px text-xs'\n\t\t\t\t\t\t\t\t\t\t\t:style='{background:settings.savingsBadgeColor, color:_getContrastColor(settings.savingsBadgeColor)}'\n\t\t\t\t\t\t\t\t\t\t\tdata-savings-badge\n\t\t\t\t\t\t\t\t\t\t>\n\t\t\t\t\t\t\t\t\t\t\tSaved {{ item.original_line_price | minus: item.final_line_price | money }}\n\t\t\t\t\t\t\t\t\t\t</span>\n\t\t\t\t\t\t\t\t\t</template>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t{% else %}\n\t\t\t\t\t\t\t\t<span :class=\"updatingKey == '{{item.key}}' && 'animate-pulse'\">\n\t\t\t\t\t\t\t\t\t{{- item.final_line_price | money -}}\n\t\t\t\t\t\t\t\t</span>\n\t\t\t\t\t\t\t{% endif %}\n\t\t\t\t\t\t</template>\n\n\t\t\t\t\t\t<template x-if='!settings.showComparePrice'>\n\t\t\t\t\t\t\t<span :class=\"updatingKey == '{{item.key}}' && 'animate-pulse'\">{{ item.final_line_price | money }}</span>\n\t\t\t\t\t\t</template>\n\n\t\t\t\t\t\t<!-- Variant options (Color: Red, Size: M, etc.) -->\n\t\t\t\t\t\t<template x-if='settings.showVariantTitle'>\n\t\t\t\t\t\t\t{% if item.product.has_only_default_variant == false and item.item_components.size == 0 %}\n\t\t\t\t\t\t\t\t<span class='max-w-30 text-xs text-gray-500' aria-hidden='true'>{{ item.variant.title }}</span>\n\n\t\t\t\t\t\t\t\t{% for option in item.options_with_values %}\n\t\t\t\t\t\t\t\t\t<span class='sr-only'> {{ option.name }}: {{ option.value }} </span>\n\t\t\t\t\t\t\t\t{% endfor %}\n\t\t\t\t\t\t\t{% endif %}\n\t\t\t\t\t\t</template>\n\n\t\t\t\t\t\t<!-- Error Messages -->\n\t\t\t\t\t\t<template x-if=\"cartMessage && cartMessage.key === '{{ item.key }}'\">\n\t\t\t\t\t\t\t<div\n\t\t\t\t\t\t\t\tclass=' min-h-5 text-sm '\n\t\t\t\t\t\t\t\t:class=\"cartMessage.type === 'warning'? 'text-amber-500': cartMessage.type === 'success' ? 'text-green-500':'text-red-500'\"\n\t\t\t\t\t\t\t>\n\t\t\t\t\t\t\t\t<style>\n\t\t\t\t\t\t\t\t\t.cart-message-icon > svg {\n\t\t\t\t\t\t\t\t\t\twidth: 14px;\n\t\t\t\t\t\t\t\t\t\tdisplay: inline;\n\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t</style>\n\n\t\t\t\t\t\t\t\t<span class='cart-message-icon shrink-0' aria-hidden='true'>\n\t\t\t\t\t\t\t\t\t<template x-if=\"cartMessage.type === 'warning'\">\n\t\t\t\t\t\t\t\t\t\t{{ 'icons/circle-alert.svg' | inline_asset_content }}\n\t\t\t\t\t\t\t\t\t</template>\n\t\t\t\t\t\t\t\t\t<template x-if=\"cartMessage.type === 'success'\">\n\t\t\t\t\t\t\t\t\t\t{{ 'icons/circle-check.svg' | inline_asset_content }}\n\t\t\t\t\t\t\t\t\t</template>\n\t\t\t\t\t\t\t\t\t<template x-if=\"cartMessage.type === 'error'\">\n\t\t\t\t\t\t\t\t\t\t{{ 'icons/circle-x.svg' | inline_asset_content }}\n\t\t\t\t\t\t\t\t\t</template>\n\t\t\t\t\t\t\t\t</span>\n\t\t\t\t\t\t\t\t<span class='sr-only' x-text='cartMessage.type'></span>\n\t\t\t\t\t\t\t\t<span x-text='cartMessage.message' class='text-sm'></span>\n\t\t\t\t\t\t\t\t<button\n\t\t\t\t\t\t\t\t\t@click='clearCartMessage()'\n\t\t\t\t\t\t\t\t\tclass='ml-1 cursor-pointer underline'\n\t\t\t\t\t\t\t\t\ttitle='Click to clear error'\n\t\t\t\t\t\t\t\t>\n\t\t\t\t\t\t\t\t\tClear\n\t\t\t\t\t\t\t\t</button>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</template>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\n\t\t\t\t<!-- RIGHT SIDE: QUANTITY + REMOVE -->\n\t\t\t\t<div class='flex shrink-0 flex-col items-center justify-center gap-2'>\n\t\t\t\t\t<!-- Quantity control -->\n\t\t\t\t\t<div class='flex h-10 items-center justify-center overflow-hidden rounded border border-gray-200 p-px'>\n\t\t\t\t\t\t<label for='qty-{{ item.id }}' class='sr-only'>Quantity for {{ item.title }}</label>\n\t\t\t\t\t\t<input\n\t\t\t\t\t\t\tid='qty-{{ item.id }}'\n\t\t\t\t\t\t\tname='{{item.key}}'\n\t\t\t\t\t\t\ttype='text'\n\t\t\t\t\t\t\tvalue='{{ item.quantity }}'\n\t\t\t\t\t\t\tclass='w-12 appearance-none p-px text-center ring-0 outline-0'\n\t\t\t\t\t\t\t@change=\"onQuantityInput($event, '{{ item.key }}')\"\n\t\t\t\t\t\t\t@keyup=\"filterNumeric($event, '{{ item.key }}')\"\n\t\t\t\t\t\t>\n\n\t\t\t\t\t\t<div class='hidden flex-col items-center justify-center md:flex '>\n\t\t\t\t\t\t\t<button\n\t\t\t\t\t\t\t\tdata-qty-increase='{{ item.id }}'\n\t\t\t\t\t\t\t\taria-label='Increase quantity for {{ item.title }}'\n\t\t\t\t\t\t\t\tclass='flex size-5 items-center justify-center bg-gray-50 text-gray-400 transition duration-400 ease-out hover:bg-gray-200 hover:text-gray-700'\n\t\t\t\t\t\t\t\t@click=\"onQuantityClick('{{ item.key }}', Number($event.target.closest('[key]').querySelector('input').value) + 1)\"\n\t\t\t\t\t\t\t>\n\t\t\t\t\t\t\t\t{{ 'icons/chevron-up.svg' | inline_asset_content }}\n\t\t\t\t\t\t\t</button>\n\n\t\t\t\t\t\t\t<button\n\t\t\t\t\t\t\t\tdata-qty-decrease='{{ item.id }}'\n\t\t\t\t\t\t\t\taria-label='Decrease quantity for {{ item.title }}'\n\t\t\t\t\t\t\t\tclass='flex size-5 items-center justify-center bg-gray-50 text-gray-400 transition duration-400 ease-out hover:bg-gray-200 hover:text-gray-700 disabled:pointer-events-none disabled:opacity-50'\n\t\t\t\t\t\t\t\t@click=\"onQuantityClick('{{ item.key }}', Math.max(1, Number($event.target.closest('[key]').querySelector('input').value) - 1))\"\n\t\t\t\t\t\t\t\t{%- if item.quantity == 1 -%}\n\t\t\t\t\t\t\t\t\tdisabled\n\t\t\t\t\t\t\t\t{%- endif -%}\n\t\t\t\t\t\t\t>\n\t\t\t\t\t\t\t\t{{ 'icons/chevron-down.svg' | inline_asset_content }}\n\t\t\t\t\t\t\t</button>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\n\t\t\t\t\t<!-- Remove -->\n\t\t\t\t\t<button\n\t\t\t\t\t\tdata-qty-remove='{{ item.id }}'\n\t\t\t\t\t\taria-label='Remove {{ item.title }} from cart'\n\t\t\t\t\t\tx-show=\"updatingKey !== '{{ item.key }}'\"\n\t\t\t\t\t\tclass='h-5 text-right text-xs text-gray-500 underline hover:text-black'\n\t\t\t\t\t\t@click=\"updateQuantity('{{ item.key }}', 0)\"\n\t\t\t\t\t>\n\t\t\t\t\t\tRemove\n\t\t\t\t\t</button>\n\n\t\t\t\t\t<!-- Spinner for currently updating item -->\n\t\t\t\t\t<template x-if=\"updatingKey === '{{ item.key }}'\">\n\t\t\t\t\t\t<span\n\t\t\t\t\t\t\taria-hidden='true'\n\t\t\t\t\t\t\tclass=' flex size-5 animate-spin items-center justify-center self-end text-gray-500 transition ease-linear  [animation-duration:0.5s]'\n\t\t\t\t\t\t\t@click=\"updateQuantity('{{ item.key }}', 0)\"\n\t\t\t\t\t\t>\n\t\t\t\t\t\t\t{{ 'icons/loader-circle.svg' | inline_asset_content }}\n\t\t\t\t\t\t</span>\n\t\t\t\t\t</template>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</li>\n\t{% endfor %}\n</ul>\n\n\n{% endraw %}",
