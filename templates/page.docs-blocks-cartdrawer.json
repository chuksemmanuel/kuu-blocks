                    "kuu_tab_item_aPNHWJ": {
                      "type": "_kuu-tab-item",
                      "name": "kuu-cartdrawer-footer",
                      "settings": {
                        "tab_title": "Cartdrawer Footer"
                      },
                      "blocks": {
                        "kuu_codeblock_we8FAV": {
                          "type": "kuu-codeblock",
                          "name": "Code Block",
                          "settings": {
                            "language": "liquid",
                            "content": "",
                            "liquid_code": "{% raw %}\n{% # Cart Footer %}\n<div\n\tclass='flex min-h-24 shrink-0  flex-col justify-between border-t  border-gray-200 pb-4 md:pb-8 lg:min-h-35'\n\tid='cartdrawer-footer'\n>\n\t<div class='flex flex-col gap-4 lg:gap-6'>\n\t\t<!-- Total -->\n\t\t<div class='flex flex-col gap-1 px-4 pt-4 lg:px-8 lg:pt-6'>\n\t\t\t<div class='flex items-center justify-between'>\n\t\t\t\t<span class='font-medium lg:text-lg'>Total</span>\n\n\t\t\t\t<template x-if='settings.showComparePrice'>\n\t\t\t\t\t{% if cart.original_total_price > cart.total_price %}\n\t\t\t\t\t\t<div class='flex gap-2' :class=\"updatingKey && 'animate-pulse'\">\n\t\t\t\t\t\t\t<span\n\t\t\t\t\t\t\t\tclass='font-semibold lg:text-lg'\n\t\t\t\t\t\t\t\tstyle='color:{{final_price_color}}'\n\t\t\t\t\t\t\t\t:style='{color: settings.finalPriceColor}'\n\t\t\t\t\t\t\t>\n\t\t\t\t\t\t\t\t{{- cart.total_price | money -}}\n\t\t\t\t\t\t\t</span>\n\t\t\t\t\t\t\t<span class=' line-through lg:text-lg'>{{ cart.original_total_price | money }}</span>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t{% else %}\n\t\t\t\t\t\t<span class='font-semibold lg:text-lg' :class=\"updatingKey && 'animate-pulse'\">\n\t\t\t\t\t\t\t{{- cart.total_price | money -}}\n\t\t\t\t\t\t</span>\n\t\t\t\t\t{% endif %}\n\t\t\t\t</template>\n\n\t\t\t\t<template x-if='!settings.showComparePrice'>\n\t\t\t\t\t<span class='font-semibold lg:text-lg' :class=\"updatingKey && 'animate-pulse'\">\n\t\t\t\t\t\t{{- cart.total_price | money -}}\n\t\t\t\t\t</span>\n\t\t\t\t</template>\n\t\t\t</div>\n\t\t</div>\n\n\t\t<!-- CTA -->\n\t\t<div class='flex flex-col items-center justify-center gap-2 px-4 lg:gap-4 lg:px-8'>\n\t\t\t<div class='flex w-full items-center justify-center gap-4'>\n\t\t\t\t{% if show_secondary_footer_cta %}\n\t\t\t\t\t<div\n\t\t\t\t\t\tclass='hidden w-1/2 md:block'\n\t\t\t\t\t\t{% unless secondary_footer_cta_link %}\n\t\t\t\t\t\t\tdata-drawer-close\n\t\t\t\t\t\t{% endunless %}\n\t\t\t\t\t>\n\t\t\t\t\t\t{% render 'kuu-button',\n\t\t\t\t\t\t\tvariant: 'secondary',\n\t\t\t\t\t\t\tsize: 'lg',\n\t\t\t\t\t\t\tlabel: secondary_footer_cta_label,\n\t\t\t\t\t\t\thref: secondary_footer_cta_link,\n\t\t\t\t\t\t\tclass: 'w-full! rounded-full!'\n\t\t\t\t\t\t%}\n\t\t\t\t\t</div>\n\t\t\t\t{% endif %}\n\n\t\t\t\t{% if show_checkout_lock_icon %}\n\t\t\t\t\t{% assign icon = 'icons/lock-keyhole.svg' %}\n\t\t\t\t{% else %}\n\t\t\t\t\t{% assign icon = null %}\n\t\t\t\t{% endif %}\n\n\t\t\t\t{% render 'kuu-button',\n\t\t\t\t\tvariant: 'primary',\n\t\t\t\t\tsize: 'lg',\n\t\t\t\t\tlabel: checkout_button_label,\n\t\t\t\t\ticon: icon,\n\t\t\t\t\tclass: 'w-full! rounded-full!',\n\t\t\t\t\twrapper_class: 'w-full md:w-1/2',\n\t\t\t\t\talign: 'center',\n\t\t\t\t\thref: '/checkout'\n\t\t\t\t%}\n\t\t\t</div>\n\n\t\t\t{% if show_secondary_footer_cta %}\n\t\t\t\t{% if secondary_footer_cta_link %}\n\t\t\t\t\t<a class='cursor-pointer text-center underline md:hidden' href='{{secondary_footer_cta_link}}'>\n\t\t\t\t\t\t{{- secondary_footer_cta_label -}}\n\t\t\t\t\t</a>\n\t\t\t\t{% else %}\n\t\t\t\t\t<span class='cursor-pointer text-center underline md:hidden' data-drawer-close>\n\t\t\t\t\t\t{{- secondary_footer_cta_label -}}\n\t\t\t\t\t</span>\n\t\t\t\t{% endif %}\n\t\t\t{% endif %}\n\t\t</div>\n\t</div>\n</div>\n\n\n{% endraw %}",
