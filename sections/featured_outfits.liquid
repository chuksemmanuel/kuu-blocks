<div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-6 pb-6 lg:pb-12">
  {% render 'collection-card' height: '250'
    , width="415.33"
    , image: 'https://cdn.shopify.com/s/files/1/0628/4348/6291/files/Saa7186b0be5f405b8e9c33409226ad6dI.webp?height=250'
    , title: 'Cozy Jackets' class: 'h-60! md:h-[250px]!' %}
  {% render 'collection-card' height: '250'
    , width="415.33"
    , image: 'https://cdn.shopify.com/s/files/1/0628/4348/6291/files/S9b9a8bc0720a4ceca55d767b0a8666b3F.png?height=250'
    , title: ' Crew Necks' class: 'h-60! md:h-[250px]!' %}


  <div class="bg-white rounded-3xl w-full h-40 md:h-[250px] flex flex-col justify-center items-center gap-4">
    <p class="text-2xl text-center font-medium max-w-[200px]">
      Models wearing full outfits
    </p>

    {% render 'button'
      , variant: 'primary'
      , href: "/collections/all"
      , label: 'Explore more'
      , class: 'rounded-full!'
