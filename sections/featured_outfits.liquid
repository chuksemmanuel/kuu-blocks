<div class="grid grid-cols-3 gap-4 py-4">
  <a href="#" class="bg-gray-200 rounded-3xl w-full h-[250px] relative overflow-hidden flex justify-center items-center cursor-pointer group">
    <span class="relative z-50 text-white text-shadow-sm text-2xl">
      Cozy Jackets
    </span>


    <img
      src="https://cdn.shopify.com/s/files/1/0628/4348/6291/files/Saa7186b0be5f405b8e9c33409226ad6dI.webp?height=250"
      alt="Shirts"
      width="415.33"
      height="250"
      class="absolute inset-0 h-full w-full z-5 transition duration-300 ease-out group-hover:scale-105 group-active:scale-100">

    {% comment %} Overlay {% endcomment %}
    <div class="bg-black/5 absolute inset-0 h-full w-full z-10"></div>
  </a>
  <a href="#" class="bg-gray-200 rounded-3xl w-full h-[250px] relative overflow-hidden flex justify-center items-center cursor-pointer group">
    <span class="relative z-50 text-white text-shadow-sm text-2xl">
      Crew Necks
    </span>


    <img
      src="https://cdn.shopify.com/s/files/1/0628/4348/6291/files/S9b9a8bc0720a4ceca55d767b0a8666b3F.png?height=250"
      alt="Shirts"
      width="415.33"
      height="250"
      class="absolute  inset-0 h-full w-full z-5 transition duration-300 ease-out group-hover:scale-105 group-active:scale-100">

    {% comment %} Overlay {% endcomment %}
    <div class="bg-black/5 absolute inset-0 h-full w-full z-10"></div>
  </a>

  <div class="bg-white rounded-3xl w-full h-[250px] flex flex-col justify-center items-center gap-4">
    <p class="text-2xl text-center">
      Models wearing full outfits
    </p>

    {% render 'button'
      , variant: 'primary'
      , href: "/collections/all"
      , label: 'Explore more'
      , class: 'rounded-full!'
    %}
  </div>
</div>

{% schema %}
  {
    "name": "featured_outfits",
    "settings": []
  }
{% endschema %}