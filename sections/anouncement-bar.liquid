<style>
  .slide p {
    text-wrap: nowrap !important;
  }
</style>


{% # Always-on Features %}
<script type="module" src="{{ 'js/features/announcement-bar.js' | asset_url }}"></script>




<div
  class=" announcement-bar px-4 py-2 full-width w-full overflow-hidden"
  style="background-color: {{ section.settings.background_color }}; color: {{ section.settings.text_color }};"
  x-data="announcementBar($el)"
  x-init="init()"
  x-on:destroy.window="destroy()"
  >
  <div class="swiper mySwiper slider">
      <div class="swiper-wrapper  flex justify-center-safe items-center w-full">
        {% for block in section.blocks %}

          {% if block.type == 'announcement' %}
                  <div class="swiper-slide w-fit flex items-center justify-center shink-0 slide px-4">
            {{ block.settings.announcement_text }}
        
          </div>
          {% unless forloop.last %}
            <div class="swiper-slide w-fit flex items-center justify-center shink-0 slide px-4">
              <div class="size-2 rounded-full bg-white mx-4! shrink-0 hidden lg:block  "></div>
            </div>
            
          {% endunless %}
          {% endif %}
      
        {% endfor %}
    </div>
  </div>
</div>


{% schema %}
  {
    "name": "Announcement Bar",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "label": "Background Color",
        "default": "#fff"
      }, {
        "type": "color",
        "id": "text_color",
        "label": "Text Color",
        "default": "#000"
      }
    ],
    "blocks": [
      {
        "type": "announcement",
        "name": "announcement",
        "settings": [
          {
            "type": "richtext",
            "id": "announcement_text",
            "label": "Announcement Text",
            "default": "<p>Free shipping on orders over $50!</p>"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Announcement Bar",
        "category": "Header"
      }
    ]
  }
{% endschema %}
