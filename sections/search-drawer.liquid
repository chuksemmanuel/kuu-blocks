{%- if predictive_search.performed -%}
	<div id='predictive-search-results'>
		{%- if predictive_search.resources != blank -%}
			{% render 'searchdrawer-content',
				products: predictive_search.resources.products,
				collections: predictive_search.resources.collections,
				pages: predictive_search.resources.pages,
				terms: predictive_search.terms
			%}
			<h3>Products</h3>
			<ul>
				{%- for product in predictive_search.resources.products -%}
					<li>
						<a href='{{ product.url }}'>{{ product.title }}</a>
					</li>
				{%- endfor -%}
			</ul>
		{%- endif -%}
	</div>
{%- endif -%}
