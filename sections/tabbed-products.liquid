{% render 'tabbed-products', blocks: section.blocks, headless: true %}

{% schema %}
{
  "name": "Tabbed products",
  "settings": [],
  "blocks": [
    {
      "type": "product_item",
      "name": "product Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Item Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Item Title"
        },
        {
          "type": "url",
          "id": "href",
          "label": "Item Link"
        },
        {
          "type": "text",
          "id": "parent_tab",
          "label": "Parent Tab (must match tab title)"
        }
      ]
    },
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Tabbed products"
    }
  ]
}
{% endschema %}
