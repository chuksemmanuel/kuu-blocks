<header
  class="grid grid-cols-3 place-content-between w-full py-6"
>
  {% # Annoucement snippet for screen readers %}
  {% render 'announcement' %}

  {% content_for 'block', id: 'header-left', type: '_header-left' %}

  {% content_for 'block', id: 'header-center', type: '_header-center' %}

  {% content_for 'block', id: 'header-right', type: '_header-right' %}
</header>

<div class="flex gap-2">
  {% content_for 'block', id: 'hero-button-1', type: 'button',  radius: '10px', variant: 'primary', icon:'icons/shopping-cart.svg' %}

  {% content_for 'block', id: 'hero-button-2', type: 'button',  radius: '10px', variant: 'primary', icon:'icons/shopping-cart.svg' %}

  {% content_for 'block', id: 'hero-button-3', type: 'button', icon:"icons/shopping-cart.svg" , lucide_icon:'shopping-bag' %}

</div>

{% content_for 'block', id: 'hero-button-4', type: 'button',  radius: '100px', variant: 'primary', icon:'icons/cancel.svg', label:'Icon Label', icon_position: 'right' %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [],
  "blocks": [
    {
      "type": "_header-left"
    },
    {
      "type": "_header-center"
    },
    {
      "type": "_header-right"
    }
  ]
}
{% endschema %}
