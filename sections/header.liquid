<header
class="grid grid-cols-3 place-content-between w-full py-6">
  {% # Annoucement snippet for screen readers %}
  {% render 'announcement' %}

  <div class="flex items-center gap-2 shrink-0">
    {% render 'tabbed-menu'
      , section: section %}

    {% render 'searchdrawer-mobile' %}


    <h2 class="header__title uppercase font-medium text-2xl hidden md:block ">
      {{ shop.name | link_to: routes.root_url }}
    </h2>

  </div>


  <div class="flex items-center justify-center  shrink-0">
    <h2 class="header__title uppercase text-center font-medium text-lg md:text-2xl  md:hidden" aria-label="site logo">
      {{ shop.name | link_to: routes.root_url }}
    </h2>

    <ul aria-label="menu items" class=" justify-between gap-8 hidden md:flex font-medium">
      {% for link in section.settings.menu.links %}
        <li>
          {{ link.title | link_to: link.url }}
        </li>

      {% endfor %}
    </ul>
  </div>


  <div class="flex justify-end items-center  md:gap-16">


    <div class="flex gap-4">


      {% render 'searchdrawer-desktop' %}

      {% if shop.customer_accounts_enabled %}
        {% render 'button'
          , href: routes.account_url
          , variant: 'circled-icon'
          , size: 'none'
          , icon: 'icons/user.svg'
          , aria_label: 'Open Account'
        %}
      {% endif %}


      {% capture cart_button %}
        <span class="bg-primary flex justify-center items-center text-primary-foreground z-20 absolute rounded-full size-6 -top-2 -right-2 p-1 text-xs" data-cartdrawer-bubble>{{ cart.item_count }}</span>
        {{ 'icons/shopping-cart.svg' | inline_asset_content }}
      {% endcapture %}
      {% render 'button'
        , variant: 'circled-icon'
        , size: 'none'
        , content: cart_button
        , aria_label: 'Open Shopping cart'
        , props: 'x-data @click="$dispatch(`drawer:open`,{id:`cartdrawer`})"'
      %}


    </div>
  </div>

</header>


{% schema %}
  {
    "name": "t:general.header",
    "settings": [
      {
        "type": "link_list",
        "id": "menu",
        "label": "t:labels.menu"
      }
    ],
    "blocks": [
      {
        "type": "menu_item",
        "name": "Menu Item",
        "settings": [
          {
            "type": "image_picker",
            "id": "image",
            "label": "Item Image"
          },
          {
            "type": "text",
            "id": "title",
            "label": "Item Title"
          },
          {
            "type": "url",
            "id": "href",
            "label": "Item Link"
          },
          {
            "type": "text",
            "id": "parent_tab",
            "label": "Parent Tab (must match tab title)"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Tabbed Menu"
      }
    ]

  }
{% endschema %}