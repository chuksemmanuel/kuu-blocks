<div class="py-6 lg:py-12 flex flex-col gap-4 md:gap-6 lg:gap-12">
  {% render 'heading' tag: 'h2'
    , title: 'Our Category List'
    , align: 'left' %}

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 lg:gap-6">
    {% for i in (1..3) %}
      {% render 'collection-card' href: '#'
        , height: '460'
        , width="440"
        , image: 'https://cdn.shopify.com/s/files/1/0628/4348/6291/files/Saa7186b0be5f405b8e9c33409226ad6dI.webp?height=460'
        , title: 'Set Collection'
        , subtitle: '(35 items)'
        , position: 'bottom'
        , show_button: 'true'
        , class: 'max-md:h-60!  '
      %}
    {% endfor %}


  </div>
</div>


{% schema %}
  {
    "name": "featured_categories",
    "settings": []
  }
{% endschema %}