<div class='flex flex-col gap-4 py-6 md:gap-6 lg:gap-12 lg:py-12'>
	{% render 'heading', tag: 'h2', title: section.settings.heading_title, align: section.settings.heading_align %}

	<div class='grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3 lg:gap-6'>
		{% for block in section.blocks %}
			{% render 'collection-card',
				collection: block.settings.collection,
				image: block.settings.image,
				title: block.settings.title,
				href: block.settings.href,
				count: block.settings.count,
				height: '460',
				width: '440',
				class: 'h-[460px] max-md:h-60!',
				show_button: section.settings.show_button,
				show_count: section.settings.show_count,
				position: section.settings.position,
				block: block
			%}
		{% endfor %}
	</div>
</div>

{% schema %}
	{
		"name": "Featured Categories",
		"settings": [
			{
				"type": "text",
				"id": "heading_title",
				"label": "Section Heading",
				"default": "Our Category List"
			},
			{
				"type": "select",
				"id": "heading_align",
				"label": "Heading Alignment",
				"options": [
					{
						"value": "left",
						"label": "Left"
					},
					{
						"value": "center",
						"label": "Center"
					},
					{
						"value": "right",
						"label": "Right"
					}
				],
				"default": "left"
			},
			{
				"type": "checkbox",
				"id": "show_button",
				"label": "Show Button on All Cards",
				"default": true
			},
			{
				"type": "checkbox",
				"id": "show_count",
				"label": "Show Product Count on All Cards",
				"default": true
			},
			{
				"type": "select",
				"id": "position",
				"label": "Content Position on Cards",
				"options": [
					{
						"value": "center",
						"label": "Center"
					},
					{
						"value": "bottom",
						"label": "Bottom"
					}
				],
				"default": "bottom"
			}
		],
		"blocks": [
			{
				"type": "featured_category",
				"name": "Category Item",
				"settings": [
					{
						"type": "collection",
						"id": "collection",
						"label": "Choose Collection (optional)"
					},
					{
						"type": "image_picker",
						"id": "image",
						"label": "Custom Image (if no collection)"
					},
					{
						"type": "text",
						"id": "title",
						"label": "Custom Title (if no collection)"
					},
					{
						"type": "url",
						"id": "href",
						"label": "Custom Link (if no collection)"
					},
					{
						"type": "number",
						"id": "count",
						"label": "Number of items (optional)"
					}
				]
			}
		],
		"max_blocks": 6,
		"presets": [
			{
				"name": "Featured Categories",
				"category": "Home page",
				"blocks": [
					{
						"type": "featured_category"
					},
					{
						"type": "featured_category"
					},
					{
						"type": "featured_category"
					}
				]
			}
		]
	}
{% endschema %}
