{% capture featured_items_content %}
	<div class='grid   min-w-full shrink-0 grid-cols-3 gap-4 py-6 lg:py-12'>
	{% for block in section.blocks %}
		{% if block.type == 'featured_item' %}
			{% render 'collection-card',
				collection: block.settings.collection,
				image: block.settings.image,
				title: block.settings.title,
				href: block.settings.href,
				count: block.settings.count,
				height: '250',
				width: '415.33',
				class: 'h-60! lg:h-80! min-w-[280px] md:h-[250px]!',
				show_button: section.settings.show_button,
				show_count: section.settings.show_count,
				position: section.settings.position,
				block: block
			%}
		{% elsif block.type == 'cta_card' %}
			<div
				{{ block.shopify_attributes }}
				class='flex h-60! w-full shrink-0 flex-col items-center justify-center gap-4 rounded-3xl bg-white md:h-[250px] lg:h-80!'
			>
				<p class='max-w-[200px] text-center text-2xl font-medium'>
					{{ block.settings.cta_text }}
				</p>

				{% render 'button',
					variant: 'primary',
					href: block.settings.cta_link,
					label: block.settings.cta_label,
					class: 'rounded-full!'
				%}
			</div>
		{% endif %}
	{% endfor %}
	</div>
{% endcapture %}

<section>
	<span class='sr-only'>Our Top Categories</span>
	{% render 'horizontal-scroll', content: featured_items_content %}
</section>

{% schema %}
	{
		"name": "Featured",
		"settings": [
			{
				"type": "checkbox",
				"id": "show_button",
				"label": "Show Button on All Cards",
				"default": false
			},
			{
				"type": "checkbox",
				"id": "show_count",
				"label": "Show Product Count on All Cards",
				"default": true
			},
			{
				"type": "select",
				"id": "position",
				"label": "Content Position on Cards",
				"options": [
					{
						"value": "center",
						"label": "Center"
					},
					{
						"value": "bottom",
						"label": "Bottom"
					}
				],
				"default": "center"
			}
		],
		"blocks": [
			{
				"type": "featured_item",
				"name": "Featured Item",
				"settings": [
					{
						"type": "collection",
						"id": "collection",
						"label": "Choose Collection"
					},
					{
						"type": "header",
						"content": "Or manually Enter Collection data "
					},
					{
						"type": "image_picker",
						"id": "image",
						"label": "Custom Image (if no collection)"
					},
					{
						"type": "text",
						"id": "title",
						"label": "Custom Title (if no collection)"
					},
					{
						"type": "url",
						"id": "href",
						"label": "Custom Link (if no collection)"
					},
					{
						"type": "number",
						"id": "count",
						"label": "Number of items (optional)"
					}
				]
			},
			{
				"type": "cta_card",
				"name": "CTA Card",
				"settings": [
					{
						"type": "text",
						"id": "cta_text",
						"label": "CTA Text",
						"default": "Models wearing full outfits"
					},
					{
						"type": "url",
						"id": "cta_link",
						"label": "CTA Link",
						"default": "/collections/all"
					},
					{
						"type": "text",
						"id": "cta_label",
						"label": "CTA Button Label",
						"default": "Explore more"
					}
				]
			}
		],
		"max_blocks": 6,
		"presets": [
			{
				"name": "Featured Section",
				"category": "Home page",
				"blocks": [
					{
						"type": "featured_item"
					},
					{
						"type": "featured_item"
					},
					{
						"type": "featured_item"
					},
					{
						"type": "cta_card"
					}
				]
			}
		]
	}
{% endschema %}
