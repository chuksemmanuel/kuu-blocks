<div class="py-6 lg:py-12 flex flex-col gap-4 md:gap-6 lg:gap-12">
  {% render 'heading' tag: 'h2'
    , title: 'Our Products'
    , subheading: 'Recently Added Shirts!'
    , align: 'center' %}

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 lg:gap-6">

    {% for product in collections['all'].products limit: 8 %}
      {% render 'product-card' product: product
        , show_floating_cart: true %}
    {% endfor %}


  </div>
</div>
{% schema %}
  {
    "name": "Featured Products",
    "settings": []
  }
{% endschema %}