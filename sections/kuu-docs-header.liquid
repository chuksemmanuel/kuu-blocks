<div class='bg-background fixed top-0 left-0 z-30 w-full'>
	<header
		class='page-width-docs  grid h-full w-full grid-cols-3  place-content-between py-4 max-[1441px]:px-6  lg:py-6  '
	>
		{% # Annoucement snippet for screen readers %}
		{% render 'announcement' %}

		<!-- Header Left -->
		<div class='flex shrink-0 items-center gap-2'>
			{% capture menu_drawer_content %}
				<div class="w-full px-5 pb-5">
					{% render 'kuu-docs-menu' %}
				</div>
			{% endcapture %}
			{% content_for 'block',
				type: 'kuu-drawer',
				id: 'kuu-docs-mobile-menu-drawer',
				drawer_heading: 'Menu',
				panel_class: 'w-64!',
				overlay_class: 'bg-black/10!',
				trigger_class: 'md:hidden',
				content: menu_drawer_content
			%}
			{% content_for 'block', type: 'kuu-logo', id: 'kuu-docs-logo' %}
		</div>

		<!-- Header center -->
		<div class='flex items-center justify-center gap-2'>
			<ul aria-label='menu items' class=' hidden justify-between gap-8 font-medium md:flex'>
				{% for link in linklists['main-menu'].links limit: 5 %}
					<li>
						{{ link.title | link_to: link.url }}
					</li>
				{% endfor %}
			</ul>
		</div>

		<!-- Header Right -->
		<div class='flex items-center justify-end gap-2  md:gap-4'>
			{% content_for 'block', type: 'kuu-searchdrawer', id: 'kuu-docs-searchdrawer' %}
			{% content_for 'blocks' %}
		</div>
	</header>
</div>

{% schema %}
	{
		"name": "Kuu Docs Header",
		"settings": [],
		"blocks": [{ "type": "@theme" }, { "type": "@app" }]
	}
{% endschema %}
