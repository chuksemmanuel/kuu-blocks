{% assign selector = selector | default: '.kuu-md h2' %}

<aside
	class='full-width h-[calc(100svh-120px)] w-full shrink-0'
	x-data='docsScrollspy("{{ selector }}")'
>
	<div class='fixed flex h-[calc(100svh-120px)] w-[256px] overflow-y-auto rounded-lg py-5 '>
		<div x-show='headings.length > 0' x-cloak>
			<h4 class='mb-2 text-sm font-semibold uppercase'>On this page</h4>
			<ul class='flex flex-col gap-2 border-l border-gray-200'>
				<template x-for='heading in headings' :key='heading.id'>
					<li
						class='border-l hover:border-gray-400 hover:text-gray-900'
						:class="activeId === heading.id ? 'font-bold text-gray-900 border-gray-900' : 'text-gray-500 border-transparent'"
					>
						<a
							:href="'#' + heading.id"
							@click.prevent='scrollTo(heading.id)'
							class='-ml-px block py-1 transition-colors duration-200'
							:class="heading.tag === 'h3' ? 'pl-8 text-xs' : 'text-sm pl-4'"
							x-text='heading.text'
						></a>
					</li>
				</template>
			</ul>
		</div>
	</div>
</aside>

<script>
	document.addEventListener('alpine:init', () => {
		Alpine.data('docsScrollspy', (selector) => ({
			headings: [],
			activeId: null,
			init() {
				// Wait for content to render
				this.$nextTick(() => {
					this.scanHeadings();
					this.updateActive();
					window.addEventListener('scroll', this.updateActive.bind(this), { passive: true });
				});
			},
			scanHeadings() {
				const elements = document.querySelectorAll(`${selector}`);
				this.headings = Array.from(elements).map((el, index) => {
					// Ensure ID exists
					if (!el.id) {
						el.id =
							el.textContent
								.trim()
								.toLowerCase()
								.replace(/\s+/g, '-')
								.replace(/[^\w\-]+/g, '') + `-${index}` || `heading-${index}`;
					}

					// wrap text content in a tag and prevent default behavior
					el.innerHTML = `<a href="#${el.id}">${el.textContent.trim()}</a>`;

					// Prevent default anchor behavior to allow custom scroll
					const anchor = el.querySelector('a');
					if (anchor) {
						anchor.addEventListener('click', (e) => {
							e.preventDefault();
							this.scrollTo(el.id);
						});
					}

					return {
						tag: el.tagName.toLowerCase(),
						id: el.id,
						text: el.textContent.trim(),
						offset: el.offsetTop,
					};
				});

				console.log(this.headings);
			},
			updateActive() {
				const scrollY = window.scrollY;
				const offset = 150; // Offset to trigger activation before it hits the very top

				// Find the last heading that is above the offset line
				let active = null;
				for (const heading of this.headings) {
					const el = document.getElementById(heading.id);
					if (el && el.getBoundingClientRect().top < offset) {
						active = heading.id;
					}
				}
				this.activeId = active || (this.headings[0] ? this.headings[0].id : null);
			},
			scrollTo(id) {
				const el = document.getElementById(id);
				if (el) {
					const headerOffset = 100;
					const elementPosition = el.getBoundingClientRect().top;
					const offsetPosition = elementPosition + window.pageYOffset - headerOffset;

					window.scrollTo({
						top: offsetPosition,
						behavior: 'smooth',
					});

					// Update URL after scroll (use pushState to avoid page jump)
					history.pushState(null, null, `#${id}`);

					// Update active immediately
					this.activeId = id;
				}
			},
		}));
	});
</script>

<style>
	.kuu-docs-sidebar-scrollspy {
		max-width: 256px;
		margin-right: 10px;
		@media (max-width: 1280px) {
			display: none !important;
		}
	}
</style>

{% schema %}
	{
		"name": "Kuu Docs Sidebar",
		"class": "kuu-docs-sidebar-scrollspy",
		"settings": []
	}
{% endschema %}
