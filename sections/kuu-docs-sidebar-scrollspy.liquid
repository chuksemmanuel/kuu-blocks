{% assign attribute = attribute | default: 'data-doc-heading' %}

<aside
	class='full-width h-[calc(100svh-120px)] w-full shrink-0'
	x-data='docsScrollspy("{{ attribute }}")'
>
	<div class='fixed flex h-[calc(100svh-120px)] w-[256px] overflow-y-auto rounded-lg py-5 '>
		<div x-show='headings.length > 0' x-cloak>
			<h4 class='mb-2 text-sm font-semibold uppercase'>On this page</h4>
			<ul class='flex flex-col gap-2 border-l border-gray-200'>
				<template x-for='heading in headings' :key='heading.id'>
					<li>
						<a
							:href="'#' + heading.id"
							@click.prevent='scrollTo(heading.id)'
							class='-ml-px block border-l py-1 pl-4 text-sm transition-colors duration-200 hover:border-gray-400 hover:text-gray-900'
							:class="activeId === heading.id ? 'font-bold text-gray-900 border-gray-900' : 'text-gray-500 border-transparent'"
							x-text='heading.text'
						></a>
					</li>
				</template>
			</ul>
		</div>
	</div>
</aside>

<script>
	document.addEventListener('alpine:init', () => {
		Alpine.data('docsScrollspy', (attribute) => ({
			headings: [],
			activeId: null,
			init() {
				// Wait for content to render
				this.$nextTick(() => {
					this.scanHeadings();
					this.updateActive();
					window.addEventListener('scroll', this.updateActive.bind(this), { passive: true });
				});
			},
			scanHeadings() {
				const elements = document.querySelectorAll(`[${attribute}]`);
				this.headings = Array.from(elements).map((el, index) => {
					// Ensure ID exists
					if (!el.id) {
						el.id =
							el.textContent
								.trim()
								.toLowerCase()
								.replace(/\s+/g, '-')
								.replace(/[^\w\-]+/g, '') || `heading-${index}`;
					}
					return {
						id: el.id,
						text: el.textContent.trim(),
						offset: el.offsetTop,
					};
				});
			},
			updateActive() {
				const scrollY = window.scrollY;
				const offset = 150; // Offset to trigger activation before it hits the very top

				// Find the last heading that is above the offset line
				let active = null;
				for (const heading of this.headings) {
					const el = document.getElementById(heading.id);
					if (el && el.getBoundingClientRect().top < offset) {
						active = heading.id;
					}
				}
				this.activeId = active || (this.headings[0] ? this.headings[0].id : null);
			},
			scrollTo(id) {
				const el = document.getElementById(id);
				if (el) {
					const headerOffset = 100;
					const elementPosition = el.getBoundingClientRect().top;
					const offsetPosition = elementPosition + window.pageYOffset - headerOffset;

					window.scrollTo({
						top: offsetPosition,
						behavior: 'smooth',
					});

					// Update active immediately
					this.activeId = id;
				}
			},
		}));
	});
</script>

<style>
	.kuu-docs-sidebar-scrollspy {
		max-width: 256px;

		@media (max-width: 1280px) {
			display: none !important;
		}
	}
</style>

{% schema %}
	{
		"name": "Kuu Docs Sidebar",
		"class": "kuu-docs-sidebar-scrollspy",
		"settings": []
	}
{% endschema %}
