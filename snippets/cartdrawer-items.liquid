<div
  x-data="cartDrawer()"
  class="flex flex-col gap-4 lg:gap-6"
  id="cartdrawer-content">
  {% for item in cart.items %}
    <div
      class="flex gap-5 justify-between relative "
      x-id="['{{ item.key }}']"
      key="{{ item.key }}"
      :class="{ 'opacity-95 pointer-events-none': updatingKey === '{{ item.key }}' }">

      <div class="flex items-center gap-5">
        <!-- Cart Image -->
        <a href="{{item.product.url}}" class="block size-20 rounded bg-gray-200 overflow-hidden  shrink-0">
          <img
            src="{{ item.image | image_url: width: 200 }}"
            alt="{{ item.title | escape }}"
            class="w-full h-full object-cover"
            width="80px"
            height="80px" />
        </a>

        {% # Details %}
        <div class="flex flex-col gap-1">

          {% # Title %}
          <a href="{{item.product.url}}" class="font-semibold line-clamp-2 max-w-50">{{ item.title }}</a>

          {% # Price %}

          {% if item.original_line_price != item.final_line_price and show_compare_price == true %}
            <div class="flex flex-col md:flex-row md:items-center flex-wrap gap-x-1 gap-y-px">
              <div class="flex  gap-2 items-center">
                <span style="color:{{final_price_color}}">{{ item.final_line_price | money }}</span>
                <span class="line-through text-gray-500">
                  {{ item.original_line_price | money }}
                </span>
              </div>
              {% if show_savings_badge %}
                {% assign contrast = savings_badge_color | color_contrast: '#ffffff' %}
                {% if contrast < 3.1 %}
                  {% assign saving_badge_text_color = '#000000' %}
                {% else %}
                  {% assign saving_badge_text_color = '#ffffff' %}

                {% endif %}
                <span class="rounded-md px-1.5 py-px  text-xs w-fit shrink-0" style="background:{{savings_badge_color}}; color:{{saving_badge_text_color}}">Saved {{ item.original_line_price | minus: item.final_line_price | money }}</span>
              {% endif %}
            </div>
          {% else %}
            <span class="">{{ item.final_line_price | money }}</span>
          {% endif %}


          {% # Variant Title %}
          {% if item.product.has_only_default_variant == false and item.item_components.size == 0 and show_variant_title %}
            <span class="text-gray-500 text-xs max-w-30">{{ item.variant.title }}</span>
          {% endif %}

          {% # Error Message %}
          <template x-if="cartMessage && cartMessage.key === '{{ item.key }}'">
            <div class=" text-sm min-h-5 " :class="cartMessage.type === 'warning'? 'text-amber-500': cartMessage.type === 'success' ? 'text-green-500':'text-red-500'">
              <style>
                .cart-message-icon > svg {
                  width: 14px;
                  display: inline;
                }
              </style>
              <span class="shrink-0 cart-message-icon" x-show="cartMessage.type === 'warning'">
                {{ 'icons/circle-alert.svg' | inline_asset_content }}
              </span>
              <span class="shrink-0 cart-message-icon" x-show="cartMessage.type === 'success'">
                {{ 'icons/circle-check.svg' | inline_asset_content }}
              </span>
              <span class="shrink-0 cart-message-icon" x-show="cartMessage.type === 'error'">
                {{ 'icons/circle-x.svg' | inline_asset_content }}
              </span>
              <span x-text="cartMessage.message" class="text-sm"></span>
              <span
                @click="clearCartMessage()"
                class="underline cursor-pointer"
                title="Click to clear error">Clear</span>
            </div>
          </template>


        </div>
      </div>

      <!-- Quantity Controls -->
      <div class="flex flex-col justify-center items-center shrink-0 gap-2">
        <div class="border border-gray-200 rounded flex justify-center items-center p-px h-10 overflow-hidden">
          <input
            type="text"
            value="{{ item.quantity }}"
            class="w-12 text-center p-px ring-0 outline-0 appearance-none"
            @change="onQuantityInput($event, '{{ item.key }}')"
            @keyup="filterNumeric($event, '{{ item.key }}')" />

          <div class="hidden md:flex flex-col justify-center items-center ">
            <button class="bg-gray-50 transition ease-out duration-400 hover:bg-gray-200 text-gray-400 size-5 flex justify-center items-center hover:text-gray-700" @click="onQuantityClick('{{ item.key }}', Number($event.target.closest('[key]').querySelector('input').value) + 1)">
              {{ 'icons/chevron-up.svg' | inline_asset_content }}
            </button>

            <button
              class="bg-gray-50 transition ease-out duration-400 hover:bg-gray-200 text-gray-400 size-5 flex justify-center items-center hover:text-gray-700 disabled:opacity-50 disabled:pointer-events-none"
              @click="onQuantityClick('{{ item.key }}', Math.max(1, Number($event.target.closest('[key]').querySelector('input').value) - 1))"
              {%- if item.quantity == 1 -%}
              disabled
              {%- endif -%}>
              {{ 'icons/chevron-down.svg' | inline_asset_content }}
            </button>
          </div>
        </div>

        <button
          x-show="updatingKey !== '{{ item.key }}'"
          class="text-xs text-right underline text-gray-500 hover:text-black h-5"
          @click="updateQuantity('{{ item.key }}', 0)">
          Remove
        </button>

        <!-- Spinner for currently updating item -->
        <template x-if="updatingKey === '{{ item.key }}'">
          <button class=" text-gray-500 transition  animate-spin [animation-duration:0.5s] self-end  size-5" @click="updateQuantity('{{ item.key }}', 0)">
            {{ 'icons/loader-circle.svg' | inline_asset_content }}
          </button>
        </template>
      </div>
    </div>
  {% endfor %}
</div>

<script src="{{ 'js/blocks/cart-drawer.js' | asset_url }}" defer></script>