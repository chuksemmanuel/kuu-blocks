<div
  x-data="cartDrawer()"
  class="flex flex-col gap-4 lg:gap-6"
  id="cartdrawer-content">
  {% for item in cart.items %}
    <div
      class="flex gap-5 justify-between relative"
      x-id="['{{ item.key }}']"
      key="{{ item.key }}"
      :class="{ 'opacity-95 pointer-events-none': updatingKey === '{{ item.key }}' }">

      <div class="flex items-center gap-5">
        <!-- Cart Image -->
        <div class="size-20 rounded bg-gray-200 overflow-hidden border border-gray-200 shrink-0">
          <img
            src="{{ item.image | image_url: width: 200 }}"
            alt="{{ item.title | escape }}"
            class="w-full h-full object-cover"
            width="80px"
            height="80px" />
        </div>

        <!-- Cart Details -->
        <div class="flex flex-col gap-px">
          <span class="font-semibold line-clamp-2 max-w-50">{{ item.title }}</span>
          <span>{{ item.final_line_price | money }}</span>
        </div>
      </div>

      <!-- Quantity Controls -->
      <div class="flex flex-col justify-center items-center shrink-0 gap-2">
        <div class="border border-gray-200 rounded flex justify-center items-center p-px h-10">
          <input
            type="text"
            value="{{ item.quantity }}"
            class="w-12 text-center p-px ring-0 outline-0 appearance-none"
            @input="onQuantityInput($event, '{{ item.key }}')"
            @keyup="filterNumeric($event, '{{ item.key }}')" />

          <div class="flex flex-col justify-center items-center">
            <button class="size-5 flex justify-center items-center hover:text-gray-700" @click="onQuantityClick('{{ item.key }}', Number($event.target.closest('[key]').querySelector('input').value) + 1)">
              {{ 'icons/chevron-up.svg' | inline_asset_content }}
            </button>

            <button class="size-5 flex justify-center items-center hover:text-gray-700" @click="onQuantityClick('{{ item.key }}', Math.max(0, Number($event.target.closest('[key]').querySelector('input').value) - 1))">
              {{ 'icons/chevron-down.svg' | inline_asset_content }}
            </button>
          </div>
        </div>

        <button
          x-show="updatingKey !== '{{ item.key }}'"
          class="text-xs text-right underline text-gray-500 hover:text-black h-5"
          @click="updateQuantity('{{ item.key }}', 0)">
          Remove
        </button>

        <!-- Spinner for currently updating item -->
        <template x-if="updatingKey === '{{ item.key }}'">
          <button class=" text-gray-500 transition  animate-spin [animation-duration:0.5s] self-end  size-5" @click="updateQuantity('{{ item.key }}', 0)">
            {{ 'icons/loader-circle.svg' | inline_asset_content }}
          </button>
        </template>
      </div>
    </div>
  {% endfor %}
</div>

<script src="{{ 'js/features/cartdrawer/cart-drawer-items.js' | asset_url }}" defer></script>