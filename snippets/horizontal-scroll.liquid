{% assign id = id | default: 'scroll-x' %}

<div
	data-horizontal-scroll='{{id}}'
	{{ props }}
	class='no-scrollbar relative z-30 flex h-10 w-full shrink-0  items-center justify-center-safe gap-4 overflow-x-auto  overflow-y-hidden bg-white pl-5 text-gray-500 select-none'
	:class="!isDragging ? 'cursor-grap': 'cursor-grabbing'"
	x-data="
		{
		  isDragging: false,
		  startX: 0,
		  scrollLeft: 0,
		  init() {
		    $el.style.scrollBehavior = 'auto'; // Disable smooth scrolling for better drag fe$el
		  },
		  startDragging(e) {
		    this.isDragging = true;
		    this.startX = e.pageX - $el.offsetLeft;
		    this.scrollLeft = $el.scrollLeft;
		  },
		  stopDragging() {
		    this.isDragging = false;
		  },
		  drag(e) {
		    if (!this.isDragging) return;
		    e.preventDefault();
		    const x = e.pageX - $el.offsetLeft;
		    const walk = (x - this.startX) * 1.5; // Adjust multiplier for desired scroll speed
		    $el.scrollLeft = this.scrollLeft - walk;
		  },
		}
	"
	x-init='init()'
	@mousedown='startDragging'
	@mouseup='stopDragging'
	@mouseleave='stopDragging'
	@mousemove='drag'
>
	{{ content }}
</div>
