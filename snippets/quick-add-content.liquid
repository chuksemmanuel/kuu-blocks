{% liquid
  assign variant_to_use = product.selected_or_first_available_variant
  assign combined_listing_count = product.options_with_values | map: 'values' | map: 'product_url' | compact | size

  unless combined_listing_count > 0
    assign first_image = product.media.first
    assign variant_images = product.images | where: 'attached_to_variant?', true

    assign swatch_variant_picker = null
    for option in product.options_with_values
      assign swatch_count = option.values | map: 'swatch' | compact | size
      if swatch_count > 0
        assign swatch_variant_picker = option
        break
      endif
    endfor

    if swatch_variant_picker
      assign swatch_count = swatch_variant_picker.values | map: 'swatch' | compact | size

      if swatch_count == 1
        # Single swatch: use that variant
        assign variant_to_use = swatch_variant_picker.values.first.variant
      elsif swatch_count > 1
        if first_image and variant_images contains first_image
          # First image is a variant image - find which variant it belongs to
          for option_value in swatch_variant_picker.values
            if option_value.variant.featured_media.id == first_image.id
              assign variant_to_use = option_value.variant
              break
            endif
          endfor
        elsif variant_images.size == 0
          # No variants have images - use first swatch variant
          assign variant_to_use = swatch_variant_picker.values.first.variant
        endif
        # else: First image is NOT a variant image - keep default (selected_or_first_available_variant)
      endif

    endif
  endunless

  if variant_to_use.available
    assign can_add_to_cart = true
  else
    assign can_add_to_cart = false
  endif
%}


<div
  data-quick-add-form-id="{{product.id}}"
  x-data="quickAddForm{{product.id}}"
  id="quick-add-content"
  class="h-[460px]! flex flex-col w-full p-4 sm:p-6 bg-white rounded-md lg:rounded-lg  overflow-hidden shadow-lg ">


  <div class=" flex flex-col justify-between h-full gap-4 shrink-0 overflow-y-auto">

    {% # Product Info %}
    <div class="flex gap-6">
      {% # Image %}
      <a href="{{product.url}}" class="block size-20 rounded bg-gray-200 overflow-hidden  shrink-0">
        <img
          src="{{ variant_to_use.featured_image | image_url: width: 200 }}"
          :src="featuredImage"
          x-ref="image"
          alt="{{ product.title | escape }}"
          class="w-full h-full object-cover"
          width="80px"
          height="80px" />
      </a>

      <div class="flex flex-col gap-1">
        {% # Title %}
        <a href="{{product.url}}" class="font-semibold line-clamp-2 max-w-50">{{ product.title }}</a>


        {% # Price %}

        {% if variant_to_use.price != variant_to_use.compare_at_price %}
          <div class="flex flex-col md:flex-row md:items-center flex-wrap gap-x-1 gap-y-px">
            <div class="flex  gap-2 items-center">
              <span style="color:red">{{ variant_to_use.price | money }}</span>
              <span class="line-through text-gray-500">
                {{ variant_to_use.compare_at_price | money }}
              </span>
            </div>

          </div>
        {% else %}
          <span class="">{{ variant_to_use.price | money }}</span>
        {% endif %}
      </div>


    </div>


    <form action="" class="flex flex-col justify-between  gap-4 shrink-0">

      {% # Variant Selectors %}
      <div class="flex flex-col gap-8  justify-center items-center">

        {% for product_option_value in product.options_with_values %}
          {% assign option_name = product_option_value.name | downcase %}
          {% assign option_index = forloop.index0 %}


          {% # Variant Selector %}
          <div class="flex flex-col gap-2">
            {% # Variant label %}
            <div class="flex justify-center items-center gap-1">
              <label for="{{product_option_value.name}}" class="text-gray-600">{{ product_option_value.name }}:
              </label>

              <span>
                {% for option in variant_to_use.options %}
                  {% if forloop.index == product_option_value.position %}
                    {{ option }}
                  {% endif %}
                {% endfor %}
              </span>
            </div>


            {% # Variant picker %}
            {% if product_option_value.values[0].swatch %}
              {% # Swatch picker %}
              <div class=" flex items-center justify-center gap-4">
                {% for option_value in product_option_value.values %}
                  {% if variant_to_use.options[option_index] == option_value.name %}
                    {% assign is_selected = true %}
                  {% else %}
                    {% assign is_selected = false %}
                  {% endif %}

                  <input
                    type="radio"
                    name="{{product_option_value.name}}"
                    id="{{product.id}}-{{option_value.name}}"
                    value="{{option_value.name}}"
                    x-model="options.{{product_option_value.name}}.value"
                    {% if is_selected %}
                    checked
                    {% endif %} />
                  <label for="{{product.id}}-{{option_value.name}}">
                    {% if option_value.swatch.color %}
                      <div class="size-7 rounded-full" style="background:{{option_value.swatch.color}};}"></div>
                    {% else %}
                      <div class="size-7 rounded-full relative overflow-hidden">
                        <img
                          src="{{option_value.swatch.image |  image_url : width: 48}}"
                          alt="{{product.title | escape}}"
                          width="28"
                          height="28"
                          class="w-full h-full object-cover">
                      </div>
                    {% endif %}
                  </label>
                {% endfor %}
              </div>
            {% elsif option_name == 'size' %}
              {% # Size Picker %}
              <div class="flex gap-2 justify-center items-center flex-wrap">
                {% for option_value in product_option_value.values %}
                  {% if variant_to_use.options[option_index] == option_value.name %}
                    {% assign is_selected = true %}
                  {% else %}
                    {% assign is_selected = false %}
                  {% endif %}
                  <input
                    type="radio"
                    name="{{product_option_value.name}}"
                    id="{{product.id}}-{{option_value.name}}"
                    value="{{option_value.name}}"
                    x-model="options.{{product_option_value.name}}.value"
                    {% if is_selected %}
                    checked
                    {% endif %} />
                  <label for="{{product.id}}-{{option_value.name}}" class="shrink-0 flex justify-center items-center rounded-full px-3 py-1 w-fit min-w-[54px] border-2 border-gray-400 cursor-pointer hover:border-black transition">{{ option_value.name }}</label>
                {% endfor %}
              </div>
            {% else %}
              {% # Select Element %}
              <div class="relative w-full">

                <select
                  name="{{product_option_value.name}}"
                  class="shink-0 flex justify-center items-center rounded-full! px-3 py-1 w-fit min-w-[54px] border-2 border-gray-400 cursor-pointer hover:border-black transition outline-none ring-0 appearance-none"
                  x-model="options.{{product_option_value.name}}.value">
                  {% for option_value in product_option_value.values %}
                    {% if variant_to_use.options[option_index] == option_value.name %}
                      {% assign is_selected = true %}
                    {% else %}
                      {% assign is_selected = false %}
                    {% endif %}
                    <option
                      value="{{option_value.name}}"
                      {% if is_selected %}
                      selected
                      {% endif %}>{{ option_value.name }}</option>
                  {% endfor %}
                </select>

                <span class="absolute h-full top-0 right-2 flex flex-col justify-center items-center  ">
                  {{ 'icons/chevron-down.svg' | inline_asset_content }}
                </span>
              </div>
            {% endif %}


          </div>
        {% endfor %}

      </div>


      {% # Add to Cart Button %}
      <div class="shrink-0 w-full ">
        {% render 'add-to-cart-button'
          , id: product.first_available_variant.id
          , quantity: 1
          , button_variant: 'primary'
          , size: 'lg'
          , label: "Add to cart"
          , class: 'shadow-sm  '
        %}
      </div>


    </form>

    <div class="w-full h-60 bg-red-500 shrink-0 hidden"></div>

  </div>

</div>


<script>
  window.quickAddProducts =  window.quickAddProducts || {}
   

  window.quickAddProducts['{{product.id}}'] = {
    product:{{product | json}},
    combined_listing_count:{{combined_listing_count}},
    first_image:{{first_image |  json}},
    variant_images:{{variant_images | json}},
    variant_to_use:{{variant_to_use | json}},
    swatch_variant_picker:{{swatch_variant_picker.values | json}},
    can_add_to_cart:{{can_add_to_cart}}
  }

  console.clear()
          console.log({{product.options_with_values | json}})
          {% for product_option_value in product.options_with_values %}
                  console.log({{product_option_value.swatch | json}})
            {% endfor %}
        

  console.log(window.quickAddProducts)



  document.addEventListener('alpine:init', () => {
    const Alpine = window.Alpine
            console.clear()
    Alpine.data('quickAddForm{{product.id}}', () => ({
        productId:null,
        product:null,
        selectedVariant:null,
        options:{},
        featuredImage:null,
        $image:null,
        preloaded:false,
        init(){
           const {product,variant_to_use}  = window.quickAddProducts['{{product.id}}'] || {}
            this.product = product
            this.selectedVariant = variant_to_use
            this.featuredImage = this.getFeaturedImage()
            this.$image = this.$refs.image
            this.productId = this.$el.dataset.quickAddFormId

            console.log('this.productId ===>',this.productId)
            
            // Set Options
            for(let i = 0; i < this.product.options.length; i++){
                this.options[product.options[i]] = {
                    value:this.selectedVariant.options[i],
                    position:i
                }
            }

   

            


            // Watch for options changes
            this.$watch('options', () =>{
        
                const sortedOptions = Object.values(this.options).sort((a,b) => a.position - b.position).map(optionValue =>{
                    return optionValue.value
                })

                const newSelectedVariant = this.product.variants.find(variant => {
                    return variant.options.join(',') === sortedOptions.join(',')

                })

                this.selectedVariant = newSelectedVariant ?? this.selectedVariant
                let newFeaturedImage = this.getFeaturedImage(newSelectedVariant)

                if(this.featuredImage != newFeaturedImage){
                    this.featuredImage = newFeaturedImage
                    if(this.$image){
                        this.$image.src = this.featuredImage
                    }
                }

            })

            // Prelaod variant images on drawer open

            function preloadImages(e){
                console.log(this.$el)
                console.log(e.detail?.id,`quick-add-${this.productId}`,this.$el.dataset.quickAddFormId)
                if(e.detail?.id === `quick-add-${this.productId}`){
                    console.log('we should preload')
                }

                this.preloaded = true

            }
            window.addEventListener('drawer:opened', preloadImages)
            // Remove event listener after preload
            this.$watch('preloaded', () =>{
                if(this.preloaded == true){
                    console.log('removing event listner')
                    window.removeEventListener('drawer:opened',preloadImages)
                }
            })


        },
        getFeaturedImage(v){
            console.log('v ===>',v)
            const variant = v || this.selectedVariant
            console.log('variante ==>', variant?.featured_image?.src)
            return variant?.featured_image?.src || this.product?.featured_image || this.product.images[0]
        },
        
   
    }))

    
  });
</script>