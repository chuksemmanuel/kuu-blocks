{% capture menu_trigger %}
   {% render 'button'           
   , variant: 'white'
   , size: 'icon'
  , icon: 'icons/hamburger.svg'
   , class: "rounded-lg!"
   , aria_label: 'Open Menu' %}
{% endcapture %}

{% capture menu_content %}

     <div data-menu class="flex h-full w-full flex-1  flex-col overflow-hidden overflow-x-hidden  rounded-md bg-white shadow-lg lg:rounded-lg"  >
        <!-- Menu Header -->
        <div data-menu-header class="shrink-0"> 
          <div class=" flex items-center justify-between p-3 lg:p-5">
              <!-- Title -->
              <span id="drawer-title" class="text-lg font-semibold" aria-label="menu">Menu</span>

              <!-- Close button --> 
              {% render 'button', 
              icon:'icons/cancel.svg', 
              class:'rounded-full! size-6! p-0! ',
              props: 'data-drawer-close',
              aria_label:'Close Menu'
              %}
          </div>
      </div>

      <!-- Menu Content - displayed as a tab -->
      <div class="relative flex  flex-1 overflow-y-auto ">
        {% render 'tabbed-products', blocks:section.blocks %}
      </div>

  </div>
       
{% endcapture %}

{% render 'drawer', trigger: menu_trigger, content: menu_content, id: 'menu-drawer', from: 'left' %}

<script>
  setTimeout(() => {
    window.dispatchEvent(new CustomEvent('drawer:open', { detail: { id: 'menu-drawer' } }));
  }, 2000);
</script>
