{% comment %}
  Button Component (inspired by shadcn/ui)
  Supports dynamic attributes like onclick, id, aria-label, etc.
  Usage Examples:
  1️⃣ Basic:
  {% render 'button', label: 'Add to cart' %}

  2️⃣ With icon and href:
  {% render 'button',
  href: routes.account_url,
  variant: 'primary',
  size: 'icon',
  class: 'rounded-full',
  icon: 'icon-account.svg',
  label: 'Account',
  onclick: 'toggleCartDrawer()',
  id: 'add-to-cart-btn'
  %}

  3️⃣ With custom inner content override:
  {% capture cart_content %}
  {% if cart.item_count > 0 %}
  <sup>{{ cart.item_count }}</sup>
  {% endif %}

  {{ 'icon-cart.svg' | inline_asset_content }}
  {% endcapture %}
  {% render 'button'
  , href: routes.cart_url
  , size: 'icon'
  , content: cart_content
  , class: 'bg-white text-black hover:text-white!' %}
{% endcomment %}

{% capture inline_styles %}
  {% if width %}
    --width: {{width}};
  {% endif %}
    
  {% if radius %}
    --border-radius:{{radius}};
  {% endif %}

  {% if padding_top %}
    --padding-top:{{padding_top}};
  {% endif %}
  

  {% if padding_bottom %}
    --padding-bottom:{{padding_bottom}};
  {% endif %}

  {% if padding_left %}
    --padding-left:{{padding_left}};
  {% endif %}

  {% if padding_right %}
    --padding-right:{{padding_right}};
  {% endif %}

  {%- case size -%}
    {%- when 'sm' -%}
      height:'32px';
    
    {%- when 'lg' -%}
      height:'48px';
    
    {%- when 'icon' -%}
      height:'48px';

    {%- when 'none' -%}
      
    {%- else -%}
    height:'40px';
      
  {%- endcase -%}

{% endcapture %}

{%- assign base_class = 'button relative inline-flex items-center justify-center font-medium transition-colors focus:outline-none  disabled:opacity-50 disabled:pointer-events-none ' -%}

{%- case variant -%}
  {%- when 'primary' -%}
    {%- assign variant_class = 'bg-primary text-primary-foreground hover:bg-primary/90' -%}
  {%- when 'secondary' -%}
    {%- assign variant_class = 'bg-gray-100 text-gray-900 hover:bg-gray-200' -%}
  {%- when 'outline' -%}
    {%- assign variant_class = 'border border-gray-300 text-gray-900 hover:bg-gray-50' -%}
  {%- when 'ghost' -%}
    {%- assign variant_class = 'bg-transparent hover:bg-gray-100' -%}
  {% when 'white' %}
    {% assign variant_class = 'bg-white text-black hover:bg-primary hover:text-primary-foreground ' %}
  {%- else -%}
    {%- assign variant_class = '' -%}
{%- endcase -%}


{%# Use icon size if no label %}
{% if label == blank and size == blank %}
  {% assign size = 'icon' %}
{% endif %}

{%- case size -%}
  {%- when 'sm' -%}
    {%- assign size_class = 'h-8 px-3 text-sm ' -%}
  {%- when 'lg' -%}
    {%- assign size_class = 'h-12 px-6 text-base' -%}
  {%- when 'icon' -%}
    {%- assign size_class = 'p-2 size-12' -%}
  {%- when 'none' -%}
    {%- assign size_class = '' -%}
  {%- else -%}
     {%- assign size_class = 'h-10 px-4 text-sm rounded-md' -%}
{%- endcase -%}
  


{%- assign classes = base_class | append: ' ' | append: variant_class | append: ' ' | append: size_class | append: ' ' | append: class
-%}

{% capture loading_spinner %}
  <span aria-hidden="true" class="animate-spin">{{ 'icons/loader-circle.svg' | inline_asset_content }}</span>
{% endcapture %}

{% capture icon %}
  {% if lucide_icon %}
     <i data-lucide="{{lucide_icon}}"></i>
     {% elsif icon %}
       {{ icon | inline_asset_content }}
  {% endif %}
{% endcapture %}

{%- capture default_content -%}
  <span aria-hidden="true" class="flex items-center {% if label %}gap-2{% endif %}">

  {% if loading %}
    {{loading_spinner}}
  {% else %}
    {{icon}}
  {% endif %}

  {%- if label -%}
        <span>{{ label }}</span>
    {%- endif -%}
   
  </span>
{%- endcapture -%}

{%- assign final_content = content | default: default_content -%}
{% assign aria_label = aria_label | default: label | default: null %}


<div class="flex shrink-0"
{% if align %}
    style="justify-content:{{align}}";
{% endif %}
>


{%- if href -%}
  <a
    href="{{ href }}"
    class="{{ classes }}"
    {% if id %}
    id="{{ id }}"
    {% endif %}
    {% if onclick %}
    onclick="{{ onclick }}"
    {% endif %}
    {% if aria_label %}
    aria-label="{{ aria_label }}"
    {% endif %}
    {% if props %}
    {{ props }}
    {% endif %}
    {% if radius %}
    style="{{inline_styles |  escape}}"
    {% endif %}>
    {{ final_content }}
  </a>
{%- else -%}
  <button
    type="{{ type | default: 'button' }}"
    class="{{ classes }}"
    {% if id %}
    id="{{ id }}"
    {% endif %}
    {% if onclick %}
    onclick="{{ onclick }}"
    {% endif %}
    {% if aria_label %}
    aria-label="{{ aria_label }}"
    {% endif %}
    {% if props %}
    {{ props }}
    {% endif %}
    {% if radius %}
    style="{{inline_styles |  escape}}"
    {% endif %}>
    {{ final_content }}
  </button>
{%- endif -%}

{% style %}

  .button{
    border-radius:var(--border-radius,8px)
  }

  .button svg {
    color: currentColor;
    shrink: 0 !important;
  }
{% endstyle %}

</div>