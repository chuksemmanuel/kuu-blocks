{% # if only icon is passed and no size or label props, set button size to icon %}
{% if label == blank and size == blank %}
  {% assign size = 'icon' %}
{% endif %}

{% capture inline_styles %}
  {% if width %}
    --width: {{width}};
  {% endif %}
  {% if mobile_width %}
    --mobile-width: {{mobile_width}};
  {% endif %}

  {% if height %}
    --height: {{height}};
  {% endif %}
  {% if mobile_height %}
    --mobile-height: {{mobile_height}};
  {% endif %}



  {% if radius %}
    --br:{{radius}};
  {% endif %}

  {% if padding_top %}
    --pt:{{padding_top}};
  {% endif %}
  

  {% if padding_bottom %}
    --pb:{{padding_bottom}};
  {% endif %}

  {% if padding_left %}
    --pl:{{padding_left}};
  {% endif %}

  {% if padding_right %}
    --pr:{{padding_right}};
  {% endif %}

  {%- case size -%}
    {%- when 'sm' -%}
      --fallback-height:32px;
      --fallback-pr:12px;
      --fallback-pl:12px;
    
    {%- when 'lg' -%}
      --fallback-height:48px;
      --fallback-pr:24px;
      --fallback-pl:24px;
    
    {%- when 'icon' -%}
      --fallback-width:48px;
      --fallback-height:48px;
      --fallback-pt:8px;
      --fallback-pb:8px;
      --fallback-pr:8px;
      --fallback-pl:8px;

    {%- when 'none' -%}
      
    {%- else -%}
      --fallback-height:40px;
      --fallback-pr:16px;
      --fallback-pl:16px;
      
  {%- endcase -%}

{% endcapture %}

{% if block.id != blank %}
  {% assign button_class = 'button' | append: block.id %}
{% endif %}

{%- assign base_class = 'button relative inline-flex items-center justify-center font-medium transition-colors focus:outline-none  disabled:opacity-50 disabled:pointer-events-none ' -%}

{%- case variant -%}
  {%- when 'primary' -%}
    {%- assign variant_class = 'bg-primary text-primary-foreground hover:bg-primary/90' -%}
  {%- when 'secondary' -%}
    {%- assign variant_class = 'bg-gray-100 text-gray-900 hover:bg-gray-200' -%}
  {%- when 'outline' -%}
    {%- assign variant_class = 'border border-primary text-gray-900 hover:bg-gray-50' -%}
  {%- when 'ghost' -%}
    {%- assign variant_class = 'bg-transparent hover:bg-gray-100' -%}
  {% when 'white' %}
    {% assign variant_class = 'bg-white text-black hover:bg-primary hover:text-primary-foreground ' %}
  {%- else -%}
    {%- assign variant_class = '' -%}
{%- endcase -%}

{%- case size -%}
  {%- when 'sm' -%}
    {%- assign size_class = 'h-8 px-3 text-sm ' -%}
  {%- when 'lg' -%}
    {%- assign size_class = 'h-12 px-6 text-base' -%}
  {%- when 'icon' -%}
    {%- assign size_class = 'p-2 size-12' -%}
  {%- when 'none' -%}
    {%- assign size_class = '' -%}
  {%- else -%}
    {%- assign size_class = 'h-10 px-4 text-sm rounded-md' -%}
{%- endcase -%}

{%- assign classes = button_class
  | append: ' '
  | append: base_class
  | append: ' '
  | append: variant_class
  | append: ' '
  | append: size_class
  | append: ' '
  | append: class
  | append: ' '
  | append: button_class
-%}

{% assign icon_position = icon_position | default: 'left' %}

{% capture loading_spinner %}
  <span aria-hidden="true" class="animate-spin">{{ 'icons/loader-circle.svg' | inline_asset_content }}</span>
{% endcapture %}

{% capture icon %}
  {% if lucide_icon %}
     <i data-lucide="{{lucide_icon}}"></i>
     {% elsif icon %}
       {{ icon | inline_asset_content }}
  {% endif %}
{% endcapture %}

{% capture icon_content %}
    {% if loading %}
    {{loading_spinner}}
  {% else %}
    {{icon}}
  {% endif %}
{% endcapture %}

{%- capture default_content -%}
  <span aria-hidden="true" class="flex items-center {% if label %}gap-2{% endif %}">

  {% if icon_position == 'left' %}
    {{icon_content}}
  {% endif %}

  {%- if label -%}
        <span>{{ label }}</span>
  {%- endif -%}

  {% if icon_position == 'right' %}
    {{icon_content}}
  {% endif %}
   
  </span>
{%- endcapture -%}

{%- assign final_content = content | default: default_content -%}
{% assign aria_label = aria_label | default: label | default: null %}
{% assign device = device | default: 'all' %}

{% if device == 'all' %}
  {% assign display_class = 'flex' %}
{% elsif device == 'mobile' %}
  {% assign display_class = 'flex md:hidden' %}
{% elsif device == 'desktop' %}
  {% assign display_class = 'hidden md:flex' %}
{% endif %}

<div
  class="{{display_class}} shrink-0 {{wrapper_class}}"
  {% if align %}
    style="justify-content:{{align}}";
  {% endif %}
>
  {% capture button_props %}
   class="{{ classes }}"
    {% if id %}
    id="{{ id }}"
    {% endif %}
    {% if onclick %}
    onclick="{{ onclick }}"
    {% endif %}
    {% if aria_label %}
    aria-label="{{ aria_label }}"
    {% endif %}
    {% if props %}
    {{ props }}
    {% endif %}
    style="{{inline_styles | strip}}"
     x-data
   
{% endcapture %}

  {%- if href -%}
    <a
      href="{{ href }}"
      {{ button_props }}
    >
      {{ final_content }}
    </a>
  {%- else -%}
    <button
      type="{{ type | default: 'button' }}"
      {{ button_props }}
    >
      {{ final_content }}
    </button>
  {%- endif -%}

  <style>
    {% if  mobile_width %}
    @media(max-width:768px){
      .button{
        width: var(--mobile-width, var(--fallback-width)) ;
      }
    }
    {% endif %}

    .{{button_class}}{

      width: var(--width, var(--fallback-width, auto));
      height:var(--height, var(--fallback-height, auto));
      border-radius: var(--br,0);
      padding-left: var(--pl, var(--fallback-pl, 0));
      padding-right: var(--pr, var(--fallback-pr, 0));
      padding-top: var(--pt, var(--fallback-pt, 0));
      padding-bottom: var(--pb, var(--fallback-pb, 0));

      @media (max-width:768px) {
      width: var(--mobile-width, var(--width, var(--fallback-width, auto)));
      height: var(--mobile-height, var(--height, var(--fallback-height, auto)));
      }
    }




    .button svg {
      color: currentColor;
      flex-shrink: 0 !important;
    }
  </style>
</div>
