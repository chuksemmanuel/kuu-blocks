{% comment %}
  Button Component (inspired by shadcn/ui)
  Supports dynamic attributes like onclick, id, aria-label, etc.
  Usage Examples:
  1️⃣ Basic:
  {% render 'button', label: 'Add to cart' %}

  2️⃣ With icon and href:
  {% render 'button',
  href: routes.account_url,
  variant: 'primary',
  size: 'icon',
  class: 'rounded-full',
  icon: 'icon-account.svg',
  label: 'Account',
  onclick: 'toggleCartDrawer()',
  id: 'add-to-cart-btn'
  %}

  3️⃣ With custom inner content override:
  {% capture cart_content %}
  {% if cart.item_count > 0 %}
  <sup>{{ cart.item_count }}</sup>
  {% endif %}

  {{ 'icon-cart.svg' | inline_asset_content }}
  {% endcapture %}
  {% render 'button'
  , href: routes.cart_url
  , size: 'icon'
  , content: cart_content
  , class: 'bg-white text-black hover:text-white!' %}
{% endcomment %}

{%- assign base_class = 'button relative inline-flex items-center justify-center font-medium transition-colors focus:outline-none  disabled:opacity-50 disabled:pointer-events-none ' -%}

{%- case variant -%}
  {%- when 'primary' -%}
    {%- assign variant_class = 'bg-primary text-primary-foreground hover:bg-primary/90' -%}
  {%- when 'secondary' -%}
    {%- assign variant_class = 'bg-gray-100 text-gray-900 hover:bg-gray-200' -%}
  {%- when 'outline' -%}
    {%- assign variant_class = 'border border-gray-300 text-gray-900 hover:bg-gray-50' -%}
  {%- when 'ghost' -%}
    {%- assign variant_class = 'bg-transparent hover:bg-gray-100' -%}
  {% when 'circled-icon' %}
    {% assign variant_class = 'bg-white text-black hover:bg-primary hover:text-primary-foreground  p-2 size-10  md:size-12  rounded-full' %}
  {%- else -%}
    {%- assign variant_class = '' -%}
{%- endcase -%}

{%- case size -%}
  {%- when 'sm' -%}
    {%- assign size_class = 'h-8 px-3 text-sm rounded-md' -%}
  {%- when 'lg' -%}
    {%- assign size_class = 'h-12 px-6 text-base rounded-lg' -%}
  {%- when 'icon' -%}
    {%- assign size_class = 'size-8 p-2 rounded-md' -%}
  {%- when 'none' -%}
    {%- assign size_class = '' -%}
  {%- else -%}
    {%- assign size_class = 'h-10 px-4 text-sm rounded-md' -%}
{%- endcase -%}

{%- assign classes = base_class | append: ' ' | append: variant_class | append: ' ' | append: size_class | append: ' ' | append: class -%}

{% capture loading_spinner %}
  <span class="animate-spin">{{ 'icons/loader-circle.svg' | inline_asset_content }}</span>
{% endcapture %}
{%- capture default_content -%}
  <span class="flex items-center {% if label %}gap-2{% endif %}">

  {% if loading %}
    {{loading_spinner}}
  {% else %}
    {%- if icon -%}
      {{ icon | inline_asset_content }}
    {%- endif -%}
  {% endif %}


 
  {%- if label -%}
        <span>{{ label }}</span>
    {%- endif -%}
   
  </span>
{%- endcapture -%}
{%- assign final_content = content | default: default_content -%}

{%- if href -%}
  <a
    href="{{ href }}"
    class="{{ classes }}"
    {% if id %}
    id="{{ id }}"
    {% endif %}
    {% if onclick %}
    onclick="{{ onclick }}"
    {% endif %}
    {% if aria_label %}
    aria-label="{{ aria_label }}"
    {% endif %}>
    {{ final_content }}
  </a>
{%- else -%}
  <button
    type="{{ type | default: 'button' }}"
    class="{{ classes }}"
    {% if id %}
    id="{{ id }}"
    {% endif %}
    {% if onclick %}
    onclick="{{ onclick }}"
    {% endif %}
    {% if aria_label %}
    aria-label="{{ aria_label }}"
    {% endif %}
    {% if props %}
    {{ props }}
    {% endif %}>
    {{ final_content }}
  </button>
{%- endif -%}

{% style %}
  .button svg {
    color: currentColor;
    shrink: 0 !important;
  }
{% endstyle %}