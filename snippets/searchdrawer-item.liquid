<a
  href="{{ item.url }}"
  key="{{ key }}"
  data-search-item="{{type}}"
  class="flex items-center gap-5 p-4 md:p-6 hover:bg-gray-100 transition duration-300 rounded-lg">
  {% if item.featured_image != blank %}
    <div class="block size-20 rounded bg-gray-200 overflow-hidden shrink-0">
      <img
        src="{{ item.featured_image | image_url: width: 200 }}"
        alt="{{ item.title }}"
        class="w-full h-full object-cover"
        width="80px"
        height="80px">
    </div>
  {% endif %}

  <div class="flex flex-col gap-1">
    <p class="font-semibold line-clamp-2 max-w-50">{{ item.title }}</p>
    {% if type == 'product' %}
      <span>{{ item.price | money }}</span>
    {% endif %}
    {% if type == 'collection' %}
      <span>
        {{ item.products_count }} product{% if item.products_count > 0 %}s{% endif %}
      </span>
    {% endif %}

  </div>
</a>