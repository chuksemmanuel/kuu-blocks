<a
	href='{{ item.url }}'
	key='{{ key }}'
	data-search-item='{{type}}'
	aria-label='{{ item.title }}'
	class='flex items-center gap-5 rounded-lg p-4 transition duration-300 hover:bg-gray-100 md:p-6'
>
	{% if item.featured_image != blank %}
		<div class='block size-20 shrink-0 overflow-hidden rounded bg-gray-200'>
			<img
				src='{{ item.featured_image | image_url: width: 200 }}'
				alt='{{ item.title }}'
				class='h-full w-full object-cover'
				width='80px'
				height='80px'
			>
		</div>
	{% endif %}

	<div class='flex flex-col gap-1'>
		<p class='line-clamp-2 max-w-60 font-semibold'>{{ item.title | highlight: terms }}</p>
		{% if type == 'product' %}
			<span>{{ item.price | money }}</span>
		{% endif %}
		{% if type == 'collection' %}
			<span>
				{{ item.products_count }} product{% if item.products_count > 0 %}s{% endif %}
			</span>
		{% endif %}
	</div>
</a>
