  {% capture tab_list %}
               {% for tab in tab_list %}
                <button
                  role="tab"
                  data-tab-trigger="{{tab}}"
                  :class="{ 'bg-primary text-primary-foreground' : isActive == '{{tab}}' }"
                  class="relative z-20 bg-gray-100 inline-flex items-center justify-center w-full h-10 px-3 text-sm font-medium transition duration-300 ease-out cursor-pointer whitespace-nowrap rounded-full">
                  {{ tab }}
                </button>
              {% endfor %}
        {% endcapture %}

        {% capture tab_contents %}
          {% for tab in tab_list %}
                  {% if tab != blank %}

                    <div 
            
                      x-show="isActive == '{{tab}}'"
                      x-transition:enter="transition ease-out duration-300 delay-300"
                      x-transition:enter-start="opacity-0"
                      x-transition:enter-end=" opacity-100"
                      x-transition:leave="transition ease-in duration-200 "
                      x-transition:leave-start="opacity-100"
                      x-transition:leave-end="opacity-0"
                      x-cloak
                      class="w-full flex flex-col  p-5"
                      :class="isActive == '{{tab}}' ? 'absolute left-0' : 'relative' "
                      role="tabpanel" aria-label="{{item.settings.parent_tab}} tab panel"
                      >
                      {% for item in section.blocks %}
                        {% if item.type == 'menu_item' and item.settings.parent_tab == tab %}
                          <a
                            aria-label="{{item.settings.title}}"
                            role="listitem"
                            href="{{ item.settings.href }}"
                            class="flex flex-col  gap-5  p-4 lg:p-6 hover:bg-gray-100 transition duration-300 rounded-lg"
                            {{ item.shopify_attributes }}>

                            <div class="flex items-center gap-5">
                              <div class="block size-20 rounded bg-gray-200 overflow-hidden  shrink-0"
                              {{ item.shopify_attributes }}>
                                <img
                                  src="{{ item.settings.image | image_url : width : 200 }}"
                                  alt="{{ item.settings.title }}"
                                  class="w-full h-full object-cover"
                                  width="80px"
                                  height="80px" />
                                
                              </div>
                          
                              <p class="text-lg">{{ item.settings.title }}</p>
                            </div>
                
                          </a>
                        {% endif %}
                      {% endfor %}
                    </div>

                  {% endif %}
                {% endfor %}
        {% endcapture %}

        {% render 'tab', triggers: tab_list, contents: tab_contents, id: 'tabbed-menu' %}