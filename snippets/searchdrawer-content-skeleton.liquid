{% comment %} Loading Skeleton {% endcomment %}
<div class="flex flex-col gap-4 md:gap-6 h-full overflow-hidden">
  {% # tab trigger %}
  <div class="relative flex gap-4 shrink-0 items-center z-30 overflow-hidden  text-gray-500 bg-white select-none overflow-x-auto w-full no-scrollbar h-6 md:h-7 ">
    <div class="div rounded bg-gray-200 animate-pulse h-6 md:h-7 w-30 shrink-0"></div>
    <div class="div rounded bg-gray-200 animate-pulse h-6 md:h-7 w-30 shrink-0"></div>
    <div class="div rounded bg-gray-200 animate-pulse h-6 md:h-7 w-30 shrink-0"></div>
    <div class="div rounded bg-gray-200 animate-pulse h-6 md:h-7 w-30 shrink-0"></div>
    <div class="div rounded bg-gray-200 animate-pulse h-6 md:h-7 w-30 shrink-0"></div>
  </div>

  {% # tab list %}

  <div class="flex flex-col flex-1 overflow-y-auto">
    {% for _ in (1..10) %}
      <div key="{{ forloop.index }}" class="flex items-center gap-5 pb-4 md:pb-6  ">

        <div class="block size-20 rounded bg-gray-200 overflow-hidden shrink-0 animate-pulse"></div>

        <div class="flex flex-col gap-2 w-full">
          <div class="div rounded bg-gray-200 animate-pulse h-3 w-[max(35%,120px)] shrink-0"></div>
          <div class="div rounded bg-gray-200 animate-pulse h-3 w-[max(70%,160px)] shrink-0"></div>
          <div class="div rounded bg-gray-200 animate-pulse h-3 w-[max(20%,80px)] shrink-0"></div>
        </div>
      </div>
    {% endfor %}

  </div>
</div>