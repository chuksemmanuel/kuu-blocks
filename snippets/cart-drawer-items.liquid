<!-- Cart Items -->
<div class="flex flex-col gap-4">
  <div class="flex gap-5 justify-between ">
    <div class="flex items-center gap-5">
      <!-- Cart Image -->
      <div class="size-20 rounded bg-gray-200"></div>

      <!-- Cart Details -->
      <div class="flex flex-col gap-px">
        <span class="font-semibold">Debloat</span>
        <span>N230.00</span>
      </div>
    </div>

    <div class="flex flex-col justify-center items-center shrink-0 gap-2">
      <div class=" border border-gray-200 rounded flex justify-center items-center p-px  h-10">
        <input
          type="text"
          value="999"
          class="w-12 text-center p-px ring-0 outline-0 appearance-none" />

        <!-- Quantity Controls -->
        <div class="flex flex-col justify-center items-center ">
          <button class="size-5 flex justify-center items-center">
            {{ 'icons/chevron-up.svg' | inline_asset_content }}
          </button>

          <button class="size-5 flex justify-center items-center">
            {{ 'icons/chevron-down.svg' | inline_asset_content }}
          </button>

        </div>
      </div>
      <span class="text-xs text-right underline">Remove</span>
    </div>
  </div>

</div>