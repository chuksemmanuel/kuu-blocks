{% comment %} Get TabList from Tab items by extracting and de-duplicating the parent_tab value {% endcomment %}
{% assign tabs = '' %}
{% for item in section.blocks %}
  {% if item.type == 'menu_item' %}
    {% assign current_tab = item.settings.parent_tab %}
    {% unless tabs contains current_tab %}
      {% assign tabs = tabs | append: current_tab | append: ',' %}
    {% endunless %}
  {% endif %}
{% endfor %}
{% assign tab_list = tabs | split: ',' %}
{% comment %} Get TabList from Tab items Ends {% endcomment %}

{% capture menu_trigger %}
   {% render 'button'           
   , variant: 'white'
   , size: 'icon'
  , icon: 'icons/hamburger.svg'
   , class: "rounded-lg!"
   , aria_label: 'Open Menu' %}
{% endcapture %}

{% capture menu_content %}

     <div data-menu class="flex h-full w-full flex-1  flex-col overflow-hidden overflow-x-hidden  rounded-md bg-white shadow-lg lg:rounded-lg"  >
        <!-- Menu Header -->
            <div data-menu-header class="shrink-0">
        <div class="mb-6 flex items-center justify-between p-5 lg:p-5">
          <!-- Menu Header - Title -->
           
             <div class="sr-only" id="drawer-title">Menu</div>
          <span class="text-lg font-semibold " aria-label="menu">Menu</span>

         <!-- Menu Header - Close button --> 
          {% render 'button', 
          icon:'icons/cancel.svg', 
          class:'rounded-full! size-6! p-0! ',
          props: 'data-drawer-close',
          aria_label:'Close Menu'
          %}
        </div>
      </div>

      <!-- Menu Content - displayed as a tab -->
      <div class="relative flex  flex-1 overflow-y-auto " >
        {%# Tag triggers buttons %}
        {% capture tab_button_list %}
          {% for tab in tab_list %}
            <button
              data-tab-trigger="{{tab}}"
              role="tab"
              aria-label="{{tab}}"
              :aria-selected="tabButtonActive($el)"
              aria-controls="{{ tab }}-content"
              :id="'{{ tab }}'"
              type="button"
              :class="{ 'bg-primary text-primary-foreground' : tabButtonActive($el) }"
              class="relative z-20 inline-flex h-10 w-full cursor-pointer items-center justify-center rounded-full bg-gray-100 px-3 text-sm font-medium whitespace-nowrap transition duration-300 ease-out">
              {{ tab }}
            </button>
          {% endfor %}
        {% endcapture %}

        {%# Tag triggers -  horizontally scrollable %}
        {% capture tab_triggers %}
         
            {% render 'horizontal-scroll', content: tab_button_list , id:'menu-tablist' props: '  
                  x-ref="tabButtons"
                  role="tablist"
                  aria-label="Collection tabs"
                ' %}
            
        {% endcapture %}

        {% capture tab_content %}
          {%# Menu/Tab Content  %}
            {% for tab in tab_list %}
              {% if tab != blank %}

                <div 
                  data-tab-content="{{tab}}" 
                  x-cloak
                  class="flex w-full flex-col  p-5"
                  :class="!tabContentActive($el) ? 'absolute left-0' : 'relative' "
                  role="tabpanel"
                  aria-label="{{item.settings.parent_tab}} tab panel"
                  >
                    {% for item in section.blocks %}
                      {% if item.type == 'menu_item' and item.settings.parent_tab == tab %}
                        <a
                          aria-label="{{item.settings.title}}"
                          role="listitem"
                          href="{{ item.settings.href }}"
                          class="flex flex-col  gap-5  rounded-lg p-4 transition duration-300 hover:bg-gray-100 lg:p-6"
                          {{ item.shopify_attributes }}>

                          <div class="flex items-center gap-5">
                            <div class="block size-20 shrink-0 overflow-hidden rounded  bg-gray-200"
                            {{ item.shopify_attributes }}>
                              <img
                                src="{{ item.settings.image | image_url : width : 200 }}"
                                alt="{{ item.settings.title }}"
                                class="h-full w-full object-cover"
                                width="80px"
                                height="80px" />
                              
                            </div>
                        
                            <p class="text-lg">{{ item.settings.title }}</p>
                          </div>
              
                        </a>
                      {% endif %}
                    {% endfor %}
                </div>

              {% endif %}
            {% endfor %}
        {% endcapture %}

        {% render 'tab', 
        triggers:tab_triggers,
        contents: tab_content,
        id: 'menu-tablist',
        %}
      </div>

  </div>
       
{% endcapture %}

{% render 'drawer', trigger: menu_trigger, content: menu_content, id: 'menu-drawer', from: 'left' %}

{% comment %}
  <script>
    setTimeout(() => {
      window.dispatchEvent(new CustomEvent('drawer:open', { detail: { id: 'menu-drawer' } }));
    }, 2000);
  </script>
{% endcomment %}
