{% liquid
  assign headless = headless
%}

<style>
  button {
    cursor: pointer;
  }

  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  [x-cloak] {
    display: none !important;
  }
</style>

{% comment %} Get TabList from Tab items by extracting and de-duplicating the parent_tab value {% endcomment %}
{% assign tabs = '' %}
{% for item in section.blocks %}
  {% if item.type == 'menu_item' %}
    {% assign current_tab = item.settings.parent_tab %}
    {% unless tabs contains current_tab %}
      {% assign tabs = tabs | append: current_tab | append: ',' %}
    {% endunless %}
  {% endif %}
{% endfor %}
{% assign tab_list = tabs | split: ',' %}
{% comment %} Get TabList from Tab items Ends {% endcomment %}

{% capture menu_trigger %}
   {% render 'button'           
   , variant: 'white'
   , size: 'icon'
  , icon: 'icons/hamburger.svg'
   , class: " rounded-lg!"
   , aria_label: 'Open Menu' %}
{% endcapture %}
{% capture menu_content %}
  <div class="flex flex-col w-full h-full  bg-white rounded-md lg:rounded-lg  overflow-hidden shadow-lg flex-1"  x-data="{
        tabSelected:'{{ tab_list.first }}',
        getContentID(tabContent){
          return tabContent.id.replace('-content','')
        },
        tabButtonClicked(tabButton){
            this.tabSelected = tabButton.id;
            this.tabRepositionMarker(tabButton);
        },
        tabRepositionMarker(tabButton){
        
        if(tabButton)
            this.$refs.tabMarker.style.width=tabButton.offsetWidth + 'px';
            this.$refs.tabMarker.style.height=tabButton.offsetHeight + 'px';
            this.$refs.tabMarker.style.left=tabButton.offsetLeft + 'px';
        },
        tabContentActive(tabContent){
            return this.tabSelected == this.getContentID(tabContent);
        },
        tabButtonActive(tabContent){
            const tabId = this.getContentID(tabContent);
            return this.tabSelected == tabId;
        }
    }">
      {%# Menu Top %}
      <div class="min-h-[120px] shrink-0">

         {%# Menu Header  %}
        <div class="flex items-center justify-between mb-6 p-5 lg:p-5">
          <div class="sr-only" id="drawer-title">Menu</div>
          <span class="text-lg font-semibold " aria-label="menu">Menu</span>

          {%# Close button  %}

          {% render 'button', 
          icon:'icons/cancel.svg', 
          class:'rounded-full! size-6! p-0! ',
          props: 'data-drawer-close',
          aria_label:'Close Menu'
          %}
       
          

        </div>

        {%# Tab List Starts%}
       
          <div
            x-ref="tabButtons"
            role="tablist"
            aria-label="Collection tabs"
            :class="`tabsButton relative pl-5 flex gap-4 shrink-0 items-center  justify-center-safe h-10 z-30 overflow-hidden  text-gray-500 bg-white select-none overflow-x-auto w-full no-scrollbar   ${!isDragging ? 'cursor-grap': 'cursor-grabbing'}`  "
            x-data="{
              isDragging: false,
              startX: 0,
              scrollLeft: 0,
              init() {
                $el.style.scrollBehavior = 'auto'; // Disable smooth scrolling for better drag fe$el
              },
              startDragging(e) {
                this.isDragging = true;
                this.startX = e.pageX - $el.offsetLeft;
                this.scrollLeft = $el.scrollLeft;
              },
              stopDragging() {
                this.isDragging = false;
              },
              drag(e) {
                if (!this.isDragging) return;
                e.preventDefault();
                const x = e.pageX - $el.offsetLeft;
                const walk = (x - this.startX) * 1.5; // Adjust multiplier for desired scroll speed
                $el.scrollLeft = this.scrollLeft - walk;
              },
            }"
            x-init="init()"
            @mousedown="startDragging"
            @mouseup="stopDragging"
            @mouseleave="stopDragging"
            @mousemove="drag">
              {% for tab in tab_list %}
                <button
                  role="tab"
                  aria-label="{{tab}}"
                  :aria-selected="tabSelected == '{{tab}}'"
                  aria-controls="{{ tab }}-content"
                  :id="'{{ tab }}'"
                  @click="tabButtonClicked($el);"
                  type="button"
                  :class="{ 'bg-primary text-primary-foreground' : tabButtonActive($el) }"
                  x-init="tabRepositionMarker($el)"
                  class="relative z-20 bg-gray-100 inline-flex items-center justify-center w-full h-10 px-3 text-sm font-medium transition duration-300 ease-out cursor-pointer whitespace-nowrap rounded-full">
                  {{ tab }}
                </button>
              {% endfor %}

              <div
                x-ref="tabMarker"
                class="absolute left-0 z-10 w-1/2 h-full duration-300 linear hidden"
                x-cloak>
                <div class="w-full h-full bg-primary rounded-full"></div>
              </div>
          </div>

      </div>

        
        {% comment %} Menu Items Starts {% endcomment %}
        <div class="flex-1 overflow-y-auto flex relative" >

            {% for tab in tab_list %}
              {% if tab != blank %}

                <div 
                  :id="'{{ tab }}-content'"
                  x-show="tabContentActive($el)"
                  x-transition:enter="transition ease-out duration-300 delay-300"
                  x-transition:enter-start="opacity-0"
                  x-transition:enter-end=" opacity-100"
                  x-transition:leave="transition ease-in duration-200 "
                  x-transition:leave-start="opacity-100"
                  x-transition:leave-end="opacity-0"
                  x-cloak
                  class="w-full flex flex-col  p-5"
                  :class="!tabContentActive($el) ? 'absolute left-0' : 'relative' "
                  role="tabpanel" aria-label="{{item.settings.parent_tab}} tab panel"
                  >
                  {% for item in section.blocks %}
                    {% if item.type == 'menu_item' and item.settings.parent_tab == tab %}
                      <a
                        aria-label="{{item.settings.title}}"
                        role="listitem"
                        href="{{ item.settings.href }}"
                        class="flex flex-col  gap-5  p-4 lg:p-6 hover:bg-gray-100 transition duration-300 rounded-lg"
                        {{ item.shopify_attributes }}>

                        <div class="flex items-center gap-5">
                          <div class="block size-20 rounded bg-gray-200 overflow-hidden  shrink-0"
                          {{ item.shopify_attributes }}>
                            <img
                              src="{{ item.settings.image | image_url : width : 200 }}"
                              alt="{{ item.settings.title }}"
                              class="w-full h-full object-cover"
                              width="80px"
                              height="80px" />
                            
                          </div>
                       
                          <p class="text-lg">{{ item.settings.title }}</p>
                        </div>
             
                      </a>
                    {% endif %}
                  {% endfor %}
                </div>

              {% endif %}
            {% endfor %}
          </div>

      
    {% comment %} Menu Items Ends {% endcomment %}
  </div>
       

  
{% endcapture %}
{% render 'drawer', trigger: menu_trigger, content: menu_content, id: 'menu-drawer', from: 'left', headless: headless %}
