{% assign hidden = true %}
{% capture content %}
<div class="flex flex-col flex-wrap items-center justify-center gap-4 p-4">

{% assign button_class = 'relative z-10 inline-flex h-10 w-fit cursor-pointer items-center justify-center rounded-lg bg-gray-100 px-3 text-sm font-medium whitespace-nowrap transition duration-300 ease-out' %}

	{% capture tab_triggers %}
		<button role="tab"
		data-tab-trigger="tab1"
		class="{{button_class}}"
		:class="tabButtonActive($el) ? 'bg-primary text-primary-foreground' : 'bg-gray-200 text-gray-500'"
		>
			Tab 1
		</button>

		<button role="tab"
		data-tab-trigger="tab2"
		class="{{button_class}}"
		:class="tabButtonActive($el) ? 'bg-primary text-primary-foreground' : 'bg-gray-200 text-gray-500'"
		>
			Tab 2
		</button>
{% endcapture %}

{% capture tab_contents %}
	<div class="py-5">
		<div data-tab-content="tab1" style="width:320px" class=" flex h-30 items-center justify-center rounded bg-gray-100 p-4">
			Content for Tab 1
		</div>

		<div data-tab-content="tab2" style="width:320px"  class=" flex h-30 items-center justify-center rounded bg-gray-100 p-4">
			Content for Tab 2
		</div>
	</div>
{% endcapture %}

{% render 'kuu-tab',
	triggers: tab_triggers,
	contents: tab_contents,
	id: 'my-tabs'
%}



	
</div>
  {% endcapture %}

{% if hidden != true %}
	{% comment %} Place holder for tab {% endcomment %}
	<div class='fixed inset-0 z-50 flex h-screen w-screen items-start justify-center bg-gray-600 p-4'>
		<div class='relative mx-auto w-full max-w-3xl rounded bg-white p-12'>
			<div class='relative min-h-[120px] shrink-0'>
				{{ content }}
			</div>
		</div>
	</div>
{% endif %}
