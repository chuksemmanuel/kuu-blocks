{% assign hidden = true %}
{% capture content %}
    {% capture horizontal_scroll_content %}
        {% for i in (1..10) %}
                <button
                  class="relative z-20 inline-flex h-10 w-full cursor-pointer items-center justify-center rounded-full bg-gray-100 px-3 text-sm font-medium whitespace-nowrap transition duration-300 ease-out">
                  Button {{ i }}
                </button>
              {% endfor %}
    {% endcapture %}
    {% render 'horizontal-scroll', content: horizontal_scroll_content %}
  {% endcapture %}

{% if hidden != true %}
	{% comment %} Place holder for tab {% endcomment %}
	<div class='fixed inset-0 z-50 flex h-screen w-screen items-start justify-center bg-gray-600 p-4'>
		<div class='relative mx-auto w-full max-w-3xl rounded bg-white p-12'>
			<div class='relative min-h-[120px] shrink-0'>
				{{ content }}
			</div>
		</div>
	</div>
{% endif %}
