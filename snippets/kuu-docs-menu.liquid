<div class='w-full'>
	<ul class='flex flex-col gap-2 pb-5'>
		{% for link in linklists['docs-menu'].links %}
			{% if link.links != blank %}
				<li x-data='{ expanded: true }'>
					<button
						@click='expanded = !expanded'
						class='flex w-full items-center gap-1 py-2 text-left font-medium hover:text-gray-900'
						:class="{ 'text-gray-900': expanded, 'text-gray-600': !expanded }"
					>
						<span
							class='transform text-gray-400 transition-transform duration-200'
							:class="{ 'rotate-90 text-gray-900': expanded }"
						>
							{{- 'icons/chevron-right.svg' | inline_asset_content -}}
						</span>
						<span>{{ link.title }}</span>
					</button>
					<ul
						x-show='expanded'
						x-collapse
						x-cloak
						class='ml-3 flex flex-col gap-1 border-l border-gray-200 pl-4'
					>
						{% for child_link in link.links %}
							{% if child_link.links != blank %}
								<li x-data='{ expanded: false }' class='w-full'>
									<button
										@click='expanded = !expanded'
										class='flex w-full items-center justify-between py-1 text-left text-sm font-medium text-gray-600 hover:text-gray-900'
										:class="{ 'text-gray-900': expanded }"
									>
										<span>{{ child_link.title }}</span>
										<span
											class=' transform text-gray-400 transition-transform duration-200'
											:class="{ 'rotate-90 text-gray-900': expanded }"
										>
											{{- 'icons/chevron-right.svg' | inline_asset_content -}}
										</span>
									</button>
									<ul
										x-show='expanded'
										x-collapse
										x-cloak
										class='mt-1 ml-3 flex flex-col gap-1 border-l border-gray-200 pl-3'
									>
										{% for grandchild_link in child_link.links %}
											<li>
												<a
													x-data='menuComingSoon'
													href='{{ grandchild_link.url }}'
													class='block py-1 text-sm text-gray-500 hover:text-gray-900'
													{% if grandchild_link.active %}
														aria-current='page'
													{% endif %}
												>
													{{ grandchild_link.title }}
												</a>
											</li>
										{% endfor %}
									</ul>
								</li>
							{% else %}
								<li>
									<a
										x-data='menuComingSoon'
										href='{{ child_link.url }}'
										class='flex flex-wrap items-center gap-0.5 py-1 text-sm text-gray-600 hover:text-gray-900'
										{% if child_link.active %}
											aria-current='page'
										{% endif %}
									>
										{{ child_link.title }}
									</a>
								</li>
							{% endif %}
						{% endfor %}
					</ul>
				</li>
			{% else %}
				<li>
					<a
						href='{{ link.url }}'
						class='block py-2 font-medium text-gray-600 hover:text-gray-900'
						{% if link.active %}
							aria-current='page'
						{% endif %}
					>
						{{ link.title }}
					</a>
				</li>
			{% endif %}
		{% endfor %}
	</ul>
</div>

<script>
	document.addEventListener('alpine:init', () => {
		const Alpine = window.Alpine;
		Alpine.data('menuComingSoon', () => ({
			coming_soon: false,
			init() {
				this.coming_soon = this.$el.href.toLowerCase().includes('coming-soon');

				this.$el.addEventListener('click', (event) => {
					if (this.coming_soon) {
						event.preventDefault();
					}
				});

				if (this.coming_soon) {
					this.$el.classList.add('text-gray-400!');
					this.$el.insertAdjacentHTML(
						'beforeend',
						`<span class='mx-1 rounded-full bg-gray-200 px-1 py-px text-[10px] text-gray-400'>Soon</span>`,
					);
				}
			},
		}));
	});
</script>
