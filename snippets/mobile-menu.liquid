<!-- <script src="https://cdn.jsdelivr.net/npm/@tailwindplus/elements@1" type="module"></script> -->
<div x-data="{
menuOpen: false
}" @toggle-menu.window="menuOpen = !menuOpen">
  <button
    @click="$dispatch('toggle-menu')"
    command="show-modal"
    commandfor="drawer"
    class="rounded-md bg-white/10 px-2.5 py-1.5 text-sm font-semibold text-white inset-ring inset-ring-white/5 hover:bg-white/20"
    style="background:{{settings.foreground_color}}; ">
    <svg
      class="hb"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 10 10"
      stroke="#eee"
      stroke-width=".6"
      fill="rgba(0,0,0,0)"
      stroke-linecap="round"
      style="cursor: pointer">
      <path d="M2,3L5,3L8,3M2,5L8,5M2,7L5,7L8,7">
        <animate
          dur="0.2s"
          attributeName="d"
          values="M2,3L5,3L8,3M2,5L8,5M2,7L5,7L8,7;M3,3L5,5L7,3M5,5L5,5M3,7L5,5L7,7"
          fill="freeze"
          begin="start.begin" />
        <animate
          dur="0.2s"
          attributeName="d"
          values="M3,3L5,5L7,3M5,5L5,5M3,7L5,5L7,7;M2,3L5,3L8,3M2,5L8,5M2,7L5,7L8,7"
          fill="freeze"
          :begin="!menuOpen" />
      </path>
      <rect
        width="10"
        height="10"
        stroke="none">
        <animate
          dur="2s"
          id="reverse"
          attributeName="width"
          :begin="menuOpen" />
      </rect>
      <rect
        width="10"
        height="10"
        stroke="none">
        <animate
          dur="0.001s"
          id="start"
          attributeName="width"
          values="10;0"
          fill="freeze"
          :begin="menuOpen" />
        <animate
          dur="0.001s"
          attributeName="width"
          values="0;10"
          fill="freeze"
          :begin="!menuOpen" />
      </rect>
    </svg>
  </button>

  <div
    class="fixed w-screen h-screen top-0 left-0 bg-black/50 z-40"
    x-show="menuOpen"
    x-transition:enter="transition ease-out duration-300"
    x-transition:enter-start="opacity-0"
    x-transition:enter-end="opacity-100"
    x-transition:leave="transition ease-in duration-200"
    x-transition:leave-start="opacity-100"
    x-transition:leave-end="opacity-0"
    x-cloak></div>

  {% comment %} Menu Content {% endcomment %}
  <div
    class="fixed top-0 left-0 w-full max-w-sm h-full bg-white p-6 z-50"
    @click.away="$dispatch('toggle-menu')"
    x-show="menuOpen"
    x-cloak
    x-transition:enter="transition ease-out duration-300"
    x-transition:enter-start="-translate-x-full opacity-0"
    x-transition:enter-end="translate-x-0 opacity-100"
    x-transition:leave="transition ease-in duration-200"
    x-transition:leave-start="opacity-100"
    x-transition:leave-end="-translate-x-full opacity-0">

    <nav class="flex flex-col gap-4">
      {% for link in settings.menu.links %}
        <a href="{{ link.url }}" class="text-lg font-medium text-gray-800 hover:text-gray-600">
          {{ link.title }}
        </a>
      {% endfor %}
    </nav>


  </div>


</div>