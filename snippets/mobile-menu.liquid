<!-- Include this script tag or install `@tailwindplus/elements` via npm: -->
<!-- <script src="https://cdn.jsdelivr.net/npm/@tailwindplus/elements@1" type="module"></script> -->

{% assign tabs = "" %}

{% for item in section.blocks %}
  {% if item.type == 'menu_item' %}
    {% assign current_tab = item.settings.parent_tab %}
    {% unless tabs contains current_tab %}
      {% assign tabs = tabs | append: current_tab | append: ',' %}
    {% endunless %}
  {% endif %}
{% endfor %}

{% assign tab_list = tabs | split: ',' %}


  <div x-data="{ menuOpen: true }" @toggle-menu.window="menuOpen = !menuOpen">

  <!-- Menu Trigger Button -->
  <button @click="$dispatch('toggle-menu')" class="rounded-md bg-white/10 px-2.5 py-1.5 text-sm font-semibold text-black inset-ring inset-ring-white/5 hover:bg-white/20">
    <!-- Hamburger SVG -->
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="lucide lucide-menu">
      <path id="line1" d="M4 5h16" />
      <path id="line2" d="M4 12h16" />
      <path id="line3" d="M4 19h16" />
    </svg>
  </button>

  <div
    class="fixed w-screen h-screen top-0 left-0 bg-black/50 z-40"
    x-show="menuOpen"
    x-transition:enter="transition ease-out duration-300"
    x-transition:enter-start="opacity-0"
    x-transition:enter-end="opacity-100"
    x-transition:leave="transition ease-in duration-200"
    x-transition:leave-start="opacity-100"
    x-transition:leave-end="opacity-0"
    x-cloak></div>

  {% comment %} Menu Content {% endcomment %}
  <div
    class="fixed bottom-0 left-0 w-full max-w-sm h-full bg-white  z-50"
    @click.away="$dispatch('toggle-menu')"
    x-show="menuOpen"
    x-cloak
    x-transition:enter="transition ease-out duration-300"
    x-transition:enter-start="-translate-x-full opacity-0"
    x-transition:enter-end="translate-x-0 opacity-100"
    x-transition:leave="transition ease-in duration-200"
    x-transition:leave-start="opacity-100"
    x-transition:leave-end="-translate-x-full opacity-0">

    <nav class="flex flex-col gap-4">

      {% comment %} Menu Header {% endcomment %}
      <div class="flex items-center justify-between mb-6 p-6">
        <h2 class="text-lg font-semibold">Menu</h2>
        <button @click="$dispatch('toggle-menu')" class="text-gray-500 hover:text-gray-700 ">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="lucide lucide-x">
            <line
              x1="18"
              y1="6"
              x2="6"
              y2="18"></line>
            <line
              x1="6"
              y1="6"
              x2="18"
              y2="18"></line>
          </svg>
        </button>
      </div>


      {% comment %} Menu Tab  Starts {% endcomment %}
      <div
        x-data="{
        tabSelected:'{{tab_list.first}}',
        tabButtonClicked(tabButton){
            this.tabSelected = tabButton.id;
            this.tabRepositionMarker(tabButton);
        },
        tabRepositionMarker(tabButton){
            this.$refs.tabMarker.style.width=tabButton.offsetWidth + 'px';
            this.$refs.tabMarker.style.height=tabButton.offsetHeight + 'px';
            this.$refs.tabMarker.style.left=tabButton.offsetLeft + 'px';
        },
        tabContentActive(tabContent){
         console.log(tabContent)
         console.log(tabContent.id)
            return this.tabSelected == tabContent.id.replace('-content','');
        },
        tabButtonActive(tabContent){
            const tabId = tabContent.id.replace('-content','');
            return this.tabSelected == tabId;
        }
    }"
        x-init="tabRepositionMarker($refs.tabButtons.firstElementChild);"
        class="relative w-full max-w-sm">

        <div x-ref="tabButtons" class="relative inline-grid items-center justify-center w-full h-10 grid-cols-3 p-1 text-gray-500 bg-white select-none">


          {% for tab in tab_list %}
            <button
              :id="'{{tab}}'"
              @click="tabButtonClicked($el);"
              type="button"
              :class="{ 'bg-gray-100 text-gray-700' : tabButtonActive($el) }"
              class="relative z-20 inline-flex items-center justify-center w-full h-8 px-3 text-sm font-medium transition-all rounded-md cursor-pointer whitespace-nowrap">
              {{ tab }}

            </button>
          {% endfor %}


          <div
            x-ref="tabMarker"
            class="absolute left-0 z-10 w-1/2 h-full duration-300 ease-out"
            x-cloak>
            <div class="w-full h-full bg-gray-100 rounded-md shadow-sm"></div>
          </div>
        </div>


        <div class="relative flex items-center justify-center w-full p-5 mt-2 text-xs text-gray-400  rounded-md content ">

          {% for tab in tab_list %}
            {% if tab != blank %}

              <div
                :id="'{{tab}}-content'"
                x-show="tabContentActive($el)"
                class="relative w-full">
                {% for item in section.blocks %}
                  {% if item.type == 'menu_item' and item.settings.parent_tab == tab %}
                    <a href="{{ item.settings.href }}">
                      <img
                        src="{{ item.settings.image | image_url: width: 375 }}"
                        alt="{{ item.settings.title }}"
                        width="124"
                        height="124">
                      <p>{{ item.settings.title }}</p>
                    </a>
                  {% endif %}
                {% endfor %}
              </div>


            {% endif %}
          {% endfor %}


        {% comment %} <div
                                                                                                                                                                                                                                                                                                                                                                                                                  :id="$id(tabId + '-content')"
                                                                                                                                                                                                                                                                                                                                                                                                                  x-show="tabContentActive($el)"
                                                                                                                                                                                                                                                                                                                                                                                                                  class="relative"
                                                                                                                                                                                                                                                                                                                                                                                                                  x-cloak>
                                                                                                                                                                                                                                                                                                                                                                                                                  And, this is the content for Tab2
                                                                                                                                                                                                                                                                                                                                  </div> {% endcomment %}


        </div>
      </div>
    {% comment %}  {% endcomment %}

    </nav>


  </div>


</div>