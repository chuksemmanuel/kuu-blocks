{% assign contrast = settings.primary_color | color_contrast: '#ffffff' %}
{% if contrast < 3.1 %}
	{% assign color_primary_foreground = '#000000' %}
{% else %}
	{% assign color_primary_foreground = '#ffffff' %}
{% endif %}

{% style %}
	{% # Loads all font variantions with display: swap %}
	{{ settings.type_primary_font | font_face: font_display: 'swap' }}
	{{ settings.type_primary_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}
	{{ settings.type_primary_font | font_modify: 'weight', 'bold' | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}
	{{ settings.type_primary_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}

	:root {
	  --font-primary--family: {{ settings.type_primary_font.family }},
	  {{ settings.type_primary_font.fallback_families }};
	  --font-primary--style: {{ settings.type_primary_font.style }};
	  --font-primary--weight: {{ settings.type_primary_font.weight }};
	  --page-width: {{ settings.max_page_width }};
	  --page-margin: {{ settings.min_page_margin }}px;


	  --color-primary: {{ settings.primary }};
	  --color-primary-foreground: {{ color_primary_foreground }};
	  --color-secondary: {{ settings.secondary }};
	  --color-background: {{ settings.background }};
	  --color-foreground: {{ settings.foreground }};

	  --style-border-radius-inputs: {{ settings.input_corner_radius }}px;


	    /* Font families */
	  --font-body--family: {{ settings.type_primary_font.family }};
	  --font-body--style: normal;
	  --font-body--weight: 400;
	  --font-subheading--family: {{ settings.type_primary_font.family }};
	  --font-subheading--style: normal;
	  --font-subheading--weight: 400;
	  --font-heading--family: {{ settings.type_primary_font.family }};
	  --font-heading--style: normal;
	  --font-heading--weight: 500;
	  --font-accent--family: {{ settings.type_primary_font.family }};
	  --font-accent--style: normal;
	  --font-accent--weight: 500;

	}
{% endstyle %}
