<h2 id='drawer-title' class='sr-only'>Search</h2>
<p id='drawer-description' class='sr-only'>Search across product,collections and pages</p>
<div
	x-data='searchDrawer()'
	class='flex flex-1 flex-col overflow-hidden rounded-md bg-white p-5 shadow-lg md:rounded-lg md:p-8'
	id='searchdrawer-content'
>
	<!-- Header -->
	<div class='flex h-11.5 items-center justify-between gap-4 border-b-2 border-gray-300 pb-2 has-focus-within:border-gray-800 md:pb-3'>
		<input
			type='text'
			name='searchTerm'
			x-model='searchTerm'
			x-ref='searchInput'
			@input='handleInput'
			placeholder='Search for ...'
			class='h-8 flex-1 border-none text-lg font-semibold! text-black ring-0 outline-0'
		>

		<button
			aria-label='clear search input'
			@click='clearSearchTerm'
			class='flex cursor-pointer flex-col items-center justify-center text-sm text-gray-600 transition hover:text-gray-700 md:text-base'
		>
			Clear
		</button>

		<div class='flex flex-col items-center justify-center leading-0'>
			{% render 'kuu-button',
				icon: 'icons/cancel.svg',
				class: 'rounded-full! size-6! p-0!',
				props: 'data-drawer-close',
				aria_label: 'close search drawer'
			%}
		</div>
	</div>

	<!-- Results Container -->
	<div class='flex h-full flex-1 flex-col overflow-hidden py-4 md:py-6 ' x-ref='resultsContainer'>
		<div
			aria-hidden='true'
			x-show='loading'
			x-transition:enter='transition ease-out duration-300 '
			x-transition:enter-start='opacity-0 translate-y-1'
			x-transition:enter-end='opacity-100 translate-y-0'
			x-transition:leave='transition ease-in duration-200'
			x-transition:leave-start='opacity-100 translate-y-0'
			x-transition:leave-end='opacity-0 translate-y-1'
			x-cloak
			class='flex h-full flex-col'
		>
			{% render 'kuu-searchdrawer-content-skeleton' %}
		</div>

		<div
			x-show='!loading && isSearchEmpty()'
			x-transition:enter='transition ease-out duration-300 delay-300'
			x-transition:enter-start='opacity-0 translate-y-1'
			x-transition:enter-end='opacity-100 translate-y-0'
			x-transition:leave='transition ease-in duration-200'
			x-transition:leave-start='opacity-100 translate-y-0'
			x-transition:leave-end='opacity-0 translate-y-1'
			x-cloak
			class='flex flex-col items-center justify-center py-10 text-gray-400'
		>
			<p>Start typing to search products...</p>
		</div>

		<!-- Results will be morphed here -->

		<div
			x-ref='searchResults'
			x-show='!loading && !isSearchEmpty()'
			x-transition:enter='transition ease-out duration-300 delay-300'
			x-transition:enter-start='opacity-0 translate-y-1'
			x-transition:enter-end='opacity-100 translate-y-0'
			x-transition:leave='transition ease-in duration-200'
			x-transition:leave-start='opacity-100 translate-y-0'
			x-transition:leave-end='opacity-0 translate-y-1'
			x-cloak
			id='searchdrawer-results'
			class='flex flex-col overflow-hidden'
			data-default-tab='{{default_tab}}'
		>
			<div class='flex h-full flex-col gap-4 overflow-hidden md:gap-6'>
				{% # tab trigger %}

				<div
					role='tablist'
					class='no-scrollbar relative z-30 flex h-6 w-full shrink-0  items-center gap-4 overflow-hidden overflow-x-auto bg-white text-gray-500 select-none md:h-7 '
				>
					{% assign tab_title_class = 'div shrink-0 text-lg font-semibold text-gray-300 hover:text-black  cursor-pointer transition' %}
					{% if products.size > 0 %}
						<button
							role='tab'
							aria-label='products'
							:aria-selected="activeTab === 'products'"
							aria-controls='searchdrawer-products-tab'
							key='products-title'
							data-search-tab='products'
							class='{{tab_title_class}}'
							:class="activeTab === 'products' && 'text-black!' "
							@click="() => setActiveTab('products')"
						>
							Products
						</button>
					{% endif %}
					{% if collections.size > 0 %}
						<button
							role='tab'
							aria-label='collections'
							:aria-selected="activeTab === 'collections'"
							aria-controls='searchdrawer-collections-tab'
							key='collections-title'
							data-search-tab='collections'
							class='{{tab_title_class}}'
							:class="activeTab === 'collections' && 'text-black!'  "
							@click="() => setActiveTab('collections')"
						>
							Collections
						</button>
					{% endif %}
					{% if pages.size > 0 %}
						<button
							role='tab'
							aria-label='pages'
							:aria-selected="activeTab === 'pages'"
							aria-controls='searchdrawer-pages-tab'
							key='pages-title'
							data-search-tab='pages'
							class='{{tab_title_class}}'
							:class="activeTab === 'pages' && 'text-black!'  "
							@click="() => setActiveTab('pages')"
						>
							Pages
						</button>
					{% endif %}
				</div>

				{% # tab list %}
				<div class='relative flex flex-1 flex-col overflow-y-auto'>
					{% # Product tab %}
					<div
						role='tabpanel'
						id='searchdrawer-products-tab'
						x-show="activeTab === 'products'"
						x-transition:enter='transition ease-out duration-300 delay-300'
						x-transition:enter-start='opacity-0'
						x-transition:enter-end=' opacity-100'
						x-transition:leave='transition ease-in duration-200 '
						x-transition:leave-start='opacity-100'
						x-transition:leave-end='opacity-0'
						x-cloak
						data-search-list='products'
						:class="activeTab !== 'products' ? 'absolute left-0' : 'relative' "
					>
						{% if products.size > 0 %}
							<div role='list' class='flex flex-col gap-5'>
								{% for product in products %}
									{% render 'kuu-searchdrawer-item', type: 'product', item: product, key: forloop.index, terms: terms %}
								{% endfor %}
							</div>
						{% else %}
							<div class='flex flex-col items-center justify-center py-10 text-gray-500'>
								<p>No results found.</p>
							</div>
						{% endif %}
					</div>

					{% # Collections tab %}
					<div
						role='tabpanel'
						id='searchdrawer-collections-tab'
						x-show="activeTab === 'collections'"
						x-transition:enter='transition ease-out duration-300 delay-300'
						x-transition:enter-start='opacity-0'
						x-transition:enter-end=' opacity-100'
						x-transition:leave='transition ease-in duration-200 '
						x-transition:leave-start='opacity-100'
						x-transition:leave-end='opacity-0'
						x-cloak
						data-search-list='collections'
						:class="activeTab !== 'collections' ? 'absolute left-0' : 'relative' "
					>
						{% if collections.size > 0 %}
							<div role='list' class='flex flex-col gap-5'>
								{% for collection in collections %}
									{% render 'kuu-searchdrawer-item',
										type: 'collection',
										item: collection,
										key: forloop.index,
										terms: terms
									%}
								{% endfor %}
							</div>
						{% else %}
							<div class='flex flex-col items-center justify-center py-10 text-gray-500'>
								<p>No results found.</p>
							</div>
						{% endif %}
					</div>

					{% # Pages tab %}
					<div
						role='tabpanel'
						id='searchdrawer-pages-tab'
						x-show="activeTab === 'pages'"
						x-transition:enter='transition ease-out duration-300 delay-300'
						x-transition:enter-start='opacity-0'
						x-transition:enter-end=' opacity-100'
						x-transition:leave='transition ease-in duration-200 '
						x-transition:leave-start='opacity-100'
						x-transition:leave-end='opacity-0'
						x-cloak
						data-search-list='pages'
						:class="activeTab !== 'pages' ? 'absolute left-0' : 'relative' "
					>
						{% if pages.size > 0 %}
							<div role='list' class='flex flex-col gap-5'>
								{% for page in pages %}
									{% render 'kuu-searchdrawer-item', type: 'page', item: page, key: forloop.index, terms: terms %}
								{% endfor %}
							</div>
						{% else %}
							<div class='flex flex-col items-center justify-center py-10 text-gray-500'>
								<p>No results found.</p>
							</div>
						{% endif %}
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

<style>
	[data-search-item] .highlight {
		background: #ffff00;
	}
</style>
