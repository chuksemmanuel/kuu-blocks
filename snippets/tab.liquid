{% liquid
  assign id = id | default: 'tab'
  assign default_active = default_active
%}

<div
  data-tab-id="{{id}}"
  data-default-active="{{default_active}}"
  x-data="tab"
  class="w-full{{class}}"
>
  <!-- Triggers -->
  <div
    role="tablist"
    class="{{trigger_class}}"
  >
    {{ triggers }}
  </div>

  <!-- Contents -->
  <div class="{{content_class}}">
    {{ contents }}
  </div>
</div>
