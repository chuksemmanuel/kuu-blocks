{% liquid
  assign headless = headless
  assign id = id | default: 'cartdrawer'

  assign sticky_header = sticky_header
  assign sticky_footer = sticky_footer

  assign show_compare_price = show_compare_price
  assign final_price_color = final_price_color | default: '#fb2c36'

  assign show_savings_badge = show_savings_badge
  assign savings_badge_color = savings_badge_color | default: '#fb2c36'

  assign show_variant_title = show_variant_title

  assign show_secondary_footer_cta = show_secondary_footer_cta
  assign secondary_footer_cta_label = secondary_cta_label | default: 'Continue Shopping'
  assign secondary_footer_cta_link = secondary_cta_link | default: null

  assign show_checkout_lock_icon = show_checkout_lock_icon
  assign checkout_button_label = checkout_button_label | default: 'Proceed to Checkout'
%}


{% capture footer %}
    {% render 'cartdrawer-footer'
    , show_compare_price:show_compare_price
    , final_price_color:final_price_color
    , show_secondary_footer_cta:show_secondary_footer_cta
    , secondary_footer_cta_label:secondary_footer_cta_label
    , secondary_footer_cta_link:secondary_footer_cta_link
    , show_checkout_lock_icon: show_checkout_lock_icon
    , checkout_button_label:checkout_button_label
    %}
{% endcapture %}
<div
  id="cartdrawer"
  x-data="cartDrawer()"
  {{ shopify_attributes }}>


  {% capture cart_button %}
        <span class="bg-primary flex justify-center items-center text-primary-foreground z-20 absolute rounded-full size-6 -top-2 -right-2 p-1 text-xs" data-cartdrawer-bubble >{{ cart.item_count }}</span>
        {{ 'icons/shopping-cart.svg' | inline_asset_content }}
  {% endcapture %}
  {% capture cart_trigger %}
           {% render 'button'
        , size: 'icon'
        , content: cart_button
        , class: 'bg-white text-black hover:bg-primary hover:text-white!  md:size-12 rounded-full! '
         , aria_label: 'Open Shopping cart'
      %}
  {% endcapture %}
  {% capture cart_content %}
  
  <div role="status" aria-live="assertive" class="sr-only" id="cartdrawer-live-region" aria-atomic="true" data-drawer-live-region></div>
  <h2 id="drawer-title" class="sr-only">Cart Drawer</h2>
  <p  id="drawer-description" class="sr-only"> Your shopping cart with {{ cart.item_count }} items.</p>

  <div id="cartdrawer-content" class="h-full w-full bg-white rounded-md lg:rounded-lg  overflow-hidden shadow-lg flex-1">
    {% if cart.empty? %}
        <div class="w-full h-full flex flex-col justify-center items-center gap-4">
          {% render 'button'
          , size: 'icon'
          , content: cart_button
          , class: 'bg-white text-black  size-12 rounded-full! '
          %}
          <p class="text-xl font-semibold">Your Cart is Empty</p>
            {% render 'button',variant:'primary', size:'lg', label:'Continue Shopping', class:'rounded-full!', props:'data-drawer-close' %}
      </div>

    {% else %}
      <div class="w-full h-full flex flex-col">

  

      <div class=" flex-1 flex flex-col {% if sticky_header %}  overflow-hidden {% else %} overflow-y-auto {% endif %}">
  
      
        <!-- Cart Header -->
        <div id="cartdrawer-header" class="shrink-0 flex flex-col gap-2 min-h-12 h-fit p-5 lg:p-8 pb-1 lg:pb-2" aria-label="Cart Drawer Header" tabindex="0">
            
            <div class="flex justify-between items-center w-full" >

              <div class="flex items-center gap-2" role="presentation">
                    <span class="sr-only">You have {{cart.item_count}} items in cart</span>
                    <p  aria-hidden="true" class="font-semibold lg:text-lg">Cart </p>
                    <span  aria-hidden="true" class="flex justify-center items-center size-6 min-w-fit bg-primary text-primary-foreground rounded-full p-px text-sm">{{cart.item_count}}</span>
                    
              </div>
                
                {% render 'button', icon:'icons/cancel.svg',class:'rounded-full! size-6! p-0! ', props:'data-drawer-close', aria_label:'Close Cart Drawer' %}
                
            </div>

            <!--Placeholder for app extension -->
            <div class="hidden"></div>
        </div>
        
        {%# Always Scrollable %}
        <div class="flex-1 flex flex-col justify-between  pt-1 lg:pt-2 {% if sticky_header %}overflow-y-auto {% endif %}">

          <div class="pb-5 lg:pb-8">
              {%# Cart Items %}
              {% render 'cartdrawer-items'
              , show_compare_price:show_compare_price
              , final_price_color:final_price_color
              , show_savings_badge:show_savings_badge
              , show_variant_title:show_variant_title
              , savings_badge_color:savings_badge_color
              %}
          </div>


              <div>
                {%# Recommended Products %}
                <div class="bg-gray-200 animate-pulse w-full min-h-32 rounded-lg hidden"></div>

                {% unless sticky_footer %}
                  {{footer}}
                {% endunless %}
              </div>
           
        </div>
      </div>


      {% if sticky_footer %}
        {% comment %} {% render 'cartdrawer-footer', show_compare_price:show_compare_price, secondary_cta:secondary_cta, checkout_button_text:checkout_button_text%} {% endcomment %}
         {{footer}}
      {% endif %}
    

      </div>
    {% endif %}
  </div>
  {% endcapture %}
  {% render 'drawer'
    , trigger: cart_trigger
    , content: cart_content
    , id: id
    , from: 'right'
    , headless: headless
  %}
</div>

<script src="{{ 'js/blocks/cartdrawer.js' | asset_url }}" defer></script>
{% comment %} <script>
    setTimeout(() =>{
    window.dispatchEvent(new CustomEvent('drawer:open',{detail:{id:'cartdrawer'}}))
    },1000)
</script> {% endcomment %}