{% liquid
	assign headless = headless
	assign id = id | default: 'cartdrawer'

	assign sticky_header = sticky_header
	assign sticky_footer = sticky_footer

	assign show_compare_price = show_compare_price
	assign final_price_color = final_price_color | default: '#fb2c36'

	assign show_savings_badge = show_savings_badge
	assign savings_badge_color = savings_badge_color | default: '#fb2c36'

	assign show_variant_title = show_variant_title

	assign show_secondary_footer_cta = show_secondary_footer_cta
	assign secondary_footer_cta_label = secondary_cta_label | default: 'Continue Shopping'
	assign secondary_footer_cta_link = secondary_cta_link | default: null

	assign show_checkout_lock_icon = show_checkout_lock_icon
	assign checkout_button_label = checkout_button_label | default: 'Proceed to Checkout'
%}

{% capture footer %}
    {% render 'cartdrawer-footer'
    , show_compare_price:show_compare_price
    , final_price_color:final_price_color
    , show_secondary_footer_cta:show_secondary_footer_cta
    , secondary_footer_cta_label:secondary_footer_cta_label
    , secondary_footer_cta_link:secondary_footer_cta_link
    , show_checkout_lock_icon: show_checkout_lock_icon
    , checkout_button_label:checkout_button_label
    %}
{% endcapture %}
<div
	id='cartdrawer'
	x-data='cartDrawer()'
	data-section-id='{{ section_id }}'
	{{ shopify_attributes }}
>
	{% capture cart_button %}
        <span class="bg-primary text-primary-foreground absolute -top-2 -right-2 z-20 flex size-6 items-center justify-center rounded-full! p-1 text-xs" data-cartdrawer-bubble>{{ cart.item_count }}</span>
          <span aria-hidden="true"> {{ 'icons/shopping-cart.svg' | inline_asset_content }}</span>
  {% endcapture %}
	{% capture cart_trigger %}
       {% render 'button'
  , variant: 'white'
  , size: 'icon'
  , content: cart_button
  , class:'rounded-full!'
  , aria_label: 'Open Shopping cart'
  , props: 'x-data @click="$dispatch(`drawer:open`,{id:`cartdrawer`})"'
%}
  {% endcapture %}
	{% capture cart_content %}
  
  <div role="status" aria-live="assertive" class="sr-only" id="cartdrawer-live-region" aria-atomic="true" data-drawer-live-region></div>
  {% comment %} <h2 id="drawer-title" class="sr-only">Cart Drawer</h2> {% endcomment %}
  
  {% comment %} {% if cart.empty? %}
    <p  id="drawer-description" class="sr-only"> Your Cart is empty.</p>
    {% else %}
     <p  id="drawer-description" class="sr-only"> Your shopping cart with {{ cart.item_count }} items.</p>
  {% endif %} {% endcomment %}

  <div id="cartdrawer-content" class="h-full w-full flex-1 overflow-hidden rounded-md  bg-white shadow-lg lg:rounded-lg">
    {% if cart.empty? %}
      <div id="cartdrawer-empty" class="flex h-full w-full flex-col items-center justify-center gap-4" >

        {% render 'button'
        , size: 'icon'
        , content: cart_button
        , class: 'bg-white text-black  size-12 rounded-full! '
        , props:'aria-hidden="true"'
        %}
        <p class="text-xl font-semibold" id="drawer-description">Your Cart is Empty</p>
        {% render 'button',variant:'primary', size:'lg', label:'Continue Shopping', aria_label:'Close cart drawer and continue shopping', class:'rounded-full!', props:'data-drawer-close tabIndex="0"' %}

      </div>
    {% else %}
      <p  id="drawer-description" class="sr-only"> Your shopping cart with {{ cart.item_count }} items.</p>
      <div  class="flex h-full w-full flex-col">

          <div id="cartdrawer-inner" class=" flex flex-1 flex-col " :class="settings.stickyHeader ? 'overflow-hidden' : 'overflow-y-auto'">
      
            <!-- Cart Header -->
            <div id="cartdrawer-header" class="flex h-fit min-h-12 shrink-0 flex-col gap-2 " aria-label="Cart Drawer Header" tabindex="0">

                <div id="cartdrawer-header-inner" class="flex w-full items-center justify-between px-5 pt-4 pb-2 lg:px-8 lg:pb-2" >
                  <div class="flex items-center gap-2" role="presentation">
                        <span class="sr-only">You have {{cart.item_count}} items in cart</span>
                        <p  aria-hidden="true" class="font-semibold lg:text-lg">Cart </p>
                        <span  aria-hidden="true" class="bg-primary text-primary-foreground flex size-6 min-w-fit items-center justify-center rounded-full p-px text-sm">{{cart.item_count}}</span>
                  </div>
                  {% render 'button', icon:'icons/cancel.svg',class:'rounded-full! size-6! p-0! ', props:'data-drawer-close', aria_label:'Close Cart Drawer' %}
                </div>
                
            </div>
            
            {%# Always Scrollable %}
            <div class="flex flex-1 flex-col justify-between  pt-1 lg:pt-2 " :class="settings.stickyHeader ? 'overflow-y-auto' : ''">

              <div class="pb-5 lg:pb-8">
                  {%# Cart Items %}
                  {% render 'cartdrawer-items'
                  , show_compare_price:show_compare_price
                  , final_price_color:final_price_color
                  , show_savings_badge:show_savings_badge
                  , show_variant_title:show_variant_title
                  , savings_badge_color:savings_badge_color
                  %}
              </div>


                  <div>
                    {%# Recommended Products %}
                    <div class="hidden min-h-32 w-full animate-pulse rounded-lg bg-gray-200"></div>


                    <template x-if="!settings.stickyFooter">
                      {{footer}}
                    </template>
                 
                  </div>
              
            </div>

          </div>

                    <template x-if="settings.stickyFooter">
                      {{footer}}
                    </template>

     
      
      </div>

    {% endif %}
    </div>
  {% endcapture %}
	{% render 'drawer', trigger: cart_trigger, content: cart_content, id: id, from: 'right', headless: headless %}
</div>

<script type='application/json' id='cartdrawer-settings'>
	{
	"stickyHeader": {{ sticky_header | json }},
	"stickyFooter": {{ sticky_footer | json }},

	"showComparePrice": {{ show_compare_price | json }},
	"finalPriceColor": {{ final_price_color  | json }},
	"showVariantTitle": {{ show_variant_title | json }},

	"showSavingsBadge": {{ show_savings_badge | json }},
	"savingsBadgeColor":{{ savings_badge_color  | json }}
	}
</script>
<script src='{{ 'js/blocks/cartdrawer.js' | asset_url }}' defer></script>

{% comment %}
	<script>
	  setTimeout(() => {
	    window.dispatchEvent(new CustomEvent('drawer:open', { detail: { id: 'cartdrawer' } }));
	  }, 1000);
	</script>
{% endcomment %}
