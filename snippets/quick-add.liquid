{% liquid
  assign variant = product.first_available_variant
%}

<div data-quick-add="{{product.id}}">

  {% if product.has_only_default_variant %}
    {% comment %} {% render 'add-to-cart-button'
      , id: variant.id
      , quantity: 1
      , button_variant:'circled-icon'
      , icon:'icons/shopping-cart.svg'
      , size:'none'
      , class: 'shadow-sm'
    %} {% endcomment %}

      {% render 'add-to-cart-button'
      , id: variant.id
      , quantity: 1
      , button_variant:'circled-icon'
      , size:'none'
      , icon:'icons/shopping-cart.svg',
      , class: 'shadow-sm '
      , loading_class:'bg-primary! text-primary-foreground! shadow-sm'
    %}

  {% else %}

    {% capture quick_add_trigger %}
      <div
        class="absolute bottom-3 right-3">
          {% render 'button'
            , variant: 'circled-icon'
            , size: 'none'
            , icon: 'icons/shopping-cart.svg'
            , class: 'shadow-sm '
          %}
      </div>
    {% endcapture %}
    {% capture quick_add_content %}
      <div id="quick-add-content" class="h-[508px]! flex flex-col w-full p-4 sm:p-6 bg-white rounded-md lg:rounded-lg  overflow-hidden shadow-lg ">

          <div class="overflow-y-auto">
              <div class=" flex flex-col gap-2 shrink-0">
                <div class="flex gap-6">
                      {% # Image %}
                      <a href="{{product.url}}" class="block size-20 rounded bg-gray-200 overflow-hidden  shrink-0">
                        <img
                          src="{{ product.featured_image | image_url: width: 200 }}"
                          alt="{{ product.title | escape }}"
                          class="w-full h-full object-cover"
                          width="80px"
                          height="80px" />
                      </a>

                      <div class="flex flex-col gap-1">
                          {% # Title %}
                      <a href="{{product.url}}" class="font-semibold line-clamp-2 max-w-50">{{ product.title }}</a>
                      

                      {% # Price %}
                      
                      {% if variant.price != variant.compare_at_price %}
                          <div class="flex flex-col md:flex-row md:items-center flex-wrap gap-x-1 gap-y-px">
                            <div class="flex  gap-2 items-center">
                              <span style="color:{{final_price_color}}">{{ variant.price | money }}</span>
                              <span class="line-through text-gray-500">
                                {{ variant.compare_at_price | money }}
                              </span>
                            </div>
      
                          </div>
                        {% else %}
                          <span class="">{{ variant.price | money }}</span>
                      {% endif %}
                      </div>


                </div>

                <div>
                  {%# Variants %}
                  <div class="flex flex-col justify-center items-center">
                    <label for="color">Color</label>
                  </div>
                </div>
            
              </div>
              
          </div>
      </div>
    {%endcapture%}
    {% render 'drawer'
      , trigger: quick_add_trigger
      , content: quick_add_content 
      , id: 'quick-add-{{product.id}}', from: 'bottom' , class:'min-h-80! sm:min-h-[508px]! h-auto! max-h-[60svh] sm:max-w-[528px] sm:left-auto sm:right-0 max-sm:p-0! max-sm:rounded-b-none! ' %}

  {% endif %}

</div>


<script>

  


  document.addEventListener('alpine:init', () =>{
    const Alpine = window.Alpine;
    Alpine.data('quickAdd{{product.id}}', (product)=> ({
        adding:false,
        init:(){
          console.log('quick add initialized for {{product.id}}')
          console.log(product)
        },
  })
  )
    })
</script>


