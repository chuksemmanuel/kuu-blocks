
<div data-quick-add="{{product.id}}">

  {% if product.has_only_default_variant %}
    {% comment %} {% render 'add-to-cart-button'
      , id: variant.id
      , quantity: 1
      , button_variant:'circled-icon'
      , icon:'icons/shopping-cart.svg'
      , size:'none'
      , class: 'shadow-sm'
    %} {% endcomment %}

      {% render 'add-to-cart-button'
      , id: product.first_available_variant.id
      , quantity: 1
      , button_variant:'circled-icon'
      , size:'none'
      , icon:'icons/shopping-cart.svg',
      , class: 'shadow-sm '
      , loading_class:'bg-primary! text-primary-foreground! shadow-sm'
    %}

  {% else %}

    {% capture quick_add_trigger %}
      <div
        class="absolute bottom-3 right-3">
          {% render 'button'
            , variant: 'circled-icon'
            , size: 'none'
            , icon: 'icons/shopping-cart.svg'
            , class: 'shadow-sm '
          %}
      </div>
    {% endcapture %}
    {% capture quick_add_content %}
      {% render 'quick-add-content', product: product %}
    {% endcapture %}

    

 {% assign quick_add_id = 'quick-add-' |  append: product.id  %}
    {{quick_add_id}}
    {% render 'drawer'
      , trigger: quick_add_trigger
      , content: quick_add_content 
      , id:quick_add_id,
      from: 'bottom',
      class:'min-h-[460px]! sm:min-h-[460px]! h-auto! max-h-screen sm:max-w-[528px] sm:left-auto sm:right-0 max-sm:p-0! max-sm:rounded-b-none!' %}

  {% endif %}

</div>

<script>
    // Todo: Remove this in production
    setTimeout(() =>{
      document.querySelector('.products-grid > div:nth-child(4) [data-drawer-id*="quick-add"] > div').click()
    },2000)

</script>