{% comment %}
  Heading Component
  -----------------
  Usage examples:

  {% render 'heading', title: 'Our Products' %}

  {% render 'heading',
  title: 'Our Products',
  subheading: 'Recently added shirts!',
  tag: 'h2',
  align: 'center'
  %}
{% endcomment %}

{%- assign heading_text = title | default: 'Heading Text' -%}
{%- assign sub_text = subheading | default: null -%}
{%- assign heading_tag = tag | default: 'h2' -%}

{% case align %}
  {% when 'left' %}
    {%- assign align_class = 'text-left' -%}
  {% when 'center' %}
    {%- assign align_class = 'text-center' -%}
  {% when 'right' %}
    {%- assign align_class = 'text-right' -%}
  {% else %}
    {%- assign align_class = 'text-left' -%}


{% endcase %}

{%- capture heading_size -%}
  {%- case heading_tag -%}
    {%- when 'h1' -%} text-4xl md:text-5xl font-semibold
    {%- when 'h2' -%} text-3xl md:text-4xl font-medium
    {%- when 'h3' -%} text-2xl md:text-3xl font-medium
    {%- when 'h4' -%} text-xl md:text-2xl font-medium
    {%- when 'h5' -%} text-lg md:text-xl font-medium
    {%- when 'h6' -%} text-base md:text-lg font-medium
    {%- else -%} text-2xl font-medium
  {%- endcase -%}
{%- endcapture -%}
{%- capture subheading_size -%}
  {%- case heading_tag -%}
    {%- when 'h1' -%} text-base md:text-lg text-gray-500
    {%- when 'h2' -%} text-sm md:text-base text-gray-500
    {%- else -%} text-sm text-gray-500
  {%- endcase -%}
{%- endcapture -%}
<div class="{{ align_class }} space-y-2">
  <{{ heading_tag }} class="{{ heading_size | strip }}">
    {{ heading_text }}
    </{{ heading_tag }}>

    {% if sub_text %}
      <p class="{{ subheading_size | strip }}">
        {{ sub_text }}
      </p>
    {% endif %}
  </div>