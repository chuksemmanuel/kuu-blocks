{% comment %}
  Props:
  collection (optional)
  image (optional, fallback if no collection)
  title (optional, fallback if no collection)
  href (optional, fallback if no collection)
  count (optional)
  height, width, class, show_button, position
{% endcomment %}

{% if collection != blank %}
  {% assign card_image = collection.featured_image %}
  {% assign card_title = collection.title %}
  {% assign card_href = collection.url %}
  {% assign card_count = collection.products_count %}
{% else %}
  {% assign card_image = image %}
  {% assign card_title = title %}
  {% assign card_href = href %}
  {% assign card_count = count %}
{% endif %}

{% case position %}
  {% when 'bottom' %}
    {% assign position_class = 'justify-between items-end text-left' %}
  {% else %}
    {% assign position_class = 'justify-center flex-col items-center text-center' %}
{% endcase %}

<a
  href="{{ card_href }}"
  aria-label="{{ card_title }}"
  class="bg-white rounded-3xl w-full relative overflow-hidden cursor-pointer group min-h-full! {{ class }}"
  {% if block %}
  {{ block.shopify_attributes }}
  {% endif %}>

  <div class="flex {{ position_class }} p-4 w-full h-full z-30 relative">
    <div class="flex flex-col max-w-[60%]">
      <span class="relative z-30 text-white text-shadow-sm text-2xl line-clamp-2">
        {{ card_title }}
      </span>

      {% if card_count and show_count %}
        <span class="relative z-30 text-white text-shadow-sm line-clamp-2">
          ({{ card_count }} item{% if card_count > 1 %}s{% endif %})
        </span>
      {% endif %}
    </div>

    {% if show_button %}
      {% render 'button'
        , size: 'icon'
        , icon: 'icons/arrow-up-right.svg'
        , class: 'rounded-full! bg-white text-black md:size-12' %}
    {% endif %}
  </div>

  {% if card_image %}
    <img
      src="{{ card_image  | image_url: width:width }}"
      alt="{{ card_title }}"
      width="{{ width }}"
      height="{{ height }}"
      class="absolute inset-0 h-full! w-full object-cover z-5 transition duration-300 ease-out group-hover:scale-105 group-active:scale-100">
  {% endif %}

  {% comment %} Overlay {% endcomment %}
  <div class="{% if position == 'bottom' %}bg-[linear-gradient(0deg,rgba(0,0,0,0.5)_0%,rgba(0,0,0,0.2)_25%,rgba(0,0,0,0)_100%)]{% else %}bg-black/5{% endif %} absolute inset-0 h-full w-full z-10"></div>
</a>