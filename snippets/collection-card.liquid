{% case position %}
  {% when 'bottom' %}
    {% assign position_class = 'justify-between items-end  text-left' %}
  {% else %}
    {% assign position_class = 'justify-center flex-col items-center text-center' %}
{% endcase %}


<a
  href="{{href}}"
  class=" bg-gray-200 rounded-3xl w-full  relative overflow-hidden  cursor-pointer group  h-full {{class}}"
  style="height:{{height}}px">


  <div class="flex {{position_class}} p-4  w-full h-full z-50 relative ">
    <div class="flex flex-col max-w-[60%]">
      <span class="relative z-50 text-white text-shadow-sm text-2xl line-clamp-2">
        {{ title }}
      </span>
      {% if subtitle %}
        <span class="relative z-50 text-white text-shadow-sm line-clamp-2">
          {{ subtitle }}
        </span>
      {% endif %}
    </div>

    {% if show_button %}
      {% render 'button'
        , size: 'icon'
        , icon: 'icons/arrow-up-right.svg'
        , class: 'rounded-full! bg-white text-black md:size-12' %}

    {% endif %}

  </div>


  <img
    src="{{ image}}"
    alt="{{title}}"
    width="{{width}}"
    height="{{height}}"
    class="absolute inset-0 h-full! w-full object-cover  z-5 transition duration-300 ease-out group-hover:scale-105 group-active:scale-100">

  {% comment %} Overlay {% endcomment %}
  <div class=" {% if position %} bg-[linear-gradient(0deg,rgba(0,0,0,0.5)_0%,rgba(0,0,0,0.2)_25%,rgba(0,0,0,0)_100%)] {% else %}bg-black/5 {% endif %}  absolute inset-0 h-full w-full z-10"></div>
</a>