{% comment %}
	Props:
	collection (optional)
	image (optional, fallback if no collection)
	title (optional, fallback if no collection)
	href (optional, fallback if no collection)
	count (optional)
	height, width, class, show_button, position
{% endcomment %}

{% if collection != blank %}
	{% assign card_image = collection.featured_image %}
	{% assign card_title = collection.title %}
	{% assign card_href = collection.url %}
	{% assign card_count = collection.products_count %}
{% else %}
	{% assign card_image = image %}
	{% assign card_title = title %}
	{% assign card_href = href %}
	{% assign card_count = count %}
{% endif %}

{% case position %}
	{% when 'bottom' %}
		{% assign position_class = 'justify-between items-end text-left' %}
	{% else %}
		{% assign position_class = 'justify-center flex-col items-center text-center' %}
{% endcase %}

<a
	width='{{ width }}'
	height='{{ height }}'
	href='{{ card_href }}'
	aria-label='{{ card_title }}'
	class='group relative block w-full shrink-0 cursor-pointer overflow-hidden rounded-3xl bg-gray-100 {{ class }}'
	{% if block %}
		{{ block.shopify_attributes }}
	{% endif %}

	{% if style != blank %}
		style='{{ style | strip |  strip_newlines }}'
	{% endif %}
>
	<div class='flex {{ position_class }} relative z-30 h-full w-full p-4'>
		<div class='flex max-w-[60%] flex-col'>
			<span class='relative z-30 line-clamp-2 text-2xl text-white text-shadow-sm'>
				{{ card_title }}
			</span>

			{% if card_count and show_count %}
				<span class='relative z-30 line-clamp-2 text-white text-shadow-sm'>
					({{ card_count }} item{% if card_count > 1 %}s{% endif %})
				</span>
			{% endif %}
		</div>

		{% if show_button %}
			{% render 'button',
				size: 'icon',
				icon: 'icons/arrow-up-right.svg',
				class: 'rounded-full! bg-white text-black md:size-12'
			%}
		{% endif %}
	</div>

	{% liquid
		if card_image
			assign image = card_image | image_url: width: width
			assign alt = card_image.alt
		else
			assign image = 'placeholder-product.jpg' | asset_img_url: 'large'
			assign alt = 'placeholder-product'
		endif
	%}

	<img
		src='{{ image }}'
		alt='{{ alt }}'
		width='{{ width }}'
		height='{{ height }}'
		class='absolute inset-0 z-5 h-full! w-full object-cover transition duration-300 ease-out group-hover:scale-105 group-active:scale-100 '
	>

	{% comment %} Overlay {% endcomment %}
	<div
		class='{% if position == 'bottom' %}bg-[linear-gradient(0deg,rgba(0,0,0,0.5)_0%,rgba(0,0,0,0.2)_25%,rgba(0,0,0,0)_100%)]{% else %}bg-black/5{% endif %} absolute inset-0 z-10 h-full w-full'
	></div>
</a>
