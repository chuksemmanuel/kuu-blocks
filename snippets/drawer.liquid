<style>
  [x-cloak] {
    display: none !important;
  }
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  body.drawer-open {
    overflow: hidden;
  } /* Lock background scroll */
</style>

{% assign from = from | default: 'right' %}

  <div
  x-data="drawer()"
  x-init="init('{{ from }}')"
  class="ida-drawer">
  <!-- Trigger -->
  <div @click="openDrawer()">
    {{ trigger }}
  </div>

  <!-- Overlay -->
  <div
    class="fixed inset-0 bg-black/50 z-40"
    x-show="open"
    @click="closeDrawer()"
    x-transition:enter="transition ease-out duration-300"
    x-transition:enter-start="opacity-0"
    x-transition:enter-end="opacity-100"
    x-transition:leave="transition ease-in duration-200"
    x-transition:leave-start="opacity-100"
    x-transition:leave-end="opacity-0"
    x-cloak>
</div>

  <!-- Drawer -->
  {% assign position_classes = '' %}
  {% assign enter_start = '' %}
  {% assign enter_end = '' %}
  {% assign leave_start = '' %}
  {% assign leave_end = '' %}

  {% case from %}
    {% when 'left' %}
      {% assign position_classes = 'left-0 top-0 h-full  w-80 rounded-r-xl origin-left' %}
      {% assign enter_start = '-translate-x-full opacity-0' %}
      {% assign enter_end = 'translate-x-0 opacity-100' %}
      {% assign leave_start = 'translate-x-0 opacity-100' %}
      {% assign leave_end = '-translate-x-full opacity-0' %}
    {% when 'right' %}
      {% assign position_classes = 'right-0 top-0 h-full w-80 rounded-l-xl origin-right' %}
      {% assign enter_start = 'translate-x-full opacity-0' %}
      {% assign enter_end = 'translate-x-0 opacity-100' %}
      {% assign leave_start = 'translate-x-0 opacity-100' %}
      {% assign leave_end = 'translate-x-full opacity-0' %}
    {% when 'top' %}
      {% assign position_classes = 'top-0 left-0 w-full h-auto rounded-b-xl origin-top' %}
      {% assign enter_start = '-translate-y-full opacity-0' %}
      {% assign enter_end = 'translate-y-0 opacity-100' %}
      {% assign leave_start = 'translate-y-0 opacity-100' %}
      {% assign leave_end = '-translate-y-full opacity-0' %}
    {% when 'bottom' %}
      {% assign position_classes = 'bottom-0 left-0 w-full h-auto rounded-t-xl origin-bottom' %}
      {% assign enter_start = 'translate-y-full opacity-0' %}
      {% assign enter_end = 'translate-y-0 opacity-100' %}
      {% assign leave_start = 'translate-y-0 opacity-100' %}
      {% assign leave_end = 'translate-y-full opacity-0' %}
  {% endcase %}

  <div
    class="fixed z-50 bg-white shadow-lg {{ position_classes }} transition-transform duration-300 ease-out overflow-y-auto no-scrollbar focus:outline-none min-w-80"
    tabindex="-1"
    x-show="open"
    x-cloak
    {% comment %}
    x-transition:enter="transition ease-out duration-300"
    x-transition:enter-start="{{ enter_start }}"
    x-transition:enter-end="{{ enter_end }}"
    x-transition:leave="transition ease-in duration-200"
    x-transition:leave-start="{{ leave_start }}"
    x-transition:leave-end="{{ leave_end }}"
    {% endcomment %}
    @keydown.escape.window="closeDrawer()">

    <div class="flex justify-end p-4">
      <div @click="closeDrawer()" aria-label="Close drawer">
        {% render 'button' variant: 'outline' size: 'icon' icon: 'icons/cancel.svg' class: "hover:bg-white! md:size-12 rounded-full!" %}
      </div>
    </div>

    <div class="px-6 pb-8">
      {{ content }}
    </div>
  </div>
</div>

<script>
  function drawer() {
    return {
      open: false,
      lastFocusedElement: null,
      direction: 'right',

      init(direction) {
        this.direction = direction
      },

      openDrawer() {
        this.lastFocusedElement = document.activeElement
        this.open = true
        document.body.classList.add('drawer-open')
        this.$nextTick(() => {
          const drawer = this.$root.querySelector('[tabindex="-1"]')
          drawer && drawer.focus()
        })
      },

      closeDrawer() {
        this.open = false
        document.body.classList.remove('drawer-open')
        if (this.lastFocusedElement) {
          this.lastFocusedElement.focus()
        }
      },
    }
  }
</script>