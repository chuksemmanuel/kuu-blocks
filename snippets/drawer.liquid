{% comment %}
  drawer.liquid
    Accepts:
    - trigger: {String} a Capture of the trigger (usuallly a button)
    - content: {String} a Capture/Snippet of the drawer content
    - from: {String} Direction the drawer slides from
    - id: {String} Unique identifier of the drawer to target (e.g., 'cartdrawer', 'menudrawer')  used to open/close the drawer via the drawer:open and drawer:close custom Event
    Example:
    window.dispatchEvent(new CustomEvent('drawer:open', { detail: { id: 'cartdrawer' } }))
    window.dispatchEvent(new CustomEvent('drawer:close', { detail: { id: 'menu' } }))

  Usage:
    {% render 'drawer'
      , trigger: cart_trigger
      , content: cart_content
      , name: 'cartdrawer'
      , from: 'right'
    %}
{% endcomment %}

<style>
  [x-cloak] {
    display: none !important;
  }
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  body.drawer-open {
    overflow: hidden;
  }
</style>

{% assign from = from | default: 'right' %}
{% assign base_class = 'fixed  flex flex-col justify-stretch w-full h-full z-50 overflow-y-auto no-scrollbar p-2 lg:p-4 focus-visible:outline-0' %}

{% case from %}
  {% when 'top' %}
    {% assign direction_class = 'left-0 top-0' %}
  {% when 'bottom' %}
    {% assign direction_class = 'left-0 bottom-0' %}
  {% when 'left' %}
    {% assign direction_class = 'top-0 max-w-[min(648px,100%)] left-0' %}
  {% when 'right' %}
    {% assign direction_class = 'top-0 max-w-[min(648px,100%)] right-0' %}
  {% else %}
    {% assign direction_class = 'top-0 max-w-[min(648px,100%)] right-0' %}
{% endcase %}

<div
  x-data="drawer('{{ from }}')"
  x-init="init()"
  class="ida-drawer"
  data-drawer-id="{{id}}"
>
  <!-- Trigger -->
  {% if headless != true %}
    <div @click="openDrawer()">
      {{ trigger }}
    </div>
  {% endif %}

  <!-- Overlay -->
  <div
    class="fixed inset-0 bg-black/50 z-40"
    x-cloak
    x-ref="overlay"
    style="pointer-events: none; opacity: 0;"
    @click="closeDrawer()"
  ></div>

  <!-- Drawer panel -->
  <div
    class="{{base_class}} {{direction_class}} {{class}}"
    x-cloak
    x-ref="panel"
    style="opacity: 0; visibility: hidden; will-change: transform, opacity;"
    @click.stop
    role="dialog"
    aria-modal="true"
    aria-lablledby="drawer-title"
    aria-describedby="drawer-description"
    x-trap="open"
  >
    {{ content }}
  </div>
</div>
<script src="{{ 'js/components/drawer.js' | asset_url }}" defer></script>
