{% comment %} 
          drawer.liquid
            Accepts:
            - trigger: {String} a Capture of the trigger (usuallly a button)
            - content: {String} a Capture/Snippet of the drawer content
            - from: {String} Direction the drawer slides from
            - name: {String} Unique identifier of the drawer to target (e.g., 'cartdrawer', 'menudrawer')  used to open/close the drawer via the drawer:open and drawer:close custom Event
            Example:
            window.dispatchEvent(new CustomEvent('drawer:open', { detail: { name: 'cartdrawer' } }))
            window.dispatchEvent(new CustomEvent('drawer:close', { detail: { name: 'menu' } }))

          Usage:
            {% render 'drawer'
              , trigger: cart_trigger
              , content: cart_content
              , name: 'cartdrawer'
              , from: 'right'
            %}
{% endcomment %}


<style>
  [x-cloak] {
    display: none !important;
  }
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  body.drawer-open {
    overflow: hidden;
  }
</style>

{% assign from = from | default: 'right' %}

  <div
  x-data="drawer('{{ from }}')"
  x-init="init()"
  class="ida-drawer"
  data-drawer-name="{{name}}">
  <!-- Trigger -->
  <div @click="openDrawer()">
    {{ trigger }}
  </div>

  <!-- Overlay -->
  <div
    class="fixed inset-0 bg-black/50 z-40"
    x-cloak
    x-ref="overlay"
    style="pointer-events: none; opacity: 0;"
    @click="closeDrawer()"></div>

  <!-- Drawer panel -->
  <div
    class="fixed w-full z-50 overflow-y-auto no-scrollbar flex justify-stretch p-2 lg:p-4"
    x-cloak
    x-ref="panel"
    style="opacity: 0; visibility: hidden; will-change: transform, opacity;"
    @click.stop>
    <div class="w-full  bg-white rounded-md lg:rounded-lg  overflow-hidden shadow-lg flex-1">
      {{ content }}
    </div>

  </div>
</div>
<script src="{{ 'js/components/drawer.js' | asset_url }}" defer></script>