{% comment %}
  Product Card Component with GSAP Animation
  ------------------------------------------
  Usage:

  {% render 'product-card',
  product: product,
  show_floating_cart: true
  %}

  or for manual custom content:
  {% render 'product-card',
  title: 'Plain White Shirt',
  price: 29,
  image: 'shopify://shop_images/shirt.jpg',
  url: '/products/plain-white-shirt'
  %}
{% endcomment %}

{%- assign card_product = product | default: null -%}
{%- assign product_title = title | default: card_product.title -%}
{%- assign product_price = price | default: card_product.price | money -%}
{%- assign product_image = image | default: card_product.featured_image.src -%}
{%- assign product_url = url | default: card_product.url -%}

<div x-data="{
    adding: false,
   
  }" class="group relative flex flex-col overflow-hidden transition ">
  <a href="{{ product_url }}" class="block  rounded-3xl overflow-hidden aspect-square relative">
    <img
      src="{{ product_image | image_url: width: 600 }}"
      alt="{{ product_title | escape }}"
      width="600"
      height="600"
      class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
      loading="lazy" />

    {% if show_floating_cart %}


      <div
        @click.prevent="adding = true; $dispatch('drawer:open', { id: 'quick-add' }); setTimeout(() => adding = false, 1000)"
        class="absolute bottom-3 right-3 "
        :disabled="adding">

        <template x-if="!adding">
          {% render 'button'
            , variant: 'circled-icon'
            , size: 'none'
            , icon: 'icons/shopping-cart.svg'
            , class: 'shadow-sm '
          %}
        </template>
        <template x-if="adding">
          {% render 'button'
            , variant: 'circled-icon'
            , size: 'none'
            , icon: 'icons/loader-circle.svg'
            , class: 'animate-spin bg-primary! text-primary-foreground! ' %}

        </template>
      </div>

    {% endif %}
  </a>

  <div class="flex flex-col gap-1 p-4">
    <a href="{{ product_url }}" class="text-xl font-medium text-foreground line-clamp-2 lg:line-clamp-1">{{ product_title }}</a>
    <p class="text-lg font-medium text-gray-500">{{ product_price }}</p>
  </div>


</div>