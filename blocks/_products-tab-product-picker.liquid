{% assign product = block.settings.product %}

<a
  aria-label="{{product.title}}"
  role="listitem"
  href="{{ product.url }}"
  class="flex flex-col  gap-5  rounded-lg p-4 transition duration-300 hover:bg-gray-100 lg:p-6"
>
  <div class="flex items-center gap-5">
    <div
      class="block size-20 shrink-0 overflow-hidden rounded  bg-gray-200"
    >
      <img
        src="{{ product.featured_image | image_url : width : 200 }}"
        alt="{{ product.title }}"
        class="h-full w-full object-cover"
        width="80px"
        height="80px"
      >
    </div>

    <p class="text-lg">{{ product.title }}</p>
  </div>
</a>

{% schema %}
{
  "name": "Product Picker",
  "settings": [
    {
      "type": "header",
      "content": "Pick a Product"
    },
    {
      "type": "product_list",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "text",
      "id": "tab_title",
      "label": "Tab Title",
      "info": "The tab products from this product should be under*"
    }
  ],
  "presets": [
    {
      "name": "Pick a product"
    }
  ]
}
{% endschema %}
