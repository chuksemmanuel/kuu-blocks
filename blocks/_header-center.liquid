<div class='flex h-full w-full shrink-0  items-center justify-center gap-2'>
	<div class='flex shrink-0 items-center  justify-center'>
		{% content_for 'block', id: 'site-logo', type: 'kuu-logo' %}

		<ul aria-label='menu items' class=' hidden justify-between gap-8 font-medium md:flex'>
			{% for link in block.settings.menu.links limit: 5 %}
				<li>
					{{ link.title | link_to: link.url }}
				</li>
			{% endfor %}
		</ul>
	</div>
</div>

{% schema %}
	{
		"name": "Header Center",
		"settings": [
			{
				"type": "link_list",
				"id": "menu",
				"label": "t:labels.menu",
				"default": "main-menu"
			}
		],
		"blocks": [
			{
				"type": "kuu-logo"
			}
		],
		"presets": [
			{
				"name": "Header Center",
				"settings": {
					"menu": "main-menu"
				}
			}
		]
	}
{% endschema %}
