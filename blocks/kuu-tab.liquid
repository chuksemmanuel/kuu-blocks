{% assign tab_id = block.id | append: '-tab' %}

{% # Tag triggers buttons %}
{% capture tab_button_list %}
          {% for block in block.blocks %}
          {% endfor %}
{% endcapture %}

{% # Tag triggers -  horizontally scrollable %}
{% capture tab_triggers %}
         
            {% render 'horizontal-scroll',
            content: tab_button_list,
            id:tab_id,
            props: '  
                  x-ref="tabButtons"
                  role="tablist"
                  aria-label="Tabs"
                ',
            class: ' text-gray-500 select-none h-10'
                %}
            
{% endcapture %}

{% capture tab_content %}
      {% content_for 'blocks' %}
{% endcapture %}

<div id='{{tab_id}}' data-tab-block='{{tab_id}}'>
	{% render 'tab',
		triggers: tab_triggers,
		contents: tab_content,
		class: 'h-full flex flex-col overflow-hidden',
		trigger_class: 'shrink-0 pb-4',
		content_class: 'flex-1 overflow-y-auto',
		id: tab_id,
		block: block
	%}
</div>

{% schema %}
	{
		"name": "Kuu Tab",
		"class": "w-full",
		"settings": [
			{
				"type": "header",
				"content": "Padding"
			},
			{
				"type": "range",
				"id": "padding-block-start",
				"label": "Top",
				"min": 0,
				"max": 100,
				"step": 1,
				"unit": "px",
				"default": 0
			},
			{
				"type": "range",
				"id": "padding-block-end",
				"label": "Bottom",
				"min": 0,
				"max": 100,
				"step": 1,
				"unit": "px",
				"default": 0
			},
			{
				"type": "range",
				"id": "padding-inline-start",
				"label": "Left",
				"min": 0,
				"max": 100,
				"step": 1,
				"unit": "px",
				"default": 0
			},
			{
				"type": "range",
				"id": "padding-inline-end",
				"label": "Right",
				"min": 0,
				"max": 100,
				"step": 1,
				"unit": "px",
				"default": 0
			},
			{
				"type": "checkbox",
				"id": "custom_mobile_padding",
				"label": "Custom Mobile Padding",
				"default": true
			},
			{
				"type": "header",
				"content": "Mobile Padding"
			},
			{
				"type": "range",
				"id": "mobile-padding-block-start",
				"label": "Mobile Top",
				"min": 0,
				"max": 100,
				"step": 1,
				"unit": "px",
				"default": 0,
				"visible_if": "{{ block.settings.custom_mobile_padding }}"
			},
			{
				"type": "range",
				"id": "mobile-padding-block-end",
				"label": "Mobile Bottom",
				"min": 0,
				"max": 100,
				"step": 1,
				"unit": "px",
				"default": 0,
				"visible_if": "{{ block.settings.custom_mobile_padding }}"
			},
			{
				"type": "range",
				"id": "mobile-padding-inline-start",
				"label": "Mobile Left",
				"min": 0,
				"max": 100,
				"step": 1,
				"unit": "px",
				"default": 0,
				"visible_if": "{{ block.settings.custom_mobile_padding }}"
			},
			{
				"type": "range",
				"id": "mobile-padding-inline-end",
				"label": "Mobile Right",
				"min": 0,
				"max": 100,
				"step": 1,
				"unit": "px",
				"default": 0,
				"visible_if": "{{ block.settings.custom_mobile_padding }}"
			}
		],
		"blocks": [
			{
				"type": "_kuu-tab-item"
			}
		],
		"presets": [
			{
				"name": "Kuu Tab",
				"category": "Kuu Components",
				"blocks": [
					{
						"type": "_kuu-tab-item",
						"settings": {
							"tab_title": "Tab 1"
						}
					}
				]
			}
		]
	}
{% endschema %}

<script>
	populateTabButtons();
	// in theme editor, repopulate buttons when changes occur
	 {% if request.design_mode %}
	window.addEventListener('shopify:section:load', populateTabButtons)
	 {% endif %}
	function populateTabButtons() {
		// Clear horizontal scroll container
		document.querySelector('[data-tab-block="{{tab_id}}"] [data-horizontal-scroll="{{tab_id}}"]').innerHTML = '';

		let addedTabs = [];
		const tabEl = document.querySelector('[data-tab-block="{{tab_id}}"] [data-tab-id="{{tab_id}}"]');
	const contents = tabEl.querySelectorAll(':scope  [data-tab-content]');
		contents.forEach((tabContentEl) => {
			if(tabContentEl.closest('[data-tab-id]').dataset.tabId != '{{tab_id}}'){
				return;
			}
			if (!addedTabs.includes(tabContentEl.dataset.tabContent)) {
				document.querySelector('[data-tab-block="{{tab_id}}"] [data-horizontal-scroll="{{tab_id}}"]').insertAdjacentHTML(
					'beforeend',
					/*html*/ `
					<button
					data-trigger-block-id="{{block.id}}"
					data-tab-trigger="${tabContentEl.dataset.tabContent}"
					role="tab"
					aria-label="${tabContentEl.dataset.tabContent}"
					:aria-selected="tabButtonActive($el)"
					aria-controls=""
					type="button"
					:class="tabButtonActive($el) ? 'bg-primary text-primary-foreground' : 'bg-gray-200 text-gray-500'"
					class="relative z-10 inline-flex h-10 w-fit cursor-pointer items-center justify-center rounded-lg bg-gray-100 px-3 text-sm font-medium whitespace-nowrap transition duration-300 ease-out">
					${tabContentEl.dataset.tabContent}
					</button>
				`,
				);
				addedTabs.push(tabContentEl.dataset.tabContent);
			}
		});
	}
</script>
