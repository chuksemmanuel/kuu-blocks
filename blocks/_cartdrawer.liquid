{%
	render 'kuu-cartdrawer'
	, id: 'cartdrawer',
	, sticky_header: block.settings.sticky_header
	, sticky_footer: block.settings.sticky_footer
	, show_compare_price: block.settings.show_compare_price
	, final_price_color: block.settings.final_price_color
	, show_savings_badge: block.settings.show_savings_badge
	, savings_badge_color: block.settings.savings_badge_color
	, show_variant_title: block.settings.show_variant_title
	, show_secondary_footer_cta: block.settings.show_secondary_footer_cta
	, secondary_footer_cta_label: block.settings.secondary_footer_cta_label
	, secondary_footer_cta_link: block.settings.secondary_footer_cta_link
	, show_checkout_lock_icon: block.settings.show_checkout_lock_icon
	, checkout_button_label: block.settings.checkout_button_label,
	, section_id: section.id
%}

{% schema %}
	{
		"name": "Cart Drawer",
		"settings": [
			{
				"type": "header",
				"content": "Layout"
			},
			{
				"type": "checkbox",
				"id": "sticky_header",
				"label": "Enable sticky header",
				"default": true
			},
			{
				"type": "checkbox",
				"id": "sticky_footer",
				"label": "Enable sticky footer",
				"default": true
			},

			{
				"type": "header",
				"content": "Cart Items"
			},
			{
				"type": "checkbox",
				"id": "show_variant_title",
				"label": "Show variant title",
				"default": true
			},
			{
				"type": "checkbox",
				"id": "show_compare_price",
				"label": "Show compare-at price",
				"default": false
			},
			{
				"type": "color",
				"id": "final_price_color",
				"label": "Final price color",
				"default": "#fb2c36",
				"visible_if": "{{ section.settings.show_compare_price == true }}"
			},

			{
				"type": "checkbox",
				"id": "show_savings_badge",
				"label": "Show savings badge",
				"default": false,
				"visible_if": "{{ section.settings.show_compare_price == true }}"
			},
			{
				"type": "color",
				"id": "savings_badge_color",
				"label": "Savings badge color",
				"default": "#fb2c36",
				"visible_if": "{{ section.settings.show_savings_badge == true }}"
			},

			{
				"type": "header",
				"content": "Cart Drawer Footer"
			},
			{
				"type": "checkbox",
				"id": "show_checkout_lock_icon",
				"label": "Show lock icon",
				"default": true
			},
			{
				"type": "text",
				"id": "checkout_button_label",
				"label": "Checkout button label",
				"default": "Proceed to Checkout"
			},
			{
				"type": "checkbox",
				"id": "show_secondary_footer_cta",
				"label": "Show secondary button",
				"default": true
			},
			{
				"type": "text",
				"id": "secondary_footer_cta_label",
				"label": "Secondary button label",
				"default": "Continue Shopping",
				"visible_if": "{{ section.settings.show_secondary_footer_cta == true }}"
			},
			{
				"type": "select",
				"id": "secondary_footer_cta_action",
				"label": "Secondary button action",
				"options": [
					{
						"value": "close-drawer",
						"label": "Close Drawer"
					},
					{
						"value": "open-link",
						"label": "Open link"
					}
				],
				"default": "close-drawer",
				"visible_if": "{{ section.settings.show_secondary_footer_cta == true }}"
			},
			{
				"type": "url",
				"id": "secondary_footer_cta_link",
				"label": "Secondary button link",
				"default": "/",
				"visible_if": "{{ section.settings.secondary_footer_cta_action == 'open-link' }}"
			}
		],
		"presets": [
			{
				"name": "Cart Drawer"
			}
		]
	}
{% endschema %}
