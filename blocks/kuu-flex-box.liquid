{% liquid
	assign flex_container_wrapper_class = 'kuu-flex-container-wrapper-' | append: block.id
	assign flex_container_class = 'kuu-flex-container-' | append: block.id

	case block.settings.width
		when 'fit-content'
			assign width_style = 'fit-content'
		when 'fill'
			assign width_style = '100%'
		when 'custom'
			assign width_style = block.settings.custom_width | append: '%'
	endcase
%}

{% capture style %} 
	{% render 'spacing-padding', settings: block.settings %}
	{% render 'size-style', settings: block.settings %}
	{% render 'flex-style', settings: block.settings %}
{% endcapture %}

<div class='border-style ' style='{% render 'border-override', settings: block.settings %} width:{{ width_style }};'>
	<div class='{{ flex_container_wrapper_class }}'>
		<div
			style='{{ style |  strip}}'
			class='{{ flex_container_class }} size-style   spacing-style flex-style overflow-y-auto '
		>
			{% content_for 'blocks' %}
		</div>
	</div>
</div>

{% style %}
	.{{ flex_container_wrapper_class }} {
		background-color: {{ block.settings.background_color }};
		min-height: {{ block.settings.height_min}}px;
		{% if block.settings.height != 'custom' and block.settings.add_height_max and block.settings.height_max != blank %}
		max-height: {{ block.settings.height_max | strip }};
		overflow-y:auto;
		{% endif %}
	}
{% endstyle %}

{% schema %}
	{
		"name": "Kuu Flex Box",
		"settings": [
			{
				"type": "color",
				"id": "background_color",
				"label": "Background Color"
			},
			{
				"type": "header",
				"content": "Width"
			},
			{
				"type": "select",
				"id": "width",
				"label": "Width",
				"options": [
					{
						"value": "fit-content",
						"label": "Fit"
					},
					{
						"value": "fill",
						"label": "Fill"
					},
					{
						"value": "custom",
						"label": "Custom"
					}
				],
				"default": "fill"
			},
			{
				"type": "range",
				"id": "custom_width",
				"label": "Custom width",
				"min": 0,
				"max": 100,
				"step": 1,
				"unit": "%",
				"default": 100,
				"visible_if": "{{ block.settings.width == 'custom' }}"
			},
			{
				"type": "checkbox",
				"id": "add_mobile_width",
				"label": "Custom mobile width",
				"default": false
			},
			{
				"type": "select",
				"id": "width_mobile",
				"label": "Width Mobile",
				"options": [
					{
						"value": "fit-content",
						"label": "Fit"
					},
					{
						"value": "fill",
						"label": "Fill"
					},
					{
						"value": "custom",
						"label": "Custom"
					}
				],
				"default": "fill",
				"visible_if": "{{ block.settings.add_mobile_width }}"
			},
			{
				"type": "range",
				"id": "custom_width_mobile",
				"label": "Custom width mobile",
				"min": 0,
				"max": 100,
				"step": 1,
				"unit": "%",
				"default": 100,
				"visible_if": "{{ block.settings.add_mobile_width and block.settings.width_mobile == 'custom' }}"
			},
			{
				"type": "header",
				"content": "Height"
			},
			{
				"type": "select",
				"id": "height",
				"label": "Height",
				"options": [
					{
						"value": "fit-content",
						"label": "Fit"
					},
					{
						"value": "fill",
						"label": "Fill"
					},
					{
						"value": "custom",
						"label": "Custom"
					}
				],
				"default": "fit-content"
			},
			{
				"type": "range",
				"id": "custom_height",
				"label": "Custom height",
				"min": 0,
				"max": 1200,
				"step": 12,
				"unit": "px",
				"default": 240,
				"visible_if": "{{ block.settings.height == 'custom' }}"
			},
			{
				"type": "range",
				"id": "height_min",
				"label": "Minimum height",
				"min": 0,
				"max": 1200,
				"step": 12,
				"unit": "px",
				"default": 0
			},
			{
				"type": "checkbox",
				"id": "add_height_max",
				"label": "Add max height",
				"default": false,
				"visible_if": "{{ block.settings.height != 'custom' }}"
			},
			{
				"type": "text",
				"id": "height_max",
				"label": "Max height ",
				"info": "E.g 1200px, 80vh, min(600px,60svh) etc. Visit [MDN Docs](https://developer.mozilla.org/en-US/docs/Web/CSS/max-height) for more info.",
				"visible_if": "{{block.settings.height != 'custom' and block.settings.add_height_max }}"
			},
			{
				"type": "header",
				"content": "Flex"
			},
			{
				"type": "select",
				"id": "flex_direction",
				"label": "Direction",
				"options": [
					{
						"value": "row",
						"label": "Row"
					},
					{
						"value": "column",
						"label": "Column"
					}
				],
				"default": "column"
			},
			{
				"type": "select",
				"id": "justify_content",
				"label": "Justify Content",
				"options": [
					{
						"value": "flex-start",
						"label": "Start"
					},
					{
						"value": "center",
						"label": "Center"
					},

					{
						"value": "flex-end",
						"label": "End"
					}
				],
				"default": "flex-start"
			},
			{
				"type": "select",
				"id": "align_items",
				"label": "Align Items",
				"options": [
					{
						"value": "flex-start",
						"label": "Start"
					},
					{
						"value": "center",
						"label": "Center"
					},

					{
						"value": "flex-end",
						"label": "End"
					}
				],
				"default": "flex-start"
			},
			{
				"type": "select",
				"id": "flex_gap",
				"label": "Flex Gap",
				"options": [
					{
						"value": "all",
						"label": "All Gaps"
					},
					{
						"value": "custom",
						"label": "Custom"
					}
				],
				"default": "all",
				"info": "Choose custom to style the vertical and horizontal gap separately"
			},
			{
				"type": "range",
				"id": "gap",
				"label": "Gap",
				"min": 0,
				"max": 100,
				"step": 1,
				"unit": "px",
				"default": 4,
				"visible_if": "{{ block.settings.flex_gap == 'all' }}"
			},
			{
				"type": "range",
				"id": "row_gap",
				"label": "Row Gap",
				"min": 0,
				"max": 100,
				"step": 1,
				"unit": "px",
				"default": 0,
				"visible_if": "{{ block.settings.flex_gap == 'custom' }}"
			},
			{
				"type": "range",
				"id": "column_gap",
				"label": "Column Gap",
				"min": 0,
				"max": 100,
				"step": 1,
				"unit": "px",
				"default": 0,
				"visible_if": "{{ block.settings.flex_gap == 'custom' }}"
			},
			{
				"type": "checkbox",
				"id": "custom_mobile_flex",
				"label": "Custom Mobile flex",
				"default": true
			},
			{
				"type": "select",
				"id": "mobile_flex_direction",
				"label": "Direction",
				"options": [
					{
						"value": "row",
						"label": "Row"
					},
					{
						"value": "column",
						"label": "Column"
					}
				],
				"default": "column",
				"visible_if": "{{ block.settings.custom_mobile_flex }}"
			},
			{
				"type": "select",
				"id": "mobile_justify_content",
				"label": "Justify Content",
				"options": [
					{
						"value": "flex-start",
						"label": "Left"
					},
					{
						"value": "center",
						"label": "Center"
					},

					{
						"value": "flex-end",
						"label": "Right"
					}
				],
				"default": "flex-start",
				"visible_if": "{{ block.settings.custom_mobile_flex }}"
			},
			{
				"type": "select",
				"id": "mobile_align_items",
				"label": "Align Items",
				"options": [
					{
						"value": "flex-start",
						"label": "Left"
					},
					{
						"value": "center",
						"label": "Center"
					},

					{
						"value": "flex-end",
						"label": "Right"
					}
				],
				"default": "flex-start",
				"visible_if": "{{ block.settings.custom_mobile_flex }}"
			},
			{
				"type": "select",
				"id": "mobile_flex_gap",
				"label": "Flex Gap",
				"options": [
					{
						"value": "all",
						"label": "All Gaps"
					},
					{
						"value": "custom",
						"label": "Custom"
					}
				],
				"default": "all",
				"visible_if": "{{ block.settings.custom_mobile_flex }}"
			},
			{
				"type": "range",
				"id": "mobile_gap",
				"label": "Gap",
				"min": 0,
				"max": 100,
				"step": 1,
				"unit": "px",
				"default": 4,
				"visible_if": "{{ block.settings.custom_mobile_flex and block.settings.mobile_flex_gap == 'all' }}"
			},
			{
				"type": "range",
				"id": "mobile_row_gap",
				"label": "Row Gap",
				"min": 0,
				"max": 100,
				"step": 1,
				"unit": "px",
				"default": 0,
				"visible_if": "{{ block.settings.mobile_flex_gap == 'custom' }}"
			},
			{
				"type": "range",
				"id": "mobile_column_gap",
				"label": "Column Gap",
				"min": 0,
				"max": 100,
				"step": 1,
				"unit": "px",
				"default": 0,
				"visible_if": "{{ block.settings.mobile_flex_gap == 'custom' }}"
			},
			{
				"type": "header",
				"content": "Border"
			},

			{
				"type": "select",
				"id": "border",
				"label": "Style",
				"options": [
					{
						"value": "none",
						"label": "None"
					},
					{
						"value": "solid",
						"label": "Solid"
					},
					{
						"value": "dashed",
						"label": "Dashed"
					}
				],
				"default": "none"
			},
			{
				"type": "select",
				"id": "border_sides",
				"label": "Sides",
				"options": [
					{
						"value": "all",
						"label": "All"
					},
					{
						"value": "individual",
						"label": "Individual"
					}
				],
				"default": "all"
			},
			{
				"type": "range",
				"id": "border_width",
				"min": 0,
				"max": 100,
				"step": 1,
				"unit": "px",
				"label": "Border width",
				"default": 1,
				"visible_if": "{{ block.settings.border != 'none' and block.settings.border_sides == 'all' }}"
			},

			{
				"type": "range",
				"id": "border_left_width",
				"min": 0,
				"max": 100,
				"step": 1,
				"unit": "px",
				"label": "Border Left",
				"default": 1,
				"visible_if": "{{block.settings.border_sides != 'all' }}"
			},
			{
				"type": "range",
				"id": "border_top_width",
				"min": 0,
				"max": 100,
				"step": 1,
				"unit": "px",
				"label": "Border Top",
				"default": 1,
				"visible_if": "{{block.settings.border_sides != 'all' }}"
			},
			{
				"type": "range",
				"id": "border_bottom_width",
				"min": 0,
				"max": 100,
				"step": 1,
				"unit": "px",
				"label": "Border Bottom",
				"default": 1,
				"visible_if": "{{block.settings.border_sides != 'all' }}"
			},
			{
				"type": "range",
				"id": "border_right_width",
				"min": 0,
				"max": 100,
				"step": 1,
				"unit": "px",
				"label": "Border Right",
				"default": 1,
				"visible_if": "{{block.settings.border_sides != 'all' }}"
			},
			{
				"type": "color",
				"id": "border_color",
				"label": "Border color",
				"alpha": true,
				"default": "#000000",
				"visible_if": "{{ block.settings.border != 'none' }}"
			},
			{
				"type": "range",
				"id": "border_radius",
				"label": "Radius",
				"min": 0,
				"max": 100,
				"step": 1,
				"unit": "px",
				"default": 0
			},
			{
				"type": "header",
				"content": "Padding"
			},
			{
				"type": "range",
				"id": "padding-block-start",
				"label": "Top",
				"min": 0,
				"max": 100,
				"step": 1,
				"unit": "px",
				"default": 24
			},
			{
				"type": "range",
				"id": "padding-block-end",
				"label": "Bottom",
				"min": 0,
				"max": 100,
				"step": 1,
				"unit": "px",
				"default": 24
			},
			{
				"type": "range",
				"id": "padding-inline-start",
				"label": "Left",
				"min": 0,
				"max": 100,
				"step": 1,
				"unit": "px",
				"default": 24
			},
			{
				"type": "range",
				"id": "padding-inline-end",
				"label": "Right",
				"min": 0,
				"max": 100,
				"step": 1,
				"unit": "px",
				"default": 24
			},
			{
				"type": "checkbox",
				"id": "custom_mobile_padding",
				"label": "Custom Mobile Padding",
				"default": true
			},
			{
				"type": "range",
				"id": "mobile-padding-block-start",
				"label": "Mobile Top",
				"min": 0,
				"max": 100,
				"step": 1,
				"unit": "px",
				"default": 0,
				"visible_if": "{{ block.settings.custom_mobile_padding }}"
			},
			{
				"type": "range",
				"id": "mobile-padding-block-end",
				"label": "Mobile Bottom",
				"min": 0,
				"max": 100,
				"step": 1,
				"unit": "px",
				"default": 0,
				"visible_if": "{{ block.settings.custom_mobile_padding }}"
			},
			{
				"type": "range",
				"id": "mobile-padding-inline-start",
				"label": "Mobile Left",
				"min": 0,
				"max": 100,
				"step": 1,
				"unit": "px",
				"default": 0,
				"visible_if": "{{ block.settings.custom_mobile_padding }}"
			},
			{
				"type": "range",
				"id": "mobile-padding-inline-end",
				"label": "Mobile Right",
				"min": 0,
				"max": 100,
				"step": 1,
				"unit": "px",
				"default": 0,
				"visible_if": "{{ block.settings.custom_mobile_padding }}"
			}
		],
		"blocks": [
			{
				"type": "@theme"
			},
			{
				"type": "@app"
			}
		],
		"presets": [
			{
				"name": "Flex Box",
				"category": "Kuu Layout"
			}
		]
	}
{% endschema %}
