{% case block.settings.device %}
	{% when 'mobile' %}
		{% assign display_class = 'flex md:hidden' %}

	{% when 'desktop' %}
		{% assign display_class = 'hidden md:flex' %}
	{% else %}
		{% assign display_class = 'flex' %}
{% endcase %}

<div class='{{ display_class }}'>
	{% render 'searchdrawer',
		id: block.id,
		device: block.settings.device,
		variant: block.settings.variant,
		direction: block.settings.direction,
		mobile_direction: block.settings.mobile_direction
	%}
</div>
{% schema %}
	{
		"name": "Search Drawer",
		"settings": [
			{
				"type": "select",
				"id": "device",
				"label": "Show Drawer on",
				"options": [
					{
						"value": "all",
						"label": "All Devices"
					},
					{
						"value": "mobile",
						"label": "Mobile  Devices Only"
					},
					{
						"value": "desktop",
						"label": "Desktop Devices  Only"
					}
				],
				"default": "all"
			},
			{
				"type": "select",
				"id": "variant",
				"label": "Button Variant",
				"options": [
					{
						"value": "circled",
						"label": "Circled"
					},
					{
						"value": "ghost",
						"label": "Ghost"
					}
				],
				"default": "circled"
			},
			{
				"type": "select",
				"id": "direction",
				"label": "Drawer Direction",
				"info": "Direction the drawer animates from",
				"options": [
					{
						"value": "top",
						"label": "Top"
					},
					{
						"value": "bottom",
						"label": "Bottom"
					},
					{
						"value": "left",
						"label": "Left"
					},
					{
						"value": "right",
						"label": "Right"
					}
				],
				"default": "right"
			},
			{
				"type": "select",
				"id": "mobile_direction",
				"label": "Mobile Direction",
				"options": [
					{
						"value": "top",
						"label": "Top"
					},
					{
						"value": "bottom",
						"label": "Bottom"
					},
					{
						"value": "left",
						"label": "Left"
					},
					{
						"value": "right",
						"label": "Right"
					}
				],
				"default": "top",
				"visible_if": "{{block.settings.device == 'all'}}"
			}
		],
		"presets": [
			{
				"name": "Search Drawer",
				"category": "Drawers"
			}
		]
	}
{% endschema %}
