<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% # Inlined CSS Variables %}
  {% render 'css-variables' %}


    {% # Load and preload the critical CSS %}
  {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}


    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {{ content_for_header }}
  </head>

  <body>
    {% sections 'header-group' %}

    {{ content_for_layout }}

    {% sections 'footer-group' %}


    {% # Load Swiper.js %}
    <script src="{{ 'swiper-element-bundle@3.13.0.min.js' |  asset_url }}" defer></script>

    {% # Load Gsap.js %}
    <script src="{{ 'gsap.js' |  asset_url }}" defer></script>


    {% # Load  Alpine.js %}
    <script src="{{ 'alpine.js' |  asset_url }}" defer></script>
  </body>
</html>