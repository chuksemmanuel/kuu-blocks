<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% # Load and preload the critical CSS %}
    {{ 'css/critical.css' | asset_url | stylesheet_tag: preload: true }}

    {% render 'css-variables' %}
    {% render 'stylesheet' %}
    {% render 'script' %}
    {% render 'meta-tags' %}

    {{ content_for_header }}
  </head>

  <body>
    {% sections 'header-group' %}

    {{ content_for_layout }}

    {% sections 'footer-group' %}


    {% comment %} External Libraries {% endcomment %}
    {% # Gsap.js %}
    <script src="{{ 'js/lib/gsap@3.13.0.min.js' |  asset_url }}" defer></script>
    {% # Swiper.js %}
    <script src="{{ 'js/lib/swiperjs@12.0.3.min.js' |  asset_url }}" defer></script>
    {% # Alpine.js %}
    <script src="{{ 'js/lib/alpinejs@3.15.1.min.js' |  asset_url }}" defer></script>
  </body>
</html>