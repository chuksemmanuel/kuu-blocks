<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% # Load and preload the critical CSS %}
    {{ 'css/critical.css' | asset_url | stylesheet_tag: preload: true }}

    {% render 'css-variables' %}
    {% render 'stylesheet' %}
    {% render 'script' %}
    {% render 'meta-tags' %}

    {{ content_for_header }}
  </head>

  <body>
    {% sections 'header-group' %}

    {{ content_for_layout }}

    {% sections 'footer-group' %}


    {% render 'js-lib' %}
  </body>
</html>