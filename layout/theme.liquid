<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% # Inlined CSS Variables %}
  {% render 'css-variables' %}

    {% # Load Custom tailwind css %}
  {{ 'app.css' | asset_url | stylesheet_tag: preload: true }}

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}


    {% # Load Custom Alpine js %}
    <script src="{{ 'alpine.js' |  asset_url }}" defer>
  </script>

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {{ content_for_header }}
  </head>

  <body>
    {% sections 'header-group' %}

    {{ content_for_layout }}

    {% sections 'footer-group' %}


    <script src="{{ 'swiper.js' |  asset_url }}" defer></script>
  </body>
</html>