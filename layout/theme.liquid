<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% # Load and preload the critical CSS %}
    {{ 'css/critical.css' | asset_url | stylesheet_tag: preload: true }}

    {% render 'css-variables' %}
    {% render 'stylesheet' %}
    {% render 'script' %}
    {% render 'meta-tags' %}

    {{ content_for_header }}
  </head>

  <body>
    <a href="#main-content" class="sr-only">Skip to main content</a>

    {% sections 'header-group' %}

    <main id="main-content" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% section 'tabbed-products' %}

    {% # Playground - for testing components %}
    {% render 'playground' %}
    {% render 'js-lib' %}
  </body>
</html>
