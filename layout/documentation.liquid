<!doctype html>
<html lang='{{ request.locale.iso_code }}'>
	<head>
		{% # Load and preload the critical CSS %}
		{{ 'css/critical.css' | asset_url | stylesheet_tag: preload: true }}
		{% # Load prism CSS for syntax highlighting %}
		<link href='{{ 'docs/css/prism-onelight.css' | asset_url }}' rel='stylesheet'>

		{% render 'kuu-stylesheet' %}
		{% render 'kuu-script' %}
		{% render 'meta-tags' %}

		{{ content_for_header }}
	</head>

	<body>
		<a href='#main-content' class='sr-only'>Skip to main content</a>

		{% section 'kuu-docs-header' %}

		<div class='page-width-docs'>
			<div class='mt-18 flex gap-8 md:mt-24'>
				{% section 'kuu-docs-sidebar-nav' %}

				<main
					id='main-content'
					tabindex='-1'
					class='mx-auto w-full flex-1  overflow-x-hidden pb-24'
				>
					{{ content_for_layout }}
				</main>

				{% section 'kuu-docs-sidebar-scrollspy' %}
			</div>
		</div>

		{% render 'kuu-docs-js' %}
		{% render 'kuu-js-lib' %}

		{% # Playground - for testing components %}
		{% render 'playground' %}
	</body>
</html>
